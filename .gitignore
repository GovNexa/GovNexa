node_modules/
dist/
.astro/
playwright-report/
test-results/
validation/
.DS_Store
.vercel
.env*

# Captação: dados brutos ficam fora do Git (reprocessáveis pelos coletores)
data/raw/*
!data/raw/.gitkeep

# Arquivos volumosos regenerados pelos coletores (as telas usam os resumos enxutos)
data/core/transferegov-*.json
data/core/portal-transparencia-*.json

# Insumos internos (reunioes, planilhas, PDFs): nunca publicar
Doc Referencia/

# GovNexa: dados reais da carteira (baixados do repositorio privado no build ou gerados pelo importador). Nunca publicar.
.govnexa-dados/

# Dados reais da prefeitura: nunca publicar (retirados do histórico em 2026-11-16)
data/carga-real/

# Cloudflare (segredos locais, estado local do wrangler) e pasta temporária dos executores
.dev.vars*
!.dev.vars.example
.wrangler/
.tmp/
.claude/settings.local.json

# Manual: arquivos gerados pelo build (regenerados por docs/manual/pdf/construir-*.sh)
docs/manual/pdf/.construcao*/
docs/manual/pdf/diagramas/
docs/manual/pdf/assets/
