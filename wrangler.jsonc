{
  "name": "govnexa",
  "account_id": "6a5f95eb22f96f4b448c06f11cb281c6",
  "compatibility_date": "2026-11-01",
  "main": "./worker/entrypoint.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": [
      "/plataforma",
      "/plataforma/*",
      "/entrar",
      "/entrar/*",
      "/api",
      "/api/*",
      "/sair",
      "/sair/*"
    ]
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "govnexa.com.br", "custom_domain": true },
    { "pattern": "www.govnexa.com.br", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB_CENTRAL",
      "database_name": "govnexa-central",
      "database_id": "64090bfd-b5ad-4360-a022-70d64fdb4b54",
      "migrations_dir": "db/d1/central"
    },
    {
      "binding": "DB_PREFEITURA_5208707",
      "database_name": "govnexa-5208707",
      "database_id": "cabbeb81-bfe9-4729-bd6c-b4d5b35674e8",
      "migrations_dir": "db/d1/prefeitura"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTOS",
      "bucket_name": "govnexa-documentos"
    }
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["nao-responda@govnexa.com.br"] }],
  "vars": {
    "LOGIN_MODO": "access",
    "ORIGEM_PUBLICA": "https://govnexa.com.br",
    "TURNSTILE_SITE_KEY": "",
    "ACCESS_TEAM_DOMAIN": "equipegovnexa.cloudflareaccess.com",
    "ACCESS_AUD": "07172f6dfb695c95b9c08710223fcc081711f891836aee2c7243e6e4bc2bd1e4"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
