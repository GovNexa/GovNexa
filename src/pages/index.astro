<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

// Ficha do projeto: o que muda em cada macroetapa (dados de exemplo, fictícios).
const ETAPAS = [
  { n: '00', nome: 'Em estruturação', quem: 'Gestão de portfólio', dias: '2 dias', entrega: 'a calcular', fonte: 'a definir', prazo: 'no prazo', faz: 'O sistema cria a ficha, o histórico e o lugar do projeto em todas as telas.' },
  { n: '01', nome: 'Planejamento', quem: 'Órgão executor', dias: '11 dias', entrega: 'dez/2027', fonte: 'buscando convênio', prazo: 'no prazo', faz: 'O sistema calcula a entrega projetada e sugere oportunidades de recurso para o projeto.' },
  { n: '02', nome: 'Preparatório para contratação', quem: 'Jurídico', dias: '23 dias', entrega: 'jan/2028', fonte: 'convênio em análise', prazo: 'parado há 23 dias', faz: 'O sistema mostra que o parecer está parado há 23 dias e com quem.' },
  { n: '03', nome: 'Contratação', quem: 'Comissão de contratação', dias: '6 dias', entrega: 'jan/2028', fonte: 'convênio assinado', prazo: 'no prazo', faz: 'O sistema conta os prazos da Lei 14.133 em dias úteis e alerta antes do teto legal.' },
  { n: '04', nome: 'Mobilização', quem: 'Empresa contratada', dias: '4 dias', entrega: 'jan/2028', fonte: '1º repasse liberado', prazo: 'no prazo', faz: 'O sistema cobra a ordem de serviço se ela não sair em 15 dias.' },
  { n: '05', nome: 'Execução', quem: 'Fiscalização da obra', dias: '58 dias', entrega: 'fev/2028', fonte: 'repasses em dia', prazo: '30 dias de atraso projetado', faz: 'O sistema monta a pauta da reunião semanal e mostra o atraso projetado de 30 dias.' },
  { n: '06', nome: 'Conclusão', quem: 'Gabinete', dias: 'entregue', entrega: 'fev/2028', fonte: 'prestação de contas', prazo: 'concluído', faz: 'O sistema guarda o histórico completo e as lições aprendidas.' },
];

let contexto: gsap.Context | undefined;
const limpezas: (() => void)[] = [];

function iniciar() {
  const raiz = document.querySelector<HTMLElement>('.gx');
  if (!raiz) return;
  const $ = (id: string) => document.getElementById(id)!;
  const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const trilho = Array.from($('rail').children) as HTMLElement[];
  const passos = Array.from(raiz.querySelectorAll<HTMLElement>('.gx-step'));
  let atual = -1;

  const etapa = (i: number) => {
    const e = ETAPAS[i];
    if (i === atual || !e) return;
    atual = i;
    $('fNum').textContent = e.n; $('fNome').textContent = e.nome; $('fQuem').textContent = e.quem;
    $('fDias').textContent = e.dias; $('fEntrega').textContent = e.entrega; $('fFonte').textContent = e.fonte;
    $('fFaz').textContent = e.faz; $('fPrazo').textContent = e.prazo;
    trilho.forEach((el, k) => { el.className = k < i ? 'gx-on' : k === i ? 'gx-now' : ''; });
    passos.forEach((p) => p.classList.toggle('gx-active', Number(p.dataset.i) === i));
    if (!calmo) gsap.fromTo('#fNum,#fNome', { y: 10 }, { y: 0, duration: 0.45, ease: 'power2.out', stagger: 0.05 });
  };
  etapa(0);

  // Luz que segue o ponteiro nos cartões de vidro.
  raiz.querySelectorAll<HTMLElement>('.gx-lit').forEach((c) => {
    const mover = (ev: PointerEvent) => {
      const r = c.getBoundingClientRect();
      c.style.setProperty('--mx', `${ev.clientX - r.left}px`);
      c.style.setProperty('--my', `${ev.clientY - r.top}px`);
    };
    c.addEventListener('pointermove', mover);
    limpezas.push(() => c.removeEventListener('pointermove', mover));
  });

  contexto = gsap.context(() => {
    passos.forEach((p) => {
      ScrollTrigger.create({ trigger: p, start: 'top 58%', end: 'bottom 58%', onEnter: () => etapa(Number(p.dataset.i)), onEnterBack: () => etapa(Number(p.dataset.i)) });
    });
    if (calmo) return;

    // Entrada do topo: só deslocamento, sem mexer na opacidade (o texto nunca perde contraste).
    gsap.from('.gx-hero h1, .gx-hero .gx-lead, .gx-hero .gx-cta, .gx-hero .gx-proof', { y: 26, duration: 0.9, ease: 'power3.out', stagger: 0.09 });
    gsap.from('#live', { y: 40, rotateX: 6, duration: 1.1, ease: 'power3.out', transformPerspective: 900 });

    // O cartão atravessa o quadro três vezes e para (nada se move sem fim).
    const cartao = $('mover'), quadro = $('kan');
    const rotulos = ['avança com portão', 'peças conferidas', 'prazo legal contado', 'em obra'];
    const tl = gsap.timeline({ repeat: 2, repeatDelay: 1.2, defaults: { duration: 1, ease: 'power2.inOut' } });
    for (let i = 1; i < 4; i++) {
      tl.to(cartao, { x: () => (i * (quadro.clientWidth + 8)) / 4, y: i % 2 ? 26 : 0, onStart: () => { $('moverTag').textContent = rotulos[i]; } }, '+=1.1');
    }
    tl.to(cartao, { x: 0, y: 0, duration: 0.01, onStart: () => { $('moverTag').textContent = rotulos[0]; } }, '+=1.6');
    const aoRedimensionar = () => tl.invalidate();
    window.addEventListener('resize', aoRedimensionar);
    limpezas.push(() => window.removeEventListener('resize', aoRedimensionar));

    // Luzes do fundo acompanham a rolagem.
    gsap.to('.gx-orb.gx-a', { yPercent: 40, xPercent: 12, ease: 'none', scrollTrigger: { trigger: raiz, start: 'top top', end: 'bottom bottom', scrub: 1 } });
    gsap.to('.gx-orb.gx-b', { yPercent: 120, xPercent: -20, ease: 'none', scrollTrigger: { trigger: raiz, start: 'top top', end: 'bottom bottom', scrub: 1 } });

    // Revelações suaves por seção.
    gsap.utils.toArray<HTMLElement>('.gx-sec-head, .gx-ask, .gx-tile, .gx-rule, .gx-check, .gx-radar, .gx-end').forEach((el) => {
      gsap.from(el, { y: 30, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } });
    });
    gsap.utils.toArray<HTMLElement>('.gx-gantt i').forEach((b, k) => {
      gsap.from(b, { scaleX: 0, duration: 1, delay: k * 0.12, ease: 'power3.out', scrollTrigger: { trigger: b, start: 'top 92%', once: true } });
    });

    // Números contam até o valor final.
    gsap.utils.toArray<HTMLElement>('.gx-count').forEach((el) => {
      const fim = parseFloat(el.dataset.to || '0'), dec = Number(el.dataset.dec || 0), o = { v: 0 };
      ScrollTrigger.create({ trigger: el, start: 'top 92%', once: true, onEnter: () => {
        gsap.to(o, { v: fim, duration: 1.3, ease: 'power2.out', onUpdate: () => { el.textContent = o.v.toFixed(dec).replace('.', ','); } });
      } });
    });

    // Botões com leve atração do ponteiro.
    raiz.querySelectorAll<HTMLElement>('.gx-magnet').forEach((b) => {
      const puxar = (ev: PointerEvent) => {
        const r = b.getBoundingClientRect();
        gsap.to(b, { x: (ev.clientX - r.left - r.width / 2) * 0.18, y: (ev.clientY - r.top - r.height / 2) * 0.28, duration: 0.3, ease: 'power2.out' });
      };
      const soltar = () => gsap.to(b, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1,.5)' });
      b.addEventListener('pointermove', puxar);
      b.addEventListener('pointerleave', soltar);
      limpezas.push(() => { b.removeEventListener('pointermove', puxar); b.removeEventListener('pointerleave', soltar); });
    });
  }, raiz);
}

function encerrar() {
  contexto?.revert();
  contexto = undefined;
  limpezas.splice(0).forEach((f) => f());
}

document.addEventListener('astro:page-load', iniciar);
document.addEventListener('astro:before-swap', encerrar);

</script>
