---
import '../../../styles/carteira.css';
import '../../../styles/responsaveis.css';
import Platform from '../../../layouts/Platform.astro';
import LinhaDoTempo from '../../../components/cronograma/LinhaDoTempo.astro';
import QuadroTarefas from '../../../components/cronograma/QuadroTarefas.astro';
import Dependencias from '../../../components/cronograma/Dependencias.astro';
import TarefasResponsaveis from '../../../components/cronograma/TarefasResponsaveis.astro';
import { carregarCarteira } from '../../../lib/carteira/carga.ts';
import { hrefFicha } from '../../../lib/carteira/ficha.ts';
import { carregarCronogramas } from '../../../lib/cronograma/carga.ts';
import { analisarDependencias, cascataDoProjeto } from '../../../lib/cronograma/dependencias.ts';
import { ID_CRONOGRAMA } from '../../../lib/cronograma/edicao.ts';
import { abaCronograma, ROTA_CRONOGRAMAS, rotuloVoltaCronograma, voltaCronograma } from '../../../lib/cronograma/navegacao.ts';
import { chaveNome, tempoNaMao } from '../../../lib/cronograma/responsaveis.ts';
import { etapasDoCronograma, resumoCronograma, rotuloRitmo } from '../../../lib/cronograma/visoes.ts';
import { br } from '../../../lib/dados/formato.ts';
import { usuarioPode } from '../../../lib/usuarios/index.ts';
import { hojeEmBrasilia } from '../../../lib/whatsapp/farol.ts';

export const prerender = false;
const id = String(Astro.params.id ?? '');
if (!ID_CRONOGRAMA.test(id)) return new Response('Página não encontrada', { status: 404 });
const repo = Astro.locals.repositorio;
const fresco = repo?.obterCronograma ? await repo.obterCronograma(id) : null;
const c = fresco ? fresco.cronograma : carregarCronogramas().cronogramas.find((x) => x.id === id);
const revisao: number | null = fresco ? fresco.revisao : null;
if (!c) return new Response('Página não encontrada', { status: 404 });
const hoje = hojeEmBrasilia();
const podeEditar = usuarioPode(Astro.locals.usuario, 'editar_projeto') && !!repo?.podeGravar && !!repo?.gravarCronograma && revisao !== null;
const volta = voltaCronograma(Astro.url.searchParams.get('volta'), Astro.url.origin);
const aqui = Astro.url.pathname + Astro.url.search;
const r = resumoCronograma(c, hoje);
const vazio = etapasDoCronograma(c).length === 0;
const aba = vazio ? 'tarefas' : abaCronograma(Astro.url.searchParams.get('aba'));
const projeto = c.projeto_id ? carregarCarteira().projetos.find((p) => p.id === c.projeto_id) : undefined;
const pend = [
  ...c.pendencias.map((t) => `Cronograma: ${t}`),
  ...etapasDoCronograma(c).flatMap((e) => e.pendencias.map((t) => `${e.nome}${e.origem ? ` (linha ${e.origem.linha})` : ''}: ${t}`)),
];
const pct = (n: number) => `${Math.round(n)}%`;
const deps = vazio ? [] : analisarDependencias(c, hoje);
const cascata = vazio ? null : cascataDoProjeto(c, hoje, deps);
const travadas = deps.filter((d) => d.travada).length;
const comAlerta = etapasDoCronograma(c).filter((e) => tempoNaMao(e, hoje).alerta !== null).length;
const nDias = (n: number) => `${n} dia${n === 1 ? '' : 's'}`;
const distintos = (valores: (string | null | undefined)[]) => {
  const m = new Map<string, string>();
  for (const v of valores) { const t = (v ?? '').trim(); if (t && !m.has(chaveNome(t))) m.set(chaveNome(t), t); }
  return [...m.values()].sort((x, y) => x.localeCompare(y, 'pt-BR'));
};
const todas = carregarCronogramas().cronogramas.flatMap((x) => etapasDoCronograma(x));
const sugestoes = {
  fases: distintos(c.fases.map((f) => f.nome)),
  unidades: distintos(todas.map((e) => e.unidade)),
  pessoas: distintos(todas.map((e) => e.responsavel)),
};
const escondido = (n: string) => aba !== n;
---
<Platform title={c.titulo} slug="projetos-cronogramas">
  <div class="section-head">
    <div>
      <h1>{c.titulo}</h1>
      <p class="muted"><a href={volta ?? ROTA_CRONOGRAMAS} data-voltar>{rotuloVoltaCronograma(volta)}</a>{c.endereco ? ` · ${c.endereco}` : ''}</p>
    </div>
  </div>
  <p class="cr-resumo" data-cart>
    <span><strong>Fase atual:</strong> {r.faseAtual}</span>
    <span><strong>Realizado:</strong> {pct(r.realizadoPct)} × <strong>previsto:</strong> {pct(r.previstoPct)}</span>
    <span><strong>Ritmo:</strong> {rotuloRitmo(r.ritmo)}</span>
    <span><strong>Entrega prevista:</strong> {br(r.entregaPrevista)}</span>
    <span><strong>Tarefas com alerta:</strong> {comAlerta}</span>
    <span><strong>Projeto da carteira:</strong> {projeto ? <a href={hrefFicha(projeto.id, aqui, 'cronograma')}>{projeto.id} · {projeto.nome}</a> : 'sem correspondência'}</span>
  </p>
  {cascata && <p class="cr-cascata" data-cart data-cr-cascata>
    {cascata.diasDeAtraso === null ? (
      <><strong>Atraso em cascata:</strong> sem datas previstas suficientes para calcular.</>
    ) : cascata.diasDeAtraso > 0 ? (
      <><strong>Atraso em cascata:</strong> o projeto tende a terminar em {br(cascata.fimProjetado)}, {nDias(cascata.diasDeAtraso)} depois do previsto ({br(cascata.fimPrevisto)}){cascata.gargalo ? <>, por causa de <strong>{cascata.gargalo.nome}</strong></> : ''}.</>
    ) : (
      <><strong>Atraso em cascata:</strong> nenhum; o fim projetado é o previsto ({br(cascata.fimPrevisto)}).</>
    )}
    {travadas > 0 && <> {travadas === 1 ? '1 etapa está travada' : `${travadas} etapas estão travadas`} esperando a anterior terminar (veja a aba Dependências).</>}
  </p>}
  <div class="cr-abas" data-cart data-cr-abas>
    <div class="actions tabs" role="group" aria-label="Visões do cronograma">
      <button type="button" aria-pressed={aba === 'tarefas' ? 'true' : 'false'} data-cr-aba="tarefas">Tarefas e responsáveis</button>
      {!vazio && <>
        <button type="button" aria-pressed={aba === 'tempo' ? 'true' : 'false'} data-cr-aba="tempo">Linha do tempo</button>
        <button type="button" aria-pressed={aba === 'quadro' ? 'true' : 'false'} data-cr-aba="quadro">Quadro de tarefas</button>
        <button type="button" aria-pressed={aba === 'dependencias' ? 'true' : 'false'} data-cr-aba="dependencias">Dependências</button>
        <button type="button" aria-pressed={aba === 'dados' ? 'true' : 'false'} data-cr-aba="dados">Pendências de dado <span class="pill">{pend.length}</span></button>
      </>}
    </div>
    <section data-cr-painel="tarefas" aria-label="Tarefas e responsáveis" hidden={escondido('tarefas')}><TarefasResponsaveis cronograma={c} hoje={hoje} podeEditar={podeEditar} revisao={revisao} sugestoes={sugestoes} /></section>
    {!vazio && <>
      <section data-cr-painel="tempo" aria-label="Linha do tempo" hidden={escondido('tempo')}><LinhaDoTempo cronograma={c} hoje={hoje} /></section>
      <section data-cr-painel="quadro" aria-label="Quadro de tarefas" hidden={escondido('quadro')}><QuadroTarefas cronograma={c} hoje={hoje} /></section>
      <section data-cr-painel="dependencias" aria-label="Dependências entre etapas" hidden={escondido('dependencias')}><Dependencias cronograma={c} deps={deps} cascata={cascata!} hoje={hoje} /></section>
      <section data-cr-painel="dados" aria-label="Pendências de dado" hidden={escondido('dados')}>
        {pend.length === 0 ? <p>Nenhuma pendência de dado neste cronograma.</p> : <ul>{pend.map((t) => <li>{t}</li>)}</ul>}
      </section>
    </>}
  </div>
</Platform>
<style>
  .cr-cascata { margin: -.5rem 0 1.25rem; padding: .6rem 1rem; border: 1px solid var(--line); border-left: 4px solid var(--cart-amarelo); border-radius: 8px; background: var(--surface); max-width: none; overflow-wrap: anywhere; }
</style>
<script>
document.addEventListener('astro:page-load', () => {
  const raiz = document.querySelector<HTMLElement>('[data-cr-abas]');
  if (!raiz || raiz.dataset.pronto) return;
  raiz.dataset.pronto = 'sim';
  const botoes = raiz.querySelectorAll<HTMLButtonElement>('[data-cr-aba]');
  botoes.forEach((b) =>
    b.addEventListener('click', () => {
      botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      raiz.querySelectorAll<HTMLElement>('[data-cr-painel]').forEach((p) => {
        p.hidden = p.dataset.crPainel !== b.dataset.crAba;
      });
      const url = new URL(location.href);
      url.searchParams.set('aba', b.dataset.crAba ?? 'tempo');
      history.replaceState(history.state, '', url);
    }),
  );
});
</script>
