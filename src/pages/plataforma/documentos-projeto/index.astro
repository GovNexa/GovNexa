---
import Platform from '../../../layouts/Platform.astro';
import { carregarCarteira } from '../../../lib/carteira/carga.ts';
import { ID_PROJETO } from '../../../lib/documentos/regras.ts';
import { MENSAGENS } from '../../../lib/documentos/mensagens.ts';
export const prerender = false;
const escolhido = Astro.url.searchParams.get('projeto');
if (escolhido && ID_PROJETO.test(escolhido)) return Astro.redirect(`/plataforma/documentos-projeto/projeto/${encodeURIComponent(escolhido)}/`, 303);
const projetos = carregarCarteira().projetos;
const r = MENSAGENS[Astro.url.searchParams.get('r') ?? ''];
---
<Platform title="Documentos" slug="projetos-carteira">
  <div class="section-head"><div><h1>Documentos dos projetos</h1><p class="muted">Escolha o projeto para ver, enviar ou remover documentos (PDF, imagens e Office, até 25 MB).</p></div></div>
  {r && <p class={r.ok ? 'doc-ok' : 'doc-erro'} role="status">{r.texto}</p>}
  <form method="get" class="doc-escolha">
    <label for="doc-projeto">Projeto</label>
    <select id="doc-projeto" name="projeto" required>
      <option value="">Escolha…</option>
      {projetos.map((p) => <option value={p.id}>{p.id} · {p.nome}</option>)}
    </select>
    <button class="button primary" type="submit">Abrir</button>
  </form>
</Platform>
<style>
  .doc-escolha{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;max-width:42rem}
  .doc-escolha select{flex:1 1 16rem;min-width:0;max-width:100%}
  .doc-ok,.doc-erro{padding:.6rem .9rem;border-radius:8px;border:1px solid var(--line);max-width:42rem}
  .doc-ok{background:var(--soft)}
  .doc-erro{border-color:#b3261e}
</style>
