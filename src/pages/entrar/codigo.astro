---
export const prerender=false;
import Base from '../../layouts/Base.astro';
import LoginShell from '../../components/login/LoginShell.astro';
import Icon from '../../components/Icon.astro';
import { env, waitUntil } from 'cloudflare:workers';
import { servicoLogin, type EnvLogin } from '../../lib/login/servico.ts';
import { mensagemPublica, tempoMinimo, conferirPost, campo } from '../../lib/login/http.ts';
import { cookieSessao, lerCookie, obterSessao } from '../../lib/login/sessao.ts';
import { voltaSegura } from '../../lib/login/base.ts';
const inicio=performance.now();
const config=env as unknown as EnvLogin,valor=lerCookie(Astro.request,config),s=await obterSessao(config.DB_CENTRAL,valor);let erro='';
try {
if(!s||s.etapa!=='segundo_fator')return Astro.redirect('/entrar/',303);
if(Astro.request.method==='POST')try{conferirPost(Astro.request);const f=await Astro.request.formData(),servico=servicoLogin(config,Astro.request,waitUntil);const novo=campo(f,'recuperacao')?await servico.usarCodigoRecuperacao(valor,campo(f,'recuperacao')):await servico.concluirSegundoFator(valor,campo(f,'codigo'));const resposta=Astro.redirect(voltaSegura(Astro.url.searchParams.get('volta')),303);resposta.headers.set('Set-Cookie',cookieSessao(Astro.request,novo,false,config));return resposta;}catch(e){erro=mensagemPublica(e);}
} finally {if(Astro.request.method==='POST')await tempoMinimo(inicio);}

---
<Base title="Verificação em 2 etapas"><LoginShell heading="Verificação em 2 etapas" description="Digite os 6 dígitos do aplicativo autenticador."><div class="login-form">{erro&&<p role="alert">{erro}</p>}<form data-astro-reload method="post"><div class="login-field login-code-field"><label class="login-field-label" for="codigo-aplicativo"><Icon name="lock" size={17}/>Código do aplicativo</label><span class="login-input-wrap"><input id="codigo-aplicativo" name="codigo" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required /></span></div><button class="primary" type="submit">Verificar código</button></form><details><summary>Usar código de recuperação</summary><form data-astro-reload method="post"><div class="login-field"><label class="login-field-label" for="codigo-recuperacao">Código de recuperação</label><span class="login-input-wrap"><input id="codigo-recuperacao" name="recuperacao" pattern="[a-fA-F0-9]{4}-[a-fA-F0-9]{4}" autocomplete="off" required /></span></div><button class="primary" type="submit">Usar código de recuperação</button></form></details><p><a data-astro-reload href="/entrar/">Voltar ao login</a></p></div></LoginShell></Base>
