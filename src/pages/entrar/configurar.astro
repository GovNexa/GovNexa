---
export const prerender=false;
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { servicoLogin, type EnvLogin } from '../../lib/login/servico.ts';
import { mensagemPublica, conferirPost, campo } from '../../lib/login/http.ts';
import { cookieSessao, lerCookie, obterSessao } from '../../lib/login/sessao.ts';
import { voltaSegura } from '../../lib/login/base.ts';
const config=env as unknown as EnvLogin,valor=lerCookie(Astro.request,config),s=await obterSessao(config.DB_CENTRAL,valor);let erro='',codigos:string[]=[];
if(!s||s.etapa!=='configurar_2fa')return Astro.redirect('/entrar/',303);
const servico=servicoLogin(config,Astro.request);let configuracao:{segredo:string;svg:string}|null=null;
try {if(Astro.request.method==='POST'){conferirPost(Astro.request);const f=await Astro.request.formData();const r=await servico.confirmarTotp(valor,campo(f,'codigo'));codigos=r.codigos;Astro.response.headers.set('Set-Cookie',cookieSessao(Astro.request,r.valor,false,config));}else configuracao=await servico.configurarTotp(valor);}catch(e){erro=mensagemPublica(e);}
// Depois de erro no POST, a chave já existente pode ser exibida novamente sem gerar outra.
if(!codigos.length&&!configuracao)try{configuracao=await servico.configurarTotp(valor);}catch{}
---
<Base title="Configurar verificação em 2 etapas"><section class="login-layout"><div class="login-intro"><h1>Configurar verificação em 2 etapas</h1><p>Adicione esta conta em um aplicativo autenticador. A verificação é obrigatória para todos.</p></div><div class="login-form">{erro&&<p role="alert">{erro}</p>}{codigos.length?<><h2>Guarde seus códigos de recuperação</h2><p>Estes códigos aparecem uma única vez. Cada um permite uma entrada. Guarde-os em um lugar seguro.</p><ul>{codigos.map(c=><li><code>{c}</code></li>)}</ul><a data-astro-reload class="primary" href={voltaSegura(Astro.url.searchParams.get('volta'))}>Continuar para a plataforma</a></>:configuracao&&<><div class="qr" role="img" aria-label="QR Code para configurar o aplicativo" set:html={configuracao.svg}></div><p>Chave para digitar no aplicativo: <code data-testid="totp-segredo">{configuracao.segredo}</code></p><form data-astro-reload method="post"><label>Código do aplicativo<input name="codigo" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required /></label><button class="primary">Confirmar configuração</button></form></>}</div></section></Base>
<style>form,label{display:grid;gap:1rem}input,button{min-height:44px;box-sizing:border-box;width:100%}input{padding:.6rem;color:var(--text);background:var(--surface);border:1px solid var(--line)}code{overflow-wrap:anywhere}.qr{background:white;padding:1rem;max-width:280px}.qr :global(svg){display:block;width:100%;height:auto}</style>
