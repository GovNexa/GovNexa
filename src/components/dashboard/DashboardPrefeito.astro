---
// Painel da equipe (E10, rota /plataforma/gestao-equipe/): visão operacional que saiu da tela do prefeito na E3
// (farol, prazos, onde está parado, decisões pendentes, alertas, convênios e valores por região). Sem mapa: o mapa por área é da E4.
import Icon from '../Icon.astro';
import '../../styles/dashboard.css';
import { dataHoraBr, dataOuDataHoraBr } from '../../lib/datas.ts';
import { carregarCarteira } from '../../lib/carteira/carga.ts';
import { hrefFicha } from '../../lib/carteira/ficha.ts';
import { comVolta } from '../../lib/navegacao/volta.ts';
import { carregarCronogramas } from '../../lib/cronograma/carga.ts';
import { dados } from '../../lib/dados/index.ts';
import { avaliarFontes } from '../../lib/dados/qualidade.ts';
import { montarCentral, type ConvenioEntrada } from '../../lib/alertas/central.ts';
import { municipioAtivo } from '../../lib/municipio-ativo.ts';
import { hojeEmBrasilia } from '../../lib/whatsapp/farol.ts';
import { montarDashboard, opcoesFiltros, parametrosDaUrl, urlCom } from '../../lib/gestao/dashboard.ts';
import { ROTA_PAINEL_EQUIPE } from '../../lib/gestao/equipe.ts';
import type { Cartao, Filtros, IdCartao, Quebra, Situacao } from '../../lib/gestao/dashboard.ts';

const carteira = carregarCarteira();
const cronogramas = carregarCronogramas();
const municipio = municipioAtivo();
const entrada = {
  carteira,
  cronogramas: cronogramas.cronogramas,
  cronogramasImportadosEm: cronogramas.fonte.importado_em ?? null,
  acompanhamento: dados.acompanhamento(municipio.codigo_ibge) ?? null,
  cauc: dados.cauc(municipio.codigo_ibge) ?? null,
  programasAbertos: dados.programasAbertos(municipio.codigo_ibge) ?? null,
  eventosLei: [],
};
const validos = { ...opcoesFiltros(carteira), projetos: carteira.projetos.map((projeto) => projeto.id) };
const { filtros, cartao: cartaoId } = parametrosDaUrl(Astro.url, validos);
const hoje = hojeEmBrasilia();
const dashboard = montarDashboard(entrada, hoje, filtros);
const ROTA = ROTA_PAINEL_EQUIPE;
const rota = (cartao?: IdCartao) => urlCom(filtros, cartao, undefined, ROTA);
const cartaoSelecionado = dashboard.cartoes.find((cartao) => cartao.id === cartaoId);
const limparPainel = rota();
// A ficha volta para este painel com os mesmos filtros e o mesmo detalhe aberto.
const voltaFicha = `${Astro.url.pathname}${Astro.url.search}`;
const valorFicha = (id: string) => hrefFicha(id, voltaFicha);
// Alertas da central (toda a prefeitura), com a mesma montagem da guia Gestão › Alertas.
const central = montarCentral({
  carteira,
  cronogramas: cronogramas.cronogramas,
  cronogramasImportadosEm: cronogramas.fonte.importado_em ?? null,
  convenios: entrada.acompanhamento ? ((entrada.acompanhamento.convenios ?? []) as ConvenioEntrada[]) : null,
  fontes: avaliarFontes(new Date(`${hoje}T12:00:00Z`)),
  eventosLei: [],
  hoje,
  municipio: municipio.codigo_ibge,
});
const alertasTopo = central.alertas.slice(0, 5);
const dataFonte = (valor: string | null) => valor ? dataOuDataHoraBr(valor) : 'sem data';
const atualizado = dataHoraBr(new Date());
const moeda = (valor: number | null) => valor === null
  ? '—'
  : new Intl.NumberFormat('pt-BR', {
    style: 'currency',
    currency: 'BRL',
    notation: 'compact',
    maximumFractionDigits: 1,
  }).format(valor);
const inteiro = (valor: number | null) => valor === null ? '—' : Math.round(valor).toLocaleString('pt-BR');
const percentual = (valor: number | null) => valor === null ? '—' : `${valor.toLocaleString('pt-BR', { maximumFractionDigits: 1 })}%`;
const projetosMostrados = dashboard.cartoes.find((cartao) => cartao.id === 'carteira')?.valorPrincipal ?? 0;
const resumoFiltros = [
  filtros.regiao && `Região: ${filtros.regiao}`,
  filtros.orgao && `Órgão: ${filtros.orgao}`,
  filtros.prioridade && `Prioridade: ${filtros.prioridade}`,
  filtros.compromisso && `Compromisso: ${filtros.compromisso}`,
].filter(Boolean).join(', ');
const textoBR = (texto: string) => texto.replace(/(\d{4})-(\d{2})-(\d{2})/g, '$3/$2/$1').replace(/(\d+)\.(\d+)%/g, '$1,$2%').replace(/\b\d{4,}(?= (?:de|projetos|convênios|etapas|dias)\b)/g, (numero) => Number(numero).toLocaleString('pt-BR'));
const vazios: Partial<Record<Cartao["id"], string>> = { execucao: "Nenhum projeto em execução", contratacao: "Nenhum projeto em contratação", entregas: "Nenhuma entrega prevista em 90 dias" };
const secundario = (cartao: Cartao) => cartao.valorPrincipal === 0 && vazios[cartao.id] ? vazios[cartao.id]! : textoBR(cartao.id === 'cauc' ? `${inteiro(cartao.valorPrincipal)} pendências · consulta ${cartao.secundario.split('consulta: ')[1] ?? 'sem data'}` : cartao.secundario || '—');
const valorCartao = (cartao: Cartao) => cartao.id === 'cauc' ? (cartao.valorPrincipal === null ? '—' : cartao.situacao === 'ok' ? 'Regular' : 'Com pendência') : cartao.valorPrincipal === null
  ? '—'
  : cartao.unidade === 'reais'
    ? moeda(cartao.valorPrincipal)
    : cartao.unidade === 'percentual'
      ? percentual(cartao.valorPrincipal)
      : inteiro(cartao.valorPrincipal);
const situacoes: Record<Situacao, { rotulo: string; icone: string }> = {
  ok: { rotulo: 'Em dia', icone: 'check' },
  atencao: { rotulo: 'Atenção', icone: 'bell' },
  critico: { rotulo: 'Crítico', icone: 'x' },
  neutro: { rotulo: 'Sem alerta', icone: 'file' },
};
const labelResumo: Record<string, string> = {
  qtd: 'Projetos',
  valor: 'Valor',
  percentual: 'Executado',
  pactuado: 'Pactuado',
  liberado: 'Liberado',
  saldoALiberar: 'Saldo a liberar',
  pendencias: 'Pendências',
  itens: 'Itens consultados',
  orgaos: 'Órgãos',
};
const formatResumo = (chave: string, valor: number | null) =>
  /valor|pactuado|liberado|saldo/i.test(chave) ? moeda(valor)
    : /percentual/i.test(chave) ? percentual(valor)
      : inteiro(valor);
const escala = (valor: number, maximo: number) => `${maximo > 0 ? valor / maximo * 100 : 0}%`;
const linkItem = (item: { id: string; link: string }, cartao: Cartao) =>
  cartao.abrangencia === 'municipio' ? comVolta(item.link, voltaFicha) : valorFicha(item.id);
const barra = (quebras: Quebra[]) => Math.max(0, ...quebras.map((quebra) => quebra.valor ?? 0));
const filtrosAtivos = (chave: keyof Filtros) => filtros[chave] ?? '';
// Conservador: gravidade vem apenas dos cartões críticos; sem inferir novos alertas.
// Decisões entram somente quando vinculadas a itens de cartões críticos; não inferir gravidade.
const calculos: Record<Cartao['id'], string> = {
carteira: 'Quantidade de projetos nos filtros atuais.',
execucao: 'Projetos na macroetapa 05; percentual ponderado pelos valores conhecidos.',
contratacao: 'Projetos nas macroetapas 02 e 03; alertas dos prazos legais cadastrados.',
entregas: 'Projetos com encerramento previsto nos próximos 90 dias.',
atencao: 'Projetos não concluídos com farol vermelho.',
falta_financiar: 'Soma dos saldos sem fonte identificáveis dos projetos não concluídos.',
convenios: 'Quantidade em execução informada no resumo da coleta.',
convenios_risco: 'Convênios em execução com alerta ou vigência futura em até 180 dias; saldo não desembolsado.',
cauc: 'Pendências da coleta; Regular exige situação regular e lista de pendências vazia.',
oportunidades: 'Programas elegíveis com prazo nos próximos 30 dias.',
};
const criticos = dashboard.cartoes.filter(c => c.situacao === 'critico');
const pontos = [
  ...criticos.map(c => ({ id: c.id, texto: `${c.titulo}: ${valorCartao(c)} · ${secundario(c)}` })),
  ...dashboard.decisoes.flatMap(d => {
    const cartao = criticos.find(c => c.detalhe.itens.some(i => i.id === d.id));
    return cartao ? [{ id: cartao.id, texto: `${d.nome}: ${textoBR(d.motivo)}` }] : [];
  }),
].slice(0, 3);
const linkEtapa = '/plataforma/projetos-kanban/';
---

<div class="prefeito-dashboard" data-prefeito-dashboard>
  <header class="pd-cabecalho">
    <div>
      <p class="pd-sobretitulo">{municipio.nomeExibicao}</p>
      <h1>Painel da equipe</h1>
      <p class="pd-atualizado">Atualizado em <time datetime={new Date().toISOString()}>{atualizado}</time></p>
      <p class="pd-atualizacao" role="status" data-atualizacao hidden></p>
    </div>
    <button class="pd-apresentar" type="button" data-atualizar hidden>Atualizar agora</button>
    <button class="pd-apresentar" type="button" data-apresentar>
      <span data-apresentar-texto>Apresentar</span>
    </button>
  </header>

  <div data-pd-faixa>
    {criticos.length > 0 && <aside class="pd-alertas" aria-label="Pontos de atenção">
      <strong>Pontos de atenção</strong>
      <ul>{pontos.map(p => <li><a href={rota(p.id)} title={p.texto}>{p.texto}</a></li>)}</ul>
    </aside>}
  </div>
  <div data-pd-conteudo>
  <div class="pd-fontes-linha">
    <p>Fontes: {dashboard.fontes.map((fonte, indice) => `${['Carteira', 'Cronogramas', 'Transferegov', 'CAUC', 'Programas'][indice]} ${dataFonte(fonte.data)}`).join(' · ')}</p>
    <details><summary>Ver fontes</summary><ul class="pd-fontes">{dashboard.fontes.map((fonte) => <li>{fonte.nome} · {dataFonte(fonte.data)}</li>)}</ul></details>
  </div>

  <form class="pd-filtros" method="get" action={ROTA} aria-label="Filtros do painel da equipe">
    <label>Região
      <select name="regiao">
        <option value="">Todas</option>
        {validos.regioes.map((regiao) => <option value={regiao} selected={filtrosAtivos('regiao') === regiao}>{regiao}</option>)}
      </select>
    </label>
    <label>Órgão
      <select name="orgao">
        <option value="">Todos</option>
        {validos.orgaos.map((orgao) => <option value={orgao} selected={filtrosAtivos('orgao') === orgao}>{orgao}</option>)}
      </select>
    </label>
    <label>Prioridade
      <select name="prioridade">
        <option value="">Todas</option>
        {validos.prioridades.map((prioridade) => <option value={prioridade} selected={filtrosAtivos('prioridade') === prioridade}>{prioridade}</option>)}
      </select>
    </label>
    <label>Compromisso
      <select name="compromisso">
        <option value="">Todos</option>
        {(['decidido', 'condicionado', 'ideia'] as const).map((compromisso) => (
          <option value={compromisso} selected={filtrosAtivos('compromisso') === compromisso}>
            {compromisso === 'decidido' ? 'Decidido' : compromisso === 'condicionado' ? 'Condicionado' : 'Ideia'}
          </option>
        ))}
      </select>
    </label>
    <a class="pd-limpar" href={ROTA} data-limpar>Limpar</a>
    <noscript><button type="submit">Aplicar filtros</button></noscript>
    <div class="pd-filtros-resumo">
      <p data-projetos-resumo>Mostrando {inteiro(projetosMostrados)} projetos</p>
      <p role="status" aria-live="polite" data-filtros-status>{resumoFiltros ? `Filtros aplicados: ${resumoFiltros}` : 'Sem filtros. Mostrando todos.'}</p>
    </div>
  </form>

  <section class="pd-indicadores" aria-labelledby="pd-indicadores">
    <h2 id="pd-indicadores" class="sr-only">Indicadores</h2>
    <div class="pd-cartoes">
      {dashboard.cartoes.map((cartao, indice) => (
        <a
          class={`pd-cartao pd-situacao-${cartao.situacao}`}
          href={rota(cartao.id)}
          data-cartao={cartao.id} style={`--pd-atraso:${indice * 45}ms`}
        >
          <span class="pd-cartao-titulo">{cartao.titulo}</span>
          <strong class:list={["pd-numero", { "pd-numero-longo": valorCartao(cartao).length > 6, "pd-numero-texto": cartao.id === "cauc" }]} data-final={valorCartao(cartao)} data-valor={cartao.id !== "cauc" ? cartao.valorPrincipal : undefined} data-unidade={cartao.unidade}>{valorCartao(cartao)}</strong>
          <span class="pd-secundario">{secundario(cartao)}</span>
          <span class="pd-situacao" data-indicador={cartao.situacao}>
            <Icon name={situacoes[cartao.situacao].icone} size={18} />
            {situacoes[cartao.situacao].rotulo}
          </span>
          <span class="pd-calculo">Como é calculado: {calculos[cartao.id]}</span>
          {cartao.abrangencia === 'municipio' && <span class="pd-abrangencia">Toda a prefeitura</span>}
        </a>
      ))}
    </div>
  </section>
  </div>

  <div data-pd-conteudo data-pd-conteudo-fim>
  <section class="pd-secao" aria-labelledby="pd-funil">
    <h2 id="pd-funil">Carteira por macroetapa</h2><p class="pd-legenda">Barras proporcionais à quantidade de projetos.</p>
    <ul class="pd-barras" aria-label="Funil por macroetapa">
      {dashboard.funil.map((etapa) => (
        <li>
          <a href={linkEtapa}>
            <span class="pd-barra-label">{etapa.nome}</span>
            <span class="pd-barra-trilho"><span style={`width:${escala(etapa.qtd, Math.max(0, ...dashboard.funil.map((item) => item.qtd)))}`}></span></span>
            <span class="pd-barra-dados">{inteiro(etapa.qtd)} · {moeda(etapa.valor)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="pd-resumos">
    <section class="pd-secao pd-bloco" aria-labelledby="pd-parado">
      <h2 id="pd-parado">Onde está parado</h2>
      {dashboard.parado.length
        ? <ul class="pd-lista">
            {dashboard.parado.slice(0, 5).map((item) => (
              <li><a href="/plataforma/projetos-parado/">{item.unidade}</a><span>{inteiro(item.itens)} etapas · há {inteiro(item.dias)} dias</span></li>
            ))}
          </ul>
        : <p class="pd-vazio">Nenhuma etapa parada com prazo vencido.</p>}
    </section>
    <section class="pd-secao pd-bloco" aria-labelledby="pd-decisoes">
      <h2 id="pd-decisoes">Decisões pendentes</h2>
      {dashboard.decisoes.length
        ? <ul class="pd-lista">
            {dashboard.decisoes.slice(0, 5).map((item) => (
              <li><a href={valorFicha(item.id)}>{item.nome}</a><span>{textoBR(item.motivo)}</span></li>
            ))}
          </ul>
        : <p class="pd-vazio">Nenhuma decisão pendente identificada.</p>}
    </section>
  </div>

  <section class="pd-secao" aria-labelledby="pd-alertas-central" data-pd-alertas>
    <h2 id="pd-alertas-central">Alertas</h2>
    <p class="pd-legenda">Toda a prefeitura: {inteiro(central.totais.vermelho)} vermelhos e {inteiro(central.totais.amarelo)} amarelos. <a href="/plataforma/gestao-alertas/">Abrir a central de alertas</a></p>
    {alertasTopo.length
      ? <ul class="pd-lista">
          {alertasTopo.map((alerta) => (
            <li><a href={comVolta(alerta.link, voltaFicha)}>{textoBR(alerta.titulo)}</a><span>{alerta.gravidade === 'vermelho' ? 'Vermelho' : 'Amarelo'} · {textoBR(alerta.detalhe)}</span></li>
          ))}
        </ul>
      : <p class="pd-vazio">Nenhum alerta hoje.</p>}
  </section>

  <section class="pd-secao" aria-labelledby="pd-regioes">
    <h2 id="pd-regioes">Valores por região</h2>
    {dashboard.regioes.length
      ? <ul class="pd-regioes">
          {dashboard.regioes.map((regiao) => (
            <li><span>{regiao.nome}</span><strong>{moeda(regiao.valor)}</strong><small>{inteiro(regiao.qtd)} projetos</small></li>
          ))}
        </ul>
      : <p class="pd-vazio">Nenhuma região disponível para os filtros atuais.</p>}
  </section>

  </div>
  {cartaoSelecionado && (
    <>
      <a class="pd-overlay" href={limparPainel} aria-label="Fechar detalhes"></a>
      <section
        class="pd-painel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="pd-painel-titulo"
        data-painel
      >
        <header class="pd-painel-cabecalho">
          <div>
            <p class="pd-sobretitulo">Detalhamento</p>
            <h2 id="pd-painel-titulo">{cartaoSelecionado.titulo}</h2>
          </div>
          <form method="get" action={ROTA}>
            {Object.entries(filtros).map(([nome, valor]) => <input type="hidden" name={nome} value={valor} />)}
            <button class="pd-fechar" type="submit" data-fechar>
              <Icon name="x" size={22} />Fechar
            </button>
          </form>
        </header>
        <div class="pd-skeleton" aria-hidden="true"></div>
        <div class="pd-painel-corpo">
          <div class="pd-resumo-cartao">
            {Object.entries(cartaoSelecionado.detalhe.resumo).slice(0, 3).map(([chave, valor]) => (
              <div><span>{labelResumo[chave] ?? chave}</span><strong>{formatResumo(chave, valor)}</strong></div>
            ))}
          </div>
          <section class="pd-calculo-painel"><h3>Como é calculado</h3><p>{calculos[cartaoSelecionado.id]}</p></section>
          {([
            ['Órgão', cartaoSelecionado.detalhe.quebras.porOrgao],
            ['Região', cartaoSelecionado.detalhe.quebras.porRegiao],
            ['Macroetapa', cartaoSelecionado.detalhe.quebras.porMacroetapa],
          ] as [string, Quebra[]][]).map(([titulo, quebras]) => quebras.length > 0 && (
            <section class="pd-quebra">
              <h3>Por {titulo.toLocaleLowerCase('pt-BR')}</h3>
              <ul class="pd-barras pd-barras-painel">
                {quebras.map((quebra) => (
                  <li>
                    <span class="pd-barra-label">{quebra.nome}</span>
                    <span class="pd-barra-trilho" aria-label="Proporção do valor"><span style={`width:${escala(quebra.valor ?? 0, barra(quebras))}`}></span></span>
                    <span class="pd-barra-dados">{inteiro(quebra.qtd)} · {moeda(quebra.valor)}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <section class="pd-itens">
            <h3>Itens ({inteiro(cartaoSelecionado.valorPrincipal)})</h3>
            {cartaoSelecionado.detalhe.itens.length
              ? <ul class="pd-lista">
                  {cartaoSelecionado.detalhe.itens.map((item) => (
                    <li>
                      <a href={linkItem(item, cartaoSelecionado)}>{item.nome}</a>
                      <span>{textoBR(item.linha1)} · {textoBR(item.linha2)}</span>
                      <span class={`pd-item-situacao pd-situacao-${item.situacao}`}>
                        <Icon name={situacoes[item.situacao].icone} size={16} />
                        {situacoes[item.situacao].rotulo}
                      </span>
                      <strong>{moeda(item.valor)}</strong>
                    </li>
                  ))}
                </ul>
              : <p class="pd-vazio">Nenhum item para os filtros atuais.</p>}
          </section>
        </div>
      </section>
    </>
  )}

  <p class="sr-only" role="status" aria-live="polite" data-apresentacao-status></p>
</div>

<script>
import { ROTA_PAINEL_EQUIPE } from '../../lib/gestao/equipe.ts';
// Conclui a navegação de histórico mesmo durante uma transição pendente.
// A entrada é recarregada com os filtros e o painel renderizados pelo servidor.
window.addEventListener('popstate', (event) => {
  if (location.pathname !== ROTA_PAINEL_EQUIPE && !document.querySelector('[data-prefeito-dashboard]')) return;
  event.stopImmediatePropagation();
  location.reload();
}, { capture: true });

document.addEventListener('astro:page-load', () => {
  const lifecycle = new AbortController();
  document.addEventListener('astro:before-swap', () => lifecycle.abort(), { once: true });
  const painel = document.querySelector<HTMLElement>('[data-painel]');
  const fechar = painel?.querySelector<HTMLElement>('[data-fechar]');
  if (painel && fechar) {
    fechar.focus();
    painel.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        fechar.click();
      }
      if (event.key !== 'Tab') return;
      const focaveis = [...painel.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])')];
      if (!focaveis.length) return;
      const primeiro = focaveis[0];
      const ultimo = focaveis[focaveis.length - 1];
      if (event.shiftKey && document.activeElement === primeiro) {
        event.preventDefault();
        ultimo.focus();
      } else if (!event.shiftKey && document.activeElement === ultimo) {
        event.preventDefault();
        primeiro.focus();
      }
    }, { signal: lifecycle.signal });
  }

  const apresentar = document.querySelector<HTMLButtonElement>('[data-apresentar]');
  const status = document.querySelector<HTMLElement>('[data-apresentacao-status]');
  const root = document.querySelector<HTMLElement>('[data-prefeito-dashboard]');

  if (!root) return;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const ativos = new Map<HTMLElement, () => void>();
  const finalizar = () => { for (const limpar of ativos.values()) limpar(); ativos.clear(); };
  const formatarContagem = (el: HTMLElement, valor: number) => el.dataset.unidade === 'reais'
    ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', notation: 'compact', maximumFractionDigits: 1 }).format(valor)
    : el.dataset.unidade === 'percentual' ? valor.toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + '%' : Math.round(valor).toLocaleString('pt-BR');
  const contarVisualmente = (el: HTMLElement, anterior: number, valor: number, direcao?: string) => {
    if (motion.matches || matchMedia('print').matches || !Number.isFinite(anterior) || !Number.isFinite(valor)) return;
    ativos.get(el)?.();
    const camada = document.createElement('span');
    camada.className = 'pd-contagem-visual';
    camada.setAttribute('aria-hidden', 'true');
    camada.textContent = formatarContagem(el, anterior);
    if (direcao) camada.dataset.direcao = direcao;
    const suporte = document.createElement('span');
    suporte.className = 'pd-contagem';
    el.before(suporte);
    suporte.append(el, camada);
    el.style.opacity = '0';
    const limpar = () => { el.style.removeProperty('opacity'); suporte.replaceWith(el); };
    ativos.set(el, limpar);
    const inicio = performance.now();
    const passo = (agora: number) => {
      if (!ativos.has(el)) return;
      const fracao = Math.min(1, (agora - inicio) / 800);
      camada.textContent = formatarContagem(el, anterior + (valor - anterior) * fracao);
      if (fracao >= 1 || lifecycle.signal.aborted) { limpar(); ativos.delete(el); return; }
      requestAnimationFrame(passo);
    };
    requestAnimationFrame(passo);
  };
  motion.addEventListener('change', finalizar, { signal: lifecycle.signal });
  window.addEventListener('beforeprint', finalizar, { signal: lifecycle.signal });
  root.classList.add('pd-efeitos');
  if (!motion.matches && !matchMedia('print').matches) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        observer.unobserve(el);
        contarVisualmente(el, 0, Number(el.dataset.valor));
      }
    });
    root.querySelectorAll('.pd-numero[data-valor]').forEach(el => observer.observe(el));
    lifecycle.signal.addEventListener('abort', () => observer.disconnect(), { once: true });
  }
  const indicador = root.querySelector<HTMLElement>('[data-atualizacao]')!;
  const botao = root.querySelector<HTMLButtonElement>('[data-atualizar]')!;
  indicador.hidden = botao.hidden = false;
  let ultima = Date.now(), falhou = false, buscando = false;
  const relogio = () => { indicador.textContent = falhou ? 'Sem conexão, tentando de novo' : `Atualizado há ${Math.floor((Date.now() - ultima) / 60000)} min`; };
  let controladorBusca: AbortController | null = null;
  let pedido = 0;
  const substituirConteudo = async (url: URL, opcoes: { fecharPainel?: boolean; focoNome?: string; focoLimpar?: boolean; filtros?: boolean } = {}) => {
    controladorBusca?.abort();
    const controller = new AbortController();
    controladorBusca = controller;
    const idPedido = ++pedido;
    const cancelarNoDescarte = () => controller.abort();
    lifecycle.signal.addEventListener('abort', cancelarNoDescarte, { once: true });
    root.querySelector('[data-pd-conteudo]')?.setAttribute('aria-busy', 'true');
    try {
      const resposta = await fetch(url, { cache: 'no-store', signal: controller.signal });
      if (!resposta.ok || resposta.redirected) throw new Error('Resposta inválida');
      const novo = new DOMParser().parseFromString(await resposta.text(), 'text/html');
      const seletores = ['[data-pd-faixa]', '[data-pd-conteudo]:not([data-pd-conteudo-fim])', '[data-pd-conteudo-fim]'];
      if (seletores.some((seletor) => !novo.querySelector(seletor))) throw new Error('Dashboard ausente');
      if (controller.signal.aborted || idPedido !== pedido) return false;

      const anteriores = new Map([...root.querySelectorAll<HTMLElement>('[data-cartao]')].map((cartao) => [
        cartao.dataset.cartao,
        cartao.querySelector<HTMLElement>('.pd-numero')?.dataset.valor,
      ]));
      const rolagem = window.scrollY;
      finalizar();
      for (const seletor of seletores) {
        root.querySelector(seletor)!.replaceChildren(...Array.from(novo.querySelector(seletor)!.childNodes));
      }
      if (opcoes.fecharPainel) root.querySelectorAll('.pd-painel, .pd-overlay').forEach((el) => el.remove());
      for (const cartao of root.querySelectorAll<HTMLElement>('[data-cartao]')) {
        const numero = cartao.querySelector<HTMLElement>('.pd-numero');
        const antes = anteriores.get(cartao.dataset.cartao);
        const depois = numero?.dataset.valor;
        if (!numero || antes === undefined || depois === undefined || antes === depois) continue;
        const valorAnterior = Number(antes), valorNovo = Number(depois);
        if (!Number.isFinite(valorAnterior) || !Number.isFinite(valorNovo)) continue;
        const direcao = valorNovo > valorAnterior ? '↑' : '↓';
        numero.classList.add('pd-mudou');
        numero.dataset.direcao = direcao;
        contarVisualmente(numero, valorAnterior, valorNovo, direcao);
        window.setTimeout(() => { numero.classList.remove('pd-mudou'); delete numero.dataset.direcao; }, 4000);
      }
      if (opcoes.filtros) {
        history.replaceState(null, '', url);
        root.classList.add('pd-filtros-atualizados');
        window.setTimeout(() => root.classList.remove('pd-filtros-atualizados'), 260);
      }
      if (opcoes.focoNome) {
        [...root.querySelectorAll<HTMLSelectElement>('.pd-filtros select')].find((select) => select.name === opcoes.focoNome)?.focus();
      } else if (opcoes.focoLimpar) {
        root.querySelector<HTMLElement>('[data-limpar]')?.focus();
      }
      window.scrollTo(0, rolagem);
      return true;
    } finally {
      lifecycle.signal.removeEventListener('abort', cancelarNoDescarte);
      if (idPedido === pedido) {
        controladorBusca = null;
        root.querySelector('[data-pd-conteudo]')?.removeAttribute('aria-busy');
      }
    }
  };
  const aplicarFiltros = async (focoNome?: string, focoLimpar = false) => {
    const formulario = root.querySelector<HTMLFormElement>('.pd-filtros');
    if (!formulario) return;
    const url = new URL(formulario.action, location.href);
    url.search = '';
    for (const select of formulario.querySelectorAll<HTMLSelectElement>('select')) {
      if (select.value) url.searchParams.set(select.name, select.value);
    }
    const statusFiltros = formulario.querySelector<HTMLElement>('[data-filtros-status]');
    if (statusFiltros) statusFiltros.textContent = 'Atualizando filtros…';
    try {
      // A URL dos filtros não inclui cartao; fechar evita manter um detalhe desatualizado.
      const atualizado = await substituirConteudo(url, { filtros: true, fecharPainel: true, focoNome, focoLimpar });
      if (atualizado) { ultima = Date.now(); falhou = false; relogio(); }
    } catch (erro) {
      if (erro instanceof DOMException && erro.name === 'AbortError') return;
      if (!lifecycle.signal.aborted) {
        const mensagem = root.querySelector<HTMLElement>('[data-filtros-status]');
        if (mensagem) mensagem.textContent = 'Não foi possível atualizar. Tente de novo.';
      }
    }
  };
  root.addEventListener('change', (event) => {
    const select = event.target;
    if (select instanceof HTMLSelectElement && select.closest('.pd-filtros')) void aplicarFiltros(select.name);
  }, { signal: lifecycle.signal });
  root.addEventListener('submit', (event) => {
    if (!(event.target instanceof HTMLFormElement) || !event.target.matches('.pd-filtros')) return;
    event.preventDefault();
    void aplicarFiltros(document.activeElement instanceof HTMLSelectElement ? document.activeElement.name : undefined);
  }, { signal: lifecycle.signal });
  root.addEventListener('click', (event) => {
    const limpar = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-limpar]') : null;
    if (!limpar) return;
    event.preventDefault();
    root.querySelectorAll<HTMLSelectElement>('.pd-filtros select').forEach((select) => { select.value = ''; });
    void aplicarFiltros(undefined, true);
  }, { signal: lifecycle.signal });
  const atualizar = async () => {
    if (buscando || controladorBusca || document.hidden) return;
    buscando = true; botao.disabled = true;
    try {
      if (await substituirConteudo(new URL(location.href))) { ultima = Date.now(); falhou = false; }
    } catch (erro) {
      if (!(erro instanceof DOMException && erro.name === 'AbortError') && !lifecycle.signal.aborted) falhou = true;
    }
    finally { buscando = false; botao.disabled = false; relogio(); }
  };
  botao.addEventListener('click', atualizar, { signal: lifecycle.signal });
  const tick = () => { if (document.hidden) return; relogio(); if (Date.now() - ultima >= 300000) void atualizar(); };
  const intervalo = window.setInterval(tick, 15000);
  document.addEventListener('visibilitychange', tick, { signal: lifecycle.signal });
  lifecycle.signal.addEventListener('abort', () => { clearInterval(intervalo); finalizar(); }, { once: true });
  relogio();

  const sincronizarApresentacao = () => {
    const ativa = document.fullscreenElement === root;
    document.body.classList.toggle('dashboard-presenting', ativa);
    const texto = apresentar?.querySelector('[data-apresentar-texto]');
    if (texto) texto.textContent = ativa ? 'Sair da apresentação' : 'Apresentar';
  };
  apresentar?.addEventListener('click', async () => {
    if (document.fullscreenElement === root) { await document.exitFullscreen(); return; }
    if (!root || !document.fullscreenEnabled) {
      if (status) status.textContent = 'A apresentação em tela cheia não está disponível neste navegador.';
      return;
    }
    try {
      await root.requestFullscreen();
      if (status) status.textContent = '';
    } catch {
      if (status) status.textContent = 'Não foi possível iniciar a apresentação em tela cheia.';
    }
  }, { signal: lifecycle.signal });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && document.fullscreenElement === root) void document.exitFullscreen();
  }, { signal: lifecycle.signal });
  document.addEventListener('fullscreenchange', sincronizarApresentacao, { signal: lifecycle.signal });
  sincronizarApresentacao();
});
</script>
