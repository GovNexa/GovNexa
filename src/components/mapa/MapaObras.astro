---
// Mapa das obras (E4): cor, legenda e filtro por ÁREA; filtro por macroetapa e, opcional, por região; total de obras e
// valor por região. Sem situação de prazo (no prazo, atenção, atrasada) e sem farol. Textos de usuário só por textContent.
import '../../styles/prioritarios.css';
import '../../styles/mapa.css';
import Icon from '../Icon.astro';
import type { ObraBasica, ObraMapa } from '../../lib/mapa/obras.ts';

interface Props {
  obras: ObraMapa[];
  semLocal: number;
  semLocalLista?: ObraBasica[];
  altura?: string;
  id?: string;
  /** Versão de resumo (tela do prefeito): só o mapa e a legenda; tocar amplia para a apresentação em tela cheia. */
  compacto?: boolean;
  /** Endereço do mapa completo (Gestão) com os filtros equivalentes; só caminhos de /plataforma/gestao/. */
  linkCompleto?: string;
}
const { obras, semLocal, semLocalLista = [], altura = 'min(70vh, 640px)', id = 'mapa-obras', compacto = false } = Astro.props;
const COMPLETO = '/plataforma/gestao/#mapa';
const linkCompleto = typeof Astro.props.linkCompleto === 'string' && Astro.props.linkCompleto.startsWith('/plataforma/gestao/') && !/[\s\\]/.test(Astro.props.linkCompleto)
  ? Astro.props.linkCompleto
  : COMPLETO;
const dados = JSON.stringify({ obras, semLocalLista, semLocal }).replaceAll('<', '\\u003c');
---
<div class="mp-secao" data-mapa-obras={id} id={id} data-mp-compacto={compacto ? '' : undefined} data-mp-completo={linkCompleto}>
  <div class="mp-cab">
    <h2 id={`${id}-titulo`}>Mapa das obras</h2>
    {compacto
      ? <a class="mp-link" href={linkCompleto}>Abrir na Gestão →</a>
      : <a class="mp-link" href="/plataforma/projetos-localizacao/">Cadastrar localização</a>}
  </div>
  <p class="mp-contagem" role="status" aria-live="polite" data-mp-contagem></p>

  <div class="mp-filtros">
    <div class="mp-filtros-linha" role="group" aria-label="Filtros do mapa">
      <div class="mp-filtro" data-mp-filtro="etapas">
        <button type="button" class="mp-btn mp-filtro-abrir" data-mp-abrir aria-expanded="false" aria-controls={`${id}-filtro-etapas`}>Macroetapa: Todas ▾</button>
        <div class="mp-popover" id={`${id}-filtro-etapas`} data-mp-popover hidden></div>
      </div>
      <div class="mp-filtro" data-mp-filtro="areas">
        <button type="button" class="mp-btn mp-filtro-abrir" data-mp-abrir aria-expanded="false" aria-controls={`${id}-filtro-areas`}>Área: Todas ▾</button>
        <div class="mp-popover" id={`${id}-filtro-areas`} data-mp-popover hidden></div>
      </div>
      <div class="mp-filtro" data-mp-filtro="regiao">
        <button type="button" class="mp-btn mp-filtro-abrir" data-mp-abrir aria-expanded="false" aria-controls={`${id}-filtro-regiao`}>Região: Todas ▾</button>
        <div class="mp-popover" id={`${id}-filtro-regiao`} data-mp-popover hidden></div>
      </div>
    </div>
    <div class="mp-acoes">
      <button type="button" class="mp-btn" data-mp-limpar>Limpar filtros</button>
      <button type="button" class="mp-btn" data-mp-centralizar>Cidade inteira</button>
      <button type="button" class="mp-btn" data-mp-apresentar>Apresentar mapa</button>
    </div>
  </div>

  <div class="mp-layout">
    <div class="mp-mapa" data-mp-mapa role="region" aria-label="Mapa das obras de Goiânia" style={`height:${altura}`}>
      <div class="mp-zoom" role="group" aria-label="Controles de zoom">
        <button type="button" data-mp-zoom-in aria-label="Aumentar zoom">+</button>
        <button type="button" data-mp-zoom-out aria-label="Diminuir zoom">−</button>
      </div>
      <div class="mp-camadas" role="group" aria-label="Camada do mapa">
        <button type="button" data-mp-camada="mapa" aria-pressed="true">Mapa</button>
        <button type="button" data-mp-camada="satelite" aria-pressed="false">Satélite</button>
        <button type="button" data-mp-camada="hibrido" aria-pressed="false">Híbrido</button>
      </div>
      {compacto && (
        <button type="button" class="mp-expandir" data-mp-expandir aria-label="Ampliar o mapa das obras em tela cheia">
          <span aria-hidden="true"><Icon name="expandir" size={18} />Ampliar mapa</span>
        </button>
      )}
    </div>
    <aside class="mp-painel" aria-label="Resumo do mapa" aria-live="polite" data-mp-painel></aside>
  </div>

  <div class="mp-legenda-bloco">
    <ul class="mp-legenda" aria-label="Legenda das áreas" data-mp-legenda></ul>
    <p class="mp-legenda-nota"><span class="mp-contorno-aprox" aria-hidden="true"></span>Contorno tracejado = local aproximado (centro do bairro)</p>
  </div>

  <details class="mp-lista">
    <summary>Ver as obras em lista</summary>
    <div class="table-wrap">
      <table>
        <caption class="mp-nota">Obras visíveis com os filtros escolhidos</caption>
        <thead><tr><th scope="col">Obra</th><th scope="col">Órgão</th><th scope="col">Área</th><th scope="col">Macroetapa</th><th scope="col">Valor</th><th scope="col">Local</th></tr></thead>
        <tbody data-mp-lista-corpo></tbody>
      </table>
    </div>
  </details>
  <dialog class="mp-dialogo-ficha" data-mp-ficha aria-labelledby={`${id}-ficha-titulo`}>
    <div class="mp-dialogo-cab">
      <button type="button" class="mp-btn" data-mp-ficha-voltar>← Voltar ao mapa</button>
      <a data-mp-ficha-pagina>Abrir em página inteira</a>
    </div>
    <div class="mp-dialogo-conteudo" data-mp-ficha-conteudo>
      <h2 id={`${id}-ficha-titulo`} data-mp-ficha-titulo>Ficha do projeto</h2>
      <p role="status" data-mp-ficha-status>Carregando…</p>
    </div>
  </dialog>
  <script is:inline type="application/json" data-mp-dados set:html={dados}></script>
</div>

<script>
import * as L from 'leaflet';
import { criarCamadasFundo, ehCamada, preferenciaCamada, type NomeCamada } from '../../lib/mapa/camadas.ts';
import 'leaflet/dist/leaflet.css';
import { hrefFicha } from '../../lib/carteira/ficha.ts';
import { dataBr } from '../../lib/datas.ts';
import { ETAPAS, NOME_SEM_AREA, SEM_AREA, nomeEtapa, type IdEtapa } from '../../lib/gestao/prioritarios.ts';
import { GOIANIA } from '../../lib/mapa/geo.ts';
import { agruparPorBairro, agruparPorRegiao, type AgrupamentoMapa, type ObraAgrupavel } from '../../lib/mapa/agrupar.ts';
import { posicionarSemSobrepor, type Alvo, type Obstaculo } from '../../lib/mapa/bolhas.ts';
import { SERIES_COR, VAR_COR, glifoDaArea, serieDaCor, type SerieCor } from '../../lib/mapa/cores-area.ts';
import { elementoGlifo } from '../../lib/mapa/icones.ts';
import type { ObraBasica, ObraMapa } from '../../lib/mapa/obras.ts';
import { lerLocalizacoesSimuladas } from '../../lib/mapa/simulacao.ts';
import type { Localizacao, PontoGeo } from '../../lib/mapa/tipos.ts';
import { voltaSegura } from '../../lib/navegacao/volta.ts';

const voltaMapa = () => voltaSegura(`${location.pathname}${location.search}${location.hash}`, location.origin);

type ObraVista = ObraMapa & { simulada?: boolean };
type SemLocalVista = ObraBasica;
interface Dados { obras: ObraVista[]; semLocalLista: SemLocalVista[]; semLocal: number }
type Selecao =
  | { tipo: 'cidade' }
  | { tipo: 'grupo'; grupo: AgrupamentoMapa }
  | { tipo: 'obra'; obra: ObraVista };
interface OpcaoArea { codigo: string; nome: string; serie: SerieCor }

const IDS_ETAPA: IdEtapa[] = ETAPAS.map((etapa) => etapa.id);
const CODIGO_AREA_MAPA = /^(-sem|[a-z0-9_]{2,40})$/;
const MOEDA = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
const TAMANHO_MARCADOR = 44;
const tamanhoBolha = (total: number): number => Math.min(88, 52 + Math.sqrt(total) * 5);
const plural = (n: number, um: string, varios: string): string => `${n} ${n === 1 ? um : varios}`;

function el<K extends keyof HTMLElementTagNameMap>(tag: K, texto?: string, classe?: string): HTMLElementTagNameMap[K] {
  const e = document.createElement(tag);
  if (texto !== undefined) e.textContent = texto;
  if (classe) e.className = classe;
  return e;
}

function pontosDaLocalizacao(localizacao: Localizacao): PontoGeo[] {
  return localizacao.tipo === 'ponto'
    ? [localizacao.ponto]
    : localizacao.trechos.flatMap((trecho) => trecho.linha);
}

/** Onde fica o marcador clicável da obra: o ponto, ou o meio do primeiro trecho de rua. */
function pontoDoMarcador(obra: ObraVista): PontoGeo | null {
  const local = obra.localizacao;
  if (local.tipo === 'ponto') return local.ponto;
  const linha = local.trechos[0]?.linha ?? [];
  return linha[Math.floor(linha.length / 2)] ?? null;
}

function localTexto(o: ObraVista): string {
  const local = o.localizacao;
  if (o.precisao === 'bairro') return `Aproximado: centro do bairro ${o.bairro ?? ''}`.trim();
  if (local.tipo === 'ponto') return local.endereco ? `Ponto: ${local.endereco}` : 'Ponto marcado no mapa';
  return `${local.trechos.length} ${local.trechos.length === 1 ? 'trecho' : 'trechos'}: ${local.trechos.map((trecho) => trecho.rua).join(', ')}`;
}

function valorTexto(obras: ObraBasica[]): string {
  const conhecidos = obras.filter((obra) => typeof obra.valor === 'number' && Number.isFinite(obra.valor));
  if (conhecidos.length === 0) return `— (0 de ${obras.length} com valor)`;
  const total = conhecidos.reduce((soma, obra) => soma + (obra.valor ?? 0), 0);
  return `${MOEDA.format(total)} (${conhecidos.length} de ${obras.length} com valor)`;
}

const serieDe = (obra: ObraBasica): SerieCor => serieDaCor(obra.cor, obra.area);
const nomeAreaDe = (obra: ObraBasica): string => (typeof obra.areaNome === 'string' && obra.areaNome.trim() ? obra.areaNome : NOME_SEM_AREA);
const etapaValida = (obra: ObraBasica): IdEtapa => (IDS_ETAPA.includes(obra.etapa) ? obra.etapa : 'sem');

/** Áreas presentes, na ordem da legenda: as 6 com cor (1 a 6), depois as outras pelo nome e "Sem área" no fim. */
function areasPresentes(obras: ObraBasica[]): OpcaoArea[] {
  const mapa = new Map<string, OpcaoArea>();
  for (const obra of obras) {
    if (typeof obra.area !== 'string' || !CODIGO_AREA_MAPA.test(obra.area) || mapa.has(obra.area)) continue;
    mapa.set(obra.area, { codigo: obra.area, nome: nomeAreaDe(obra), serie: serieDe(obra) });
  }
  const peso = (a: OpcaoArea): number => SERIES_COR.indexOf(a.serie);
  return [...mapa.values()].sort((a, b) => peso(a) - peso(b) || a.nome.localeCompare(b.nome, 'pt-BR'));
}

function resumoAreas(obras: ObraBasica[]): string {
  return areasPresentes(obras).map((area) => `${area.nome} ${obras.filter((obra) => obra.area === area.codigo).length}`).join(' · ');
}

document.addEventListener('astro:page-load', () => {
  const raiz = document.querySelector<HTMLElement>('[data-mapa-obras]');
  if (!raiz || raiz.dataset.pronto) return;
  raiz.dataset.pronto = 'sim';
  let dados: Dados;
  try {
    const bruto = JSON.parse(raiz.querySelector('[data-mp-dados]')?.textContent || '') as Partial<Dados>;
    if (!Array.isArray(bruto.obras) || !Array.isArray(bruto.semLocalLista) || typeof bruto.semLocal !== 'number') {
      throw new Error('Estrutura de dados incompleta.');
    }
    dados = { obras: bruto.obras, semLocalLista: bruto.semLocalLista, semLocal: bruto.semLocal };
  } catch (erro) {
    const mensagem = el('p', 'Não foi possível carregar os dados do mapa.', 'mp-aviso');
    mensagem.setAttribute('role', 'alert');
    raiz.append(mensagem);
    console.error('Falha ao carregar dados do mapa.', erro);
    return;
  }
  const q = <T extends HTMLElement>(seletor: string) => raiz.querySelector<T>(seletor)!;

  const compacto = raiz.hasAttribute('data-mp-compacto');
  const completo = raiz.dataset.mpCompleto?.startsWith('/plataforma/gestao/') ? raiz.dataset.mpCompleto : '/plataforma/gestao/#mapa';
  const simuladas = lerLocalizacoesSimuladas();
  const todas: ObraVista[] = [];
  let semLocal = 0;
  // Monta a lista de obras (também usada quando a tela que contém o mapa envia dados novos).
  const montarObras = (d: Dados): void => {
    todas.length = 0;
    for (const obra of d.obras) {
      todas.push(simuladas[obra.id] ? { ...obra, localizacao: simuladas[obra.id], precisao: 'cadastrada', simulada: true } : obra);
    }
    semLocal = d.semLocal;
    for (const obra of d.semLocalLista) {
      if (simuladas[obra.id]) {
        todas.push({ ...obra, localizacao: simuladas[obra.id], precisao: 'cadastrada', simulada: true });
        semLocal--;
      }
    }
    semLocal = Math.max(0, semLocal);
  };
  montarObras(dados);

  // Filtros: null = todas. Na versão compacta o estado não vai para o endereço (que pertence à tela que contém o mapa).
  let etapasFiltro: Set<IdEtapa> | null = null;
  let areasFiltro: Set<string> | null = null;
  let regiaoFiltro = '';
  let opcoesArea: OpcaoArea[] = [];
  let opcoesRegiao: string[] = [];
  const recalcularOpcoes = (): void => {
    opcoesArea = areasPresentes(todas);
    opcoesRegiao = [...new Set(todas.map((obra) => (typeof obra.regiao === 'string' ? obra.regiao.trim() : '')).filter(Boolean))]
      .sort((a, b) => a.localeCompare(b, 'pt-BR'));
  };
  recalcularOpcoes();
  const lerFiltrosDoEndereco = (parametros: URLSearchParams): void => {
    const lista = (chave: string): string[] | null => {
      const valor = parametros.get(chave);
      return valor === null ? null : valor.split(',').map((item) => item.trim()).filter(Boolean);
    };
    // Parâmetro ausente = todas; presente e vazio (ou sem item válido) = conjunto vazio (nenhuma obra).
    const etapasLidas = lista('etapas');
    const etapas = etapasLidas?.filter((item): item is IdEtapa => IDS_ETAPA.includes(item as IdEtapa)) ?? [];
    etapasFiltro = etapasLidas === null || new Set(etapas).size === IDS_ETAPA.length ? null : new Set(etapas);
    const codigos = opcoesArea.map((area) => area.codigo);
    const areasLidas = lista('areas');
    const areas = areasLidas?.filter((item) => codigos.includes(item)) ?? [];
    areasFiltro = areasLidas === null || (codigos.length > 0 && new Set(areas).size === codigos.length) ? null : new Set(areas);
    // Região que não corresponde a nenhuma obra continua valendo: o mapa fica vazio, com aviso.
    regiaoFiltro = (parametros.get('regiao') ?? '').trim();
  };
  const parametrosIniciais = new URLSearchParams(compacto ? '' : location.search);
  lerFiltrosDoEndereco(parametrosIniciais);
  const centroInicial = parametrosIniciais.get('c')?.split(',').map(Number);
  const zoomInicial = Number(parametrosIniciais.get('z'));
  const centroValido = centroInicial?.length === 2 && centroInicial.every(Number.isFinite)
    && Math.abs(centroInicial[0]!) <= 90 && Math.abs(centroInicial[1]!) <= 180;
  const zoomValido = Number.isFinite(zoomInicial) && zoomInicial >= 10 && zoomInicial <= 18;
  let selecao: Selecao = { tipo: 'cidade' };
  const historico: Selecao[] = [];
  const elMapa = q('[data-mp-mapa]');
  const mapa = L.map(elMapa, {
    zoomControl: false,
    tap: true,
    minZoom: 10,
    maxZoom: 18,
    zoomAnimation: !matchMedia('(prefers-reduced-motion: reduce)').matches,
    fadeAnimation: !matchMedia('(prefers-reduced-motion: reduce)').matches,
    markerZoomAnimation: !matchMedia('(prefers-reduced-motion: reduce)').matches,
  }).setView(
    centroValido ? [centroInicial[0]!, centroInicial[1]!] : [GOIANIA.centro.lat, GOIANIA.centro.lng],
    zoomValido ? zoomInicial : 12,
  );
  const camadasFundo = criarCamadasFundo(L);
  const botoesCamada = raiz.querySelectorAll<HTMLButtonElement>('[data-mp-camada]');
  let camadaAtual: NomeCamada = 'mapa';
  function aplicarCamada(nome: NomeCamada): void {
    for (const lista of Object.values(camadasFundo)) for (const c of lista) if (mapa.hasLayer(c)) mapa.removeLayer(c);
    for (const c of camadasFundo[nome]) c.addTo(mapa);
    camadaAtual = nome;
    elMapa.dataset.camada = nome;
    for (const b of botoesCamada) b.setAttribute('aria-pressed', String(b.dataset.mpCamada === nome));
    preferenciaCamada(nome);
  }
  {
    const lembrada = preferenciaCamada();
    const pedida = parametrosIniciais.get('camada');
    aplicarCamada(ehCamada(pedida) ? pedida : ehCamada(lembrada) ? lembrada : 'mapa');
  }
  const camada = L.layerGroup().addTo(mapa);
  const marcadoresObra = new Map<string, L.Marker>();
  const contagem = q('[data-mp-contagem]');
  const corpo = q('[data-mp-lista-corpo]');
  const painel = q('[data-mp-painel]');
  const legenda = q('[data-mp-legenda]');
  const aviso = el('p', undefined, 'mp-aviso');
  aviso.setAttribute('role', 'status');
  aviso.hidden = true;
  painel.after(aviso);

  function mostrarAviso(texto: string): void {
    aviso.textContent = texto;
    aviso.hidden = false;
  }

  function atualizarMarcadoresSelecionados(): void {
    const obraSelecionada = selecao.tipo === 'obra' ? selecao.obra.id : null;
    for (const [id, marcador] of marcadoresObra) {
      const selecionado = id === obraSelecionada;
      marcador.getElement()?.querySelector('.mp-marcador')?.classList.toggle('mp-marcador-selecionado', selecionado);
      marcador.setZIndexOffset(selecionado ? 1000 : 0);
    }
  }

  type TipoFiltro = 'etapas' | 'areas' | 'regiao';
  const filtros = new Map<TipoFiltro, { trigger: HTMLButtonElement; popover: HTMLDivElement; opcoes: HTMLDivElement; raiz: HTMLElement }>();
  const fecharFiltro = (restaurarFoco = false): void => {
    for (const { trigger, popover } of filtros.values()) {
      if (popover.hidden) continue;
      popover.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restaurarFoco) trigger.focus();
    }
  };
  const salvarURL = (): void => {
    if (compacto) return;
    const url = new URL(location.href);
    for (const antigo of ['sit', 'tipos']) url.searchParams.delete(antigo);
    if (etapasFiltro) url.searchParams.set('etapas', IDS_ETAPA.filter((item) => etapasFiltro!.has(item)).join(','));
    else url.searchParams.delete('etapas');
    if (areasFiltro) url.searchParams.set('areas', opcoesArea.map((area) => area.codigo).filter((codigo) => areasFiltro!.has(codigo)).join(','));
    else url.searchParams.delete('areas');
    if (regiaoFiltro) url.searchParams.set('regiao', regiaoFiltro);
    else url.searchParams.delete('regiao');
    url.searchParams.set('z', String(mapa.getZoom()));
    const centro = mapa.getCenter();
    url.searchParams.set('c', `${centro.lat.toFixed(5)},${centro.lng.toFixed(5)}`);
    const selecionado = selecao.tipo === 'obra' ? `obra:${selecao.obra.id}` : selecao.tipo === 'grupo' ? selecao.grupo.id : null;
    if (camadaAtual === 'mapa') url.searchParams.delete('camada');
    else url.searchParams.set('camada', camadaAtual);
    if (selecionado) url.searchParams.set('sel', selecionado);
    else url.searchParams.delete('sel');
    history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
  };
  const atualizarResumo = (): void => {
    const atualizar = (tipo: TipoFiltro, texto: string): void => {
      const entrada = filtros.get(tipo);
      if (entrada) entrada.trigger.textContent = `${texto} ▾`;
    };
    const etapasMarcadas = etapasFiltro ? IDS_ETAPA.filter((item) => etapasFiltro!.has(item)) : IDS_ETAPA;
    atualizar('etapas', `Macroetapa: ${!etapasFiltro ? 'Todas' : etapasMarcadas.length === 1 ? nomeEtapa(etapasMarcadas[0]) : `${etapasMarcadas.length} de ${IDS_ETAPA.length}`}`);
    const areasMarcadas = areasFiltro ? opcoesArea.filter((area) => areasFiltro!.has(area.codigo)) : opcoesArea;
    atualizar('areas', `Área: ${!areasFiltro ? 'Todas' : areasMarcadas.length === 1 ? areasMarcadas[0].nome : `${areasMarcadas.length} de ${opcoesArea.length}`}`);
    atualizar('regiao', `Região: ${regiaoFiltro || 'Todas'}`);
    const filtroRegiao = filtros.get('regiao');
    if (filtroRegiao) filtroRegiao.raiz.hidden = opcoesRegiao.length === 0;
  };
  const criarOpcao = (
    popover: HTMLElement,
    nomeGrupo: string,
    valor: string,
    rotulo: string,
    tipo: 'checkbox' | 'radio',
    marcado: boolean,
    aoMudar: (marcado: boolean) => void,
    serie?: SerieCor,
  ): HTMLInputElement => {
    const rotuloEl = el('label', undefined, 'mp-opcao-filtro');
    const input = el('input');
    input.type = tipo;
    input.name = nomeGrupo;
    input.value = valor;
    input.checked = marcado;
    input.addEventListener('change', () => aoMudar(input.checked));
    rotuloEl.append(input);
    if (serie) {
      const amostra = el('span', undefined, `mp-amostra ${serie}`);
      amostra.setAttribute('aria-hidden', 'true');
      rotuloEl.append(amostra);
    }
    rotuloEl.append(el('span', rotulo));
    popover.append(rotuloEl);
    return input;
  };
  const aposMudarFiltro = (): void => {
    atualizarResumo();
    salvarURL();
    desenhar();
  };
  const adicionarFiltro = (tipo: TipoFiltro, titulo: string, multiplo: boolean, aoMarcarTodos?: (todos: boolean) => void): void => {
    const raizFiltro = q<HTMLElement>(`[data-mp-filtro="${tipo}"]`);
    const trigger = raizFiltro.querySelector<HTMLButtonElement>('[data-mp-abrir]')!;
    const popover = raizFiltro.querySelector<HTMLDivElement>('[data-mp-popover]')!;
    const opcoes = el('div', undefined, 'mp-opcoes');
    opcoes.setAttribute('role', 'group');
    opcoes.setAttribute('aria-label', titulo);
    popover.append(opcoes);
    filtros.set(tipo, { trigger, popover, opcoes, raiz: raizFiltro });
    trigger.addEventListener('click', () => {
      const estavaAberto = !popover.hidden;
      fecharFiltro();
      if (!estavaAberto) {
        popover.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        popover.querySelector<HTMLElement>('input,button')?.focus();
      }
    });
    popover.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Tab') return;
      const focaveis = [...popover.querySelectorAll<HTMLElement>('input:not(:disabled),button:not(:disabled)')];
      const primeiro = focaveis[0];
      const ultimo = focaveis.at(-1);
      if (evento.shiftKey && document.activeElement === primeiro) {
        evento.preventDefault();
        ultimo?.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primeiro?.focus();
      }
    });
    const rodape = el('div', undefined, 'mp-popover-acoes');
    if (multiplo && aoMarcarTodos) {
      const marcar = el('button', 'Marcar todos', 'mp-btn');
      const desmarcar = el('button', 'Desmarcar todos', 'mp-btn');
      marcar.type = desmarcar.type = 'button';
      marcar.dataset.mpMarcar = 'todos';
      desmarcar.dataset.mpMarcar = 'nenhum';
      marcar.addEventListener('click', () => aoMarcarTodos(true));
      desmarcar.addEventListener('click', () => aoMarcarTodos(false));
      rodape.append(marcar, desmarcar);
    }
    const pronto = el('button', 'Pronto', 'mp-btn');
    pronto.type = 'button';
    pronto.dataset.mpPronto = '';
    pronto.addEventListener('click', () => fecharFiltro(true));
    rodape.append(pronto);
    popover.append(rodape);
  };

  adicionarFiltro('etapas', 'Macroetapas', true, (todos) => {
    etapasFiltro = todos ? null : new Set();
    montarOpcoesEtapa();
    aposMudarFiltro();
  });
  adicionarFiltro('areas', 'Áreas', true, (todos) => {
    areasFiltro = todos ? null : new Set();
    montarOpcoesArea();
    aposMudarFiltro();
  });
  adicionarFiltro('regiao', 'Região (opcional)', false);

  function montarOpcoesEtapa(): void {
    const { opcoes } = filtros.get('etapas')!;
    opcoes.replaceChildren();
    for (const etapa of ETAPAS) {
      criarOpcao(opcoes, `${raiz!.id}-etapas`, etapa.id, etapa.nome, 'checkbox', !etapasFiltro || etapasFiltro.has(etapa.id), (ligado) => {
        const atual = new Set(etapasFiltro ?? IDS_ETAPA);
        if (ligado) atual.add(etapa.id); else atual.delete(etapa.id);
        etapasFiltro = atual.size === IDS_ETAPA.length ? null : atual;
        aposMudarFiltro();
      });
    }
  }
  function montarOpcoesArea(): void {
    const { opcoes } = filtros.get('areas')!;
    opcoes.replaceChildren();
    if (opcoesArea.length === 0) opcoes.append(el('p', 'Nenhuma obra no mapa.', 'mp-nota'));
    for (const area of opcoesArea) {
      criarOpcao(opcoes, `${raiz!.id}-areas`, area.codigo, area.nome, 'checkbox', !areasFiltro || areasFiltro.has(area.codigo), (ligado) => {
        const atual = new Set(areasFiltro ?? opcoesArea.map((item) => item.codigo));
        if (ligado) atual.add(area.codigo); else atual.delete(area.codigo);
        areasFiltro = atual.size === opcoesArea.length ? null : atual;
        aposMudarFiltro();
      }, area.serie);
    }
  }
  function montarOpcoesRegiao(): void {
    const { opcoes } = filtros.get('regiao')!;
    opcoes.replaceChildren();
    for (const regiao of ['', ...opcoesRegiao]) {
      criarOpcao(opcoes, `${raiz!.id}-regiao`, regiao, regiao || 'Todas', 'radio', regiao === regiaoFiltro, () => {
        regiaoFiltro = regiao;
        aposMudarFiltro();
      });
    }
  }
  const montarOpcoes = (): void => {
    montarOpcoesEtapa();
    montarOpcoesArea();
    montarOpcoesRegiao();
    atualizarResumo();
  };
  montarOpcoes();
  document.addEventListener('pointerdown', (evento) => {
    if (!(evento.target instanceof Element) || !raiz.contains(evento.target) || !evento.target.closest('[data-mp-filtro]')) fecharFiltro();
  });

  function obrasFiltradas(): ObraVista[] {
    return todas.filter((obra) =>
      (!etapasFiltro || etapasFiltro.has(etapaValida(obra))) &&
      (!areasFiltro || areasFiltro.has(obra.area)) &&
      (!regiaoFiltro || (typeof obra.regiao === 'string' ? obra.regiao.trim() : '') === regiaoFiltro),
    );
  }

  function obrasAgrupaveis(obras: ObraVista[]): ObraAgrupavel[] {
    return obras.map((obra) => ({
      id: obra.id,
      regiao: obra.regiao,
      bairro: obra.bairro,
      serie: serieDe(obra),
      pontos: pontosDaLocalizacao(obra.localizacao),
    }));
  }

  function selecionar(nova: Selecao, voltar = true): void {
    if (voltar) historico.push(selecao);
    selecao = nova;
    atualizarMarcadoresSelecionados();
    renderPainel(obrasFiltradas());
    salvarURL();
  }

  function selecionarGrupo(grupo: AgrupamentoMapa, zoom: number): void {
    if (!grupo.centro) return;
    selecionar({ tipo: 'grupo', grupo });
    mapa.setView([grupo.centro.lat, grupo.centro.lng], zoom);
  }

  function selecionarObra(obra: ObraVista): void {
    const ponto = pontoDoMarcador(obra);
    selecionar({ tipo: 'obra', obra });
    if (ponto) mapa.setView([ponto.lat, ponto.lng], Math.max(15, mapa.getZoom()));
  }

  function botaoObra(obra: ObraVista): HTMLButtonElement {
    const botao = el('button', undefined, 'mp-item');
    botao.append(
      el('strong', obra.nome),
      el('span', `${obra.orgao ?? 'Sem órgão'} · ${nomeAreaDe(obra)} · ${nomeEtapa(etapaValida(obra))}`),
    );
    botao.type = 'button';
    botao.addEventListener('click', () => selecionarObra(obra));
    return botao;
  }

  const dialogoFicha = q<HTMLDialogElement>('[data-mp-ficha]');
  const conteudoFicha = q<HTMLElement>('[data-mp-ficha-conteudo]');
  const tituloFicha = q<HTMLElement>('[data-mp-ficha-titulo]');
  const statusFicha = q<HTMLElement>('[data-mp-ficha-status]');
  const linkFichaPagina = q<HTMLAnchorElement>('[data-mp-ficha-pagina]');
  let linkFichaAtivo: HTMLAnchorElement | null = null;
  const voltarFicha = q<HTMLButtonElement>('[data-mp-ficha-voltar]');
  voltarFicha.addEventListener('click', () => dialogoFicha.close());
  dialogoFicha.addEventListener('close', () => {
    linkFichaAtivo?.focus();
    linkFichaAtivo = null;
  });
  async function abrirFicha(obra: ObraVista, link: HTMLAnchorElement): Promise<void> {
    linkFichaAtivo = link;
    tituloFicha.textContent = obra.nome;
    statusFicha.hidden = false;
    statusFicha.textContent = 'Carregando…';
    const urlCompleta = new URL(link.href);
    urlCompleta.searchParams.set('volta', `${location.pathname}${location.search}${location.hash}`);
    linkFichaPagina.href = urlCompleta.href;
    conteudoFicha.querySelectorAll(':scope > :not([data-mp-ficha-titulo]):not([data-mp-ficha-status])').forEach((item) => item.remove());
    if (!dialogoFicha.open) dialogoFicha.showModal();
    try {
      const resposta = await fetch(link.href, { headers: { Accept: 'text/html' } });
      if (!resposta.ok) throw new Error(`Resposta ${resposta.status}`);
      const documento = new DOMParser().parseFromString(await resposta.text(), 'text/html');
      const workspace = documento.querySelector<HTMLElement>('.workspace');
      if (!workspace) throw new Error('Conteúdo da ficha não encontrado.');
      documento.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"][href]').forEach((link) => {
        const href = new URL(link.getAttribute('href')!, resposta.url).href;
        const jaCarregado = [...document.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"][href]')]
          .some((atual) => new URL(atual.getAttribute('href')!, location.href).href === href);
        if (!jaCarregado) {
          const copia = document.importNode(link, true);
          copia.href = href;
          document.head.append(copia);
        }
      });
      documento.head.querySelectorAll('style').forEach((style) => {
        const conteudo = style.textContent?.trim();
        if (!conteudo || [...document.head.querySelectorAll('style')].some((atual) => atual.textContent?.trim() === conteudo)) return;
        document.head.append(document.importNode(style, true));
      });
      workspace.querySelectorAll('.pj-contexto, .pj-titulo, .notice, .pj-so-pagina').forEach((item) => item.remove());
      workspace.querySelectorAll('script').forEach((script) => script.remove());
      const fragmento = document.createDocumentFragment();
      workspace.childNodes.forEach((no) => fragmento.append(document.importNode(no, true)));
      conteudoFicha.append(fragmento);
      statusFicha.hidden = true;
      voltarFicha.focus();
    } catch (erro) {
      statusFicha.textContent = 'Não foi possível carregar a ficha agora. Tente novamente ou abra em página inteira.';
      console.error('Falha ao carregar a ficha do projeto pelo mapa.', erro);
    }
  }

  function renderPainel(obras: ObraVista[]): void {
    painel.replaceChildren();
    const cabecalho = el('div', undefined, 'mp-painel-cab');
    const titulo = el('h3');
    const acoes = el('div', undefined, 'mp-painel-acoes');
    if (selecao.tipo !== 'cidade') {
      const voltar = el('button', 'Voltar', 'mp-btn mp-btn-voltar');
      voltar.type = 'button';
      voltar.addEventListener('click', () => {
        const anterior: Selecao = historico.pop() ?? { tipo: 'cidade' };
        selecao = anterior;
        atualizarMarcadoresSelecionados();
        if (anterior.tipo === 'cidade') mapa.setView([GOIANIA.centro.lat, GOIANIA.centro.lng], 12);
        else if (anterior.tipo === 'grupo' && anterior.grupo.centro) {
          mapa.setView(
            [anterior.grupo.centro.lat, anterior.grupo.centro.lng],
            anterior.grupo.nivel === 'regiao' ? 13 : 15,
          );
        }
        renderPainel(obrasFiltradas());
        salvarURL();
      });
      acoes.append(voltar);
    }
    if (selecao.tipo === 'obra') {
      const obra = selecao.obra;
      titulo.textContent = obra.nome;
      cabecalho.append(titulo, acoes);
      painel.append(cabecalho);
      if (obra.simulada) painel.append(el('span', 'Simulação', 'mp-selo'));
      painel.append(
        el('p', obra.orgao ?? 'Sem órgão'),
        el('p', `Área: ${nomeAreaDe(obra)}`),
        el('p', `Macroetapa: ${nomeEtapa(etapaValida(obra))}`),
        el('p', `Valor: ${typeof obra.valor === 'number' && Number.isFinite(obra.valor) ? MOEDA.format(obra.valor) : '—'}`),
      );
      if (typeof obra.percentual === 'number' && Number.isFinite(obra.percentual)) painel.append(el('p', `Executado: ${Math.round(obra.percentual)}%`));
      painel.append(el('p', `Entrega prevista: ${obra.entrega ? dataBr(obra.entrega) : 'Sem data'}`));
      if (obra.foto) {
        const foto = el('img');
        foto.src = obra.foto;
        foto.alt = `Foto da obra: ${obra.nome}`;
        foto.loading = 'lazy';
        painel.append(foto);
      }
      if (obra.precisao === 'bairro') painel.append(el('p', `Local aproximado (centro do bairro ${obra.bairro ?? ''})`, 'mp-aviso-local'));
      const links = el('div', undefined, 'mp-painel-links');
      const ficha = el('a', 'Abrir ficha completa');
      ficha.href = hrefFicha(obra.id, voltaMapa());
      ficha.addEventListener('click', (evento) => {
        evento.preventDefault();
        void abrirFicha(obra, ficha);
      });
      const editar = el('a', 'Localização');
      editar.href = hrefFicha(obra.id, voltaMapa(), 'localizacao');
      editar.addEventListener('click', () => { editar.href = hrefFicha(obra.id, voltaMapa(), 'localizacao'); });
      links.append(ficha, editar);
      painel.append(links);
      return;
    }

    const porId = new Map(obras.map((obra) => [obra.id, obra]));
    const membrosDe = (grupo: AgrupamentoMapa): ObraVista[] => grupo.ids.map((id) => porId.get(id)).filter((obra): obra is ObraVista => !!obra);
    if (selecao.tipo === 'grupo') {
      const grupo = selecao.grupo;
      const membros = obras.filter((obra) => grupo.ids.includes(obra.id));
      titulo.textContent = grupo.nome;
      cabecalho.append(titulo, acoes);
      painel.append(cabecalho, el('p', plural(membros.length, 'obra', 'obras')));
      painel.append(el('p', `Valor: ${valorTexto(membros)}`));
      if (membros.length) painel.append(el('p', `Por área: ${resumoAreas(membros)}`));
      const lista = el('div', undefined, 'mp-painel-lista');
      for (const obra of membros) lista.append(botaoObra(obra));
      painel.append(lista);
      return;
    }

    titulo.textContent = 'Goiânia';
    cabecalho.append(titulo, acoes);
    painel.append(cabecalho, el('p', plural(obras.length, 'obra no mapa', 'obras no mapa')));
    painel.append(el('p', `Valor: ${valorTexto(obras)}`));
    if (obras.length === 0) {
      painel.append(el('p', todas.length ? 'Nenhuma obra com estes filtros. Use "Limpar filtros" para ver todas.' : 'Nenhuma obra com localização no mapa.', 'mp-nota'));
      return;
    }
    painel.append(el('h4', 'Obras por região'));
    const lista = el('div', undefined, 'mp-painel-lista');
    for (const grupo of agruparPorRegiao(obrasAgrupaveis(obras))) {
      const botao = el('button', undefined, 'mp-item mp-item-regiao');
      botao.type = 'button';
      botao.dataset.mpRegiao = grupo.nome;
      botao.append(
        el('strong', grupo.nome),
        el('span', `${plural(grupo.total, 'obra', 'obras')} · ${valorTexto(membrosDe(grupo))}`),
      );
      botao.addEventListener('click', () => selecionarGrupo(grupo, 13));
      lista.append(botao);
    }
    painel.append(lista);
  }

  function renderLegenda(obras: ObraVista[]): void {
    legenda.replaceChildren();
    const areas = areasPresentes(obras);
    if (areas.length === 0) {
      legenda.append(el('li', 'Nenhuma obra no mapa com estes filtros.'));
      return;
    }
    for (const area of areas) {
      const item = el('li');
      item.dataset.mpLegendaArea = area.codigo;
      const amostra = el('span', undefined, `mp-amostra ${area.serie}`);
      amostra.setAttribute('aria-hidden', 'true');
      item.append(amostra, el('span', `${area.nome} (${obras.filter((obra) => obra.area === area.codigo).length})`));
      legenda.append(item);
    }
  }

  function elementoMarcador(obra: ObraVista): HTMLElement {
    const selecionado = selecao.tipo === 'obra' && selecao.obra.id === obra.id;
    const marcador = el('div', undefined, `mp-marcador ${serieDe(obra)}${obra.precisao === 'bairro' ? ' mp-aprox' : ''}${selecionado ? ' mp-marcador-selecionado' : ''}`);
    marcador.append(elementoGlifo(glifoDaArea(obra.area)));
    return marcador;
  }

  function elementoBolha(grupo: AgrupamentoMapa): HTMLElement {
    const bolha = el('div', undefined, 'mp-bolha');
    const total = Math.max(1, grupo.total);
    const tamanho = tamanhoBolha(grupo.total);
    bolha.style.width = `${tamanho}px`;
    bolha.style.height = `${tamanho}px`;
    let inicio = 0;
    const partes: string[] = [];
    for (const serie of SERIES_COR) {
      const qtd = grupo.series[serie] ?? 0;
      if (!qtd) continue;
      const fim = inicio + (qtd / total) * 100;
      partes.push(`${VAR_COR[serie]} ${inicio}% ${fim}%`);
      inicio = fim;
    }
    bolha.style.background = partes.length ? `conic-gradient(${partes.join(', ')})` : VAR_COR['mp-cor-sem'];
    bolha.append(el('span', String(grupo.total), 'mp-bolha-miolo'));
    return bolha;
  }

  /** Nome acessível no elemento focável do Leaflet (a caixa do ícone). */
  function rotular(marcador: L.Marker, texto: string): void {
    const aplicar = (): void => { marcador.getElement()?.setAttribute('aria-label', texto); };
    marcador.on('add', aplicar);
    aplicar();
  }

  function adicionarBolha(grupo: AgrupamentoMapa, zoomSeguinte: number, posicao: L.LatLng, membros: ObraVista[]): void {
    const conteudo = elementoBolha(grupo);
    const tamanho = tamanhoBolha(grupo.total);
    const nome = grupo.nivel === 'regiao' && grupo.nome === 'Região não informada' ? 'não informada' : grupo.nome;
    const texto = `${grupo.nivel === 'regiao' ? 'Região' : 'Bairro'} ${nome}: ${plural(grupo.total, 'obra', 'obras')}; valor ${valorTexto(membros)}; ${resumoAreas(membros)}`;
    const icone = L.divIcon({ html: conteudo, className: 'mp-bolha-caixa', iconSize: [tamanho, tamanho], iconAnchor: [tamanho / 2, tamanho / 2] });
    const marcador = L.marker(posicao, { icon: icone, title: texto, riseOnHover: true })
      .on('click', () => selecionarGrupo(grupo, zoomSeguinte))
      .addTo(camada);
    rotular(marcador, texto);
    marcadoresGrupo.set(grupo.id, marcador);
  }

  function adicionarObra(obra: ObraVista, posicao: L.LatLng): void {
    const local = obra.localizacao;
    if (local.tipo === 'trechos') {
      for (const trecho of local.trechos) {
        L.polyline(trecho.linha.map((ponto): [number, number] => [ponto.lat, ponto.lng]), {
          className: `mp-trecho-linha ${serieDe(obra)}`,
          weight: 8,
          opacity: 0.9,
          interactive: false,
          dashArray: obra.precisao === 'bairro' ? '7 7' : undefined,
        }).addTo(camada);
      }
    }
    const texto = `${obra.nome} · ${nomeAreaDe(obra)}`;
    const icone = L.divIcon({ html: elementoMarcador(obra), className: 'mp-marcador-caixa', iconSize: [TAMANHO_MARCADOR, TAMANHO_MARCADOR], iconAnchor: [TAMANHO_MARCADOR / 2, TAMANHO_MARCADOR / 2] });
    const marcador = L.marker(posicao, {
      icon: icone,
      title: texto,
      riseOnHover: true,
      zIndexOffset: selecao.tipo === 'obra' && selecao.obra.id === obra.id ? 1000 : 0,
    }).on('click', () => selecionarObra(obra)).addTo(camada);
    rotular(marcador, texto);
    marcadoresObra.set(obra.id, marcador);
  }

  /** Controles sobre o mapa, em pixels da camada: bolhas e marcadores não ficam embaixo deles. */
  function obstaculosDosControles(): Obstaculo[] {
    const caixaMapa = elMapa.getBoundingClientRect();
    return [...elMapa.querySelectorAll<HTMLElement>('.mp-zoom, .mp-camadas, .mp-expandir > span, .leaflet-control-attribution')]
      .filter((controle) => controle.getClientRects().length > 0)
      .map((controle) => {
        const caixa = controle.getBoundingClientRect();
        const canto = mapa.containerPointToLayerPoint([caixa.left - caixaMapa.left, caixa.top - caixaMapa.top]);
        return { x: canto.x + caixa.width / 2, y: canto.y + caixa.height / 2, meioL: caixa.width / 2, meioA: caixa.height / 2 };
      });
  }

  let zoomDesenhado = Number.NaN;
  const marcadoresGrupo = new Map<string, L.Marker>();
  function desenharCamada(visiveis: ObraVista[]): void {
    // Redesenhar destrói os marcadores: guarda quem tinha o foco para devolvê-lo ao equivalente novo.
    let focado: { tipo: 'obra' | 'grupo'; id: string } | null = null;
    const ativo = document.activeElement;
    if (ativo && ativo !== document.body && elMapa.contains(ativo)) {
      for (const [id, marcador] of marcadoresObra) {
        const e = marcador.getElement();
        if (e && (e === ativo || e.contains(ativo))) focado = { tipo: 'obra', id };
      }
      for (const [id, marcador] of marcadoresGrupo) {
        const e = marcador.getElement();
        if (e && (e === ativo || e.contains(ativo))) focado = { tipo: 'grupo', id };
      }
    }
    try { desenharCamadaSemFoco(visiveis); } finally {
      if (focado) {
        const novo = focado.tipo === 'obra' ? marcadoresObra.get(focado.id) : marcadoresGrupo.get(focado.id);
        novo?.getElement()?.focus({ preventScroll: true });
      }
    }
  }
  function desenharCamadaSemFoco(visiveis: ObraVista[]): void {
    camada.clearLayers();
    marcadoresObra.clear();
    marcadoresGrupo.clear();
    const zoom = mapa.getZoom();
    zoomDesenhado = zoom;
    const obstaculos = obstaculosDosControles();
    if (zoom <= 14) {
      const grupos = (zoom <= 12 ? agruparPorRegiao : agruparPorBairro)(obrasAgrupaveis(visiveis));
      const alvos: Alvo[] = [];
      for (const grupo of grupos) {
        if (!grupo.centro) continue;
        const ponto = mapa.latLngToLayerPoint([grupo.centro.lat, grupo.centro.lng]);
        alvos.push({ id: grupo.id, x: ponto.x, y: ponto.y, meio: tamanhoBolha(grupo.total) / 2 });
      }
      const posicoes = posicionarSemSobrepor(alvos, obstaculos);
      const porId = new Map(visiveis.map((obra) => [obra.id, obra]));
      for (const grupo of grupos) {
        const posicao = posicoes.get(grupo.id);
        if (!posicao) continue;
        const membros = grupo.ids.map((id) => porId.get(id)).filter((obra): obra is ObraVista => !!obra);
        adicionarBolha(grupo, zoom <= 12 ? 13 : 15, mapa.layerPointToLatLng([posicao.x, posicao.y]), membros);
      }
      return;
    }
    const alvos: Alvo[] = [];
    for (const obra of visiveis) {
      const ponto = pontoDoMarcador(obra);
      if (!ponto) continue;
      const camadaPonto = mapa.latLngToLayerPoint([ponto.lat, ponto.lng]);
      alvos.push({ id: obra.id, x: camadaPonto.x, y: camadaPonto.y, meio: TAMANHO_MARCADOR / 2 });
    }
    const posicoes = posicionarSemSobrepor(alvos, obstaculos);
    for (const obra of visiveis) {
      const posicao = posicoes.get(obra.id);
      if (posicao) adicionarObra(obra, mapa.layerPointToLatLng([posicao.x, posicao.y]));
    }
  }

  function desenhar(): void {
    const visiveis = obrasFiltradas();
    const ocultas = todas.length - visiveis.length;
    // Na miniatura sem filtros do mapa, "0 ocultas" só confundiria.
    contagem.textContent = visiveis.length === 0 && todas.length > 0
      ? 'Nenhuma obra localizada com esses filtros.'
      : `${plural(todas.length, 'obra', 'obras')} no mapa${compacto && ocultas === 0 ? '' : ` · ${ocultas} ocultas pelos filtros`} · ${semLocal} sem localização`;
    corpo.replaceChildren();
    for (const obra of visiveis) {
      const linha = el('tr');
      linha.append(
        el('td', obra.nome),
        el('td', obra.orgao ?? '—'),
        el('td', nomeAreaDe(obra)),
        el('td', nomeEtapa(etapaValida(obra))),
        el('td', typeof obra.valor === 'number' && Number.isFinite(obra.valor) ? MOEDA.format(obra.valor) : '—'),
        el('td', localTexto(obra)),
      );
      corpo.append(linha);
    }
    renderLegenda(visiveis);
    desenharCamada(visiveis);
    renderPainel(visiveis);
  }

  q('[data-mp-limpar]').addEventListener('click', () => {
    etapasFiltro = null;
    areasFiltro = null;
    regiaoFiltro = '';
    montarOpcoes();
    desenhar();
    salvarURL();
  });
  q('[data-mp-centralizar]').addEventListener('click', () => {
    historico.length = 0;
    selecao = { tipo: 'cidade' };
    mapa.setView([GOIANIA.centro.lat, GOIANIA.centro.lng], 12);
    renderPainel(obrasFiltradas());
    salvarURL();
  });
  for (const b of botoesCamada) b.addEventListener('click', () => { const n = b.dataset.mpCamada; if (ehCamada(n)) { aplicarCamada(n); salvarURL(); } });
  q('[data-mp-zoom-in]').addEventListener('click', () => mapa.zoomIn());
  q('[data-mp-zoom-out]').addEventListener('click', () => mapa.zoomOut());
  // Zoom novo: redesenha tudo (bolha, bairro ou obra). Só arrastou: reposiciona as bolhas longe dos controles.
  mapa.on('moveend', () => {
    if (mapa.getZoom() !== zoomDesenhado) desenhar();
    else desenharCamada(obrasFiltradas());
    salvarURL();
  });
  mapa.on('resize', () => desenharCamada(obrasFiltradas()));
  if ('ResizeObserver' in window) new ResizeObserver(() => mapa.invalidateSize({ pan: false })).observe(elMapa);

  const apresentar = q<HTMLButtonElement>('[data-mp-apresentar]');
  if (!document.fullscreenEnabled) apresentar.hidden = true;
  apresentar.addEventListener('click', () => {
    const acao = document.fullscreenElement === raiz ? document.exitFullscreen() : raiz.requestFullscreen();
    void acao.catch(() => mostrarAviso('Não foi possível abrir o modo de apresentação neste dispositivo.'));
  });
  document.addEventListener('keydown', (evento) => {
    if (evento.key !== 'Escape') return;
    if (dialogoFicha.open) {
      evento.preventDefault();
      dialogoFicha.close();
      return;
    }
    if ([...filtros.values()].some(({ popover }) => !popover.hidden)) {
      evento.preventDefault();
      fecharFiltro(true);
      return;
    }
    if (document.fullscreenElement === raiz) {
      void document.exitFullscreen().catch(() => mostrarAviso('Não foi possível sair do modo de apresentação.'));
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const ativo = document.fullscreenElement === raiz;
    apresentar.textContent = ativo ? 'Sair da apresentação' : 'Apresentar mapa';
    apresentar.setAttribute('aria-pressed', String(ativo));
    // No Safari, o Esc em tela cheia é consumido pelo navegador (sai da tela cheia sem chegar à página): fecha a lista de filtro aberta.
    if (!ativo) fecharFiltro(raiz.contains(document.activeElement));
    if (!ativo && compacto) {
      // De volta à tela que contém a miniatura: a cidade inteira e sem os filtros locais do mapa.
      if (dialogoFicha.open) dialogoFicha.close();
      historico.length = 0;
      selecao = { tipo: 'cidade' };
      etapasFiltro = null;
      areasFiltro = null;
      regiaoFiltro = '';
      montarOpcoes();
      mapa.setView([GOIANIA.centro.lat, GOIANIA.centro.lng], 12, { animate: false });
      desenhar();
    }
    requestAnimationFrame(() => mapa.invalidateSize());
  });
  if (compacto) {
    // Miniatura estática: sem arrastar/zoom e marcadores fora da ordem do teclado; tudo volta na tela cheia.
    const interacao = (ativa: boolean): void => {
      for (const controle of [mapa.dragging, mapa.scrollWheelZoom, mapa.doubleClickZoom, mapa.touchZoom, mapa.boxZoom, mapa.keyboard]) {
        if (ativa) controle.enable(); else controle.disable();
      }
      mapa.getPane('mapPane')!.inert = !ativa;
    };
    interacao(false);
    document.addEventListener('fullscreenchange', () => interacao(document.fullscreenElement === raiz));
    const expandir = raiz.querySelector<HTMLElement>('[data-mp-expandir]');
    if (expandir) { L.DomEvent.disableClickPropagation(expandir); L.DomEvent.disableScrollPropagation(expandir); }
    expandir?.addEventListener('click', () => {
      const gestao = () => location.assign(completo);
      if (!document.fullscreenEnabled) { gestao(); return; }
      raiz.requestFullscreen().catch(gestao);
    });
    // A tela que contém o mapa pode enviar dados novos (filtros ou atualização automática) sem recriar o mapa.
    raiz.addEventListener('mp:dados', (evento) => {
      const novo = (evento as CustomEvent<Partial<Dados>>).detail;
      if (!novo || !Array.isArray(novo.obras) || !Array.isArray(novo.semLocalLista) || typeof novo.semLocal !== 'number') return;
      montarObras({ obras: novo.obras, semLocalLista: novo.semLocalLista, semLocal: novo.semLocal });
      recalcularOpcoes();
      if (areasFiltro) areasFiltro = new Set([...areasFiltro].filter((codigo) => opcoesArea.some((area) => area.codigo === codigo)));
      if (!opcoesRegiao.includes(regiaoFiltro)) regiaoFiltro = '';
      montarOpcoes();
      historico.length = 0;
      const atual = selecao.tipo === 'obra' ? todas.find((obra) => obra.id === (selecao as { obra: ObraVista }).obra.id) : undefined;
      selecao = atual ? { tipo: 'obra', obra: atual } : { tipo: 'cidade' };
      desenhar();
    });
  }

  function restaurarEstadoURL(): void {
    const parametros = new URLSearchParams(compacto ? '' : location.search);
    lerFiltrosDoEndereco(parametros);
    montarOpcoes();
    const centro = parametros.get('c')?.split(',').map(Number);
    const zoom = Number(parametros.get('z'));
    if (centro?.length === 2 && centro.every(Number.isFinite) && Math.abs(centro[0]!) <= 90 && Math.abs(centro[1]!) <= 180) {
      mapa.setView([centro[0]!, centro[1]!], Number.isFinite(zoom) && zoom >= 10 && zoom <= 18 ? zoom : mapa.getZoom(), { animate: false });
    } else if (Number.isFinite(zoom) && zoom >= 10 && zoom <= 18) {
      mapa.setZoom(zoom, { animate: false });
    }
    historico.length = 0;
    selecao = { tipo: 'cidade' };
    desenhar();
    const sel = parametros.get('sel');
    if (sel?.startsWith('obra:')) {
      const obra = todas.find((item) => item.id === sel.slice(5));
      if (obra) selecionar({ tipo: 'obra', obra }, false);
    } else if (sel?.startsWith('regiao:') || sel?.startsWith('bairro:')) {
      const nivel = sel.startsWith('regiao:') ? 'regiao' : 'bairro';
      const grupos = nivel === 'regiao'
        ? agruparPorRegiao(obrasAgrupaveis(obrasFiltradas()))
        : agruparPorBairro(obrasAgrupaveis(obrasFiltradas()));
      const grupo = grupos.find((item) => item.id === sel);
      if (grupo) selecionar({ tipo: 'grupo', grupo }, false);
    }
  }
  if (!compacto) document.addEventListener('popstate', restaurarEstadoURL);
  desenhar();
  restaurarEstadoURL();
});
</script>
