---
import '../../styles/mapa.css';
import type { ObraBasica, ObraMapa } from '../../lib/mapa/obras.ts';

interface Props {
  obras: ObraMapa[];
  semLocal: number;
  semLocalLista?: ObraBasica[];
  altura?: string;
  id?: string;
}
const { obras, semLocal, semLocalLista = [], altura = 'min(70vh, 640px)', id = 'mapa-obras' } = Astro.props;
const dados = JSON.stringify({ obras, semLocalLista, semLocal }).replaceAll('<', '\\u003c');
---
<div class="mp-secao" data-mapa-obras={id} id={id}>
  <div class="mp-cab">
    <h2 id={`${id}-titulo`}>Mapa das obras</h2>
    <a class="mp-link" href="/plataforma/projetos-localizacao/">Cadastrar localização</a>
  </div>
  <p class="mp-contagem" role="status" aria-live="polite" data-mp-contagem></p>

  <div class="mp-filtros">
    <div class="mp-filtros-linha" role="group" aria-label="Filtros do mapa">
      <div class="mp-filtro" data-mp-filtro="farol">
        <button type="button" class="mp-btn mp-filtro-abrir" data-mp-abrir aria-expanded="false" aria-controls={`${id}-filtro-farol`}>Situação: Todas ▾</button>
        <div class="mp-popover" id={`${id}-filtro-farol`} data-mp-popover hidden></div>
      </div>
      <div class="mp-filtro" data-mp-filtro="situacoes">
        <button type="button" class="mp-btn mp-filtro-abrir" data-mp-abrir aria-expanded="false" aria-controls={`${id}-filtro-situacoes`}>Etapas: Todas ▾</button>
        <div class="mp-popover" id={`${id}-filtro-situacoes`} data-mp-popover hidden></div>
      </div>
      <div class="mp-filtro" data-mp-filtro="categorias">
        <button type="button" class="mp-btn mp-filtro-abrir" data-mp-abrir aria-expanded="false" aria-controls={`${id}-filtro-categorias`}>Tipos: Todos ▾</button>
        <div class="mp-popover" id={`${id}-filtro-categorias`} data-mp-popover hidden></div>
      </div>
    </div>
    <div class="mp-acoes">
      <button type="button" class="mp-btn" data-mp-limpar>Limpar filtros</button>
      <button type="button" class="mp-btn" data-mp-centralizar>Cidade inteira</button>
      <button type="button" class="mp-btn" data-mp-apresentar>Apresentar mapa</button>
    </div>
  </div>

  <div class="mp-layout">
    <div class="mp-mapa" data-mp-mapa role="region" aria-label="Mapa das obras de Goiânia" style={`height:${altura}`}>
      <div class="mp-zoom" role="group" aria-label="Controles de zoom">
        <button type="button" data-mp-zoom-in aria-label="Aumentar zoom">+</button>
        <button type="button" data-mp-zoom-out aria-label="Diminuir zoom">−</button>
      </div>
    </div>
    <aside class="mp-painel" aria-label="Resumo do mapa" aria-live="polite" data-mp-painel></aside>
  </div>

  <ul class="mp-legenda" aria-label="Legenda da situação do prazo">
    <li><span class="mp-ponto-farol mp-farol-verde" aria-hidden="true"></span>No prazo</li>
    <li><span class="mp-ponto-farol mp-farol-amarelo" aria-hidden="true"></span>Atenção</li>
    <li><span class="mp-ponto-farol mp-farol-vermelho" aria-hidden="true"></span>Atrasada</li>
    <li><span class="mp-contorno-aprox" aria-hidden="true"></span>Contorno tracejado = local aproximado (centro do bairro)</li>
  </ul>

  <details class="mp-lista">
    <summary>Ver as obras em lista</summary>
    <div class="table-wrap">
      <table>
        <caption class="mp-nota">Obras visíveis com os filtros escolhidos</caption>
        <thead><tr><th scope="col">Obra</th><th scope="col">Órgão</th><th scope="col">Situação do prazo</th><th scope="col">Etapa</th><th scope="col">Tipo de obra</th><th scope="col">Local</th></tr></thead>
        <tbody data-mp-lista-corpo></tbody>
      </table>
    </div>
  </details>
  <dialog class="mp-dialogo-ficha" data-mp-ficha aria-labelledby={`${id}-ficha-titulo`}>
    <div class="mp-dialogo-cab">
      <button type="button" class="mp-btn" data-mp-ficha-voltar>← Voltar ao mapa</button>
      <a data-mp-ficha-pagina>Abrir em página inteira</a>
    </div>
    <div class="mp-dialogo-conteudo" data-mp-ficha-conteudo>
      <h2 id={`${id}-ficha-titulo`} data-mp-ficha-titulo>Ficha do projeto</h2>
      <p role="status" data-mp-ficha-status>Carregando…</p>
    </div>
  </dialog>
  <script is:inline type="application/json" data-mp-dados set:html={dados}></script>
</div>

<script>
import * as L from 'leaflet';
import 'leaflet/dist/leaflet.css';
import { dataBr } from '../../lib/datas.ts';
import { GOIANIA, ROTULO_CATEGORIA, ROTULO_SITUACAO_MAPA, espalharSobrepostos, type SituacaoMapa } from '../../lib/mapa/geo.ts';
import { agruparPorBairro, agruparPorRegiao, type AgrupamentoMapa, type CorFarol, type ObraAgrupavel } from '../../lib/mapa/agrupar.ts';
import { elementoGlifo } from '../../lib/mapa/icones.ts';
import type { ObraBasica, ObraMapa } from '../../lib/mapa/obras.ts';
import { lerLocalizacoesSimuladas } from '../../lib/mapa/simulacao.ts';
import type { CategoriaObra, Localizacao, PontoGeo } from '../../lib/mapa/tipos.ts';

type ObraVista = ObraMapa & { simulada?: boolean };
type SemLocalVista = ObraBasica;
interface Dados { obras: ObraVista[]; semLocalLista: SemLocalVista[]; semLocal: number }
type FarolFiltro = CorFarol | 'todas';
type Selecao =
  | { tipo: 'cidade' }
  | { tipo: 'grupo'; grupo: AgrupamentoMapa }
  | { tipo: 'obra'; obra: ObraVista };

const SITUACOES = Object.keys(ROTULO_SITUACAO_MAPA) as SituacaoMapa[];
const CATEGORIAS = Object.keys(ROTULO_CATEGORIA) as CategoriaObra[];
const FAROIS: { valor: FarolFiltro; texto: string }[] = [
  { valor: 'todas', texto: 'Todas' },
  { valor: 'verde', texto: 'No prazo' },
  { valor: 'amarelo', texto: 'Atenção' },
  { valor: 'vermelho', texto: 'Atrasadas' },
];
const CORES_FAROL: Record<CorFarol, string> = { verde: '#238636', amarelo: '#b76e00', vermelho: '#c62828' };
const ROTULO_FAROL: Record<CorFarol, string> = { verde: 'No prazo', amarelo: 'Atenção', vermelho: 'Atrasada' };
const MOEDA = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
const tamanhoBolha = (total: number): number => Math.min(88, 52 + Math.sqrt(total) * 5);

function el<K extends keyof HTMLElementTagNameMap>(tag: K, texto?: string, classe?: string): HTMLElementTagNameMap[K] {
  const e = document.createElement(tag);
  if (texto !== undefined) e.textContent = texto;
  if (classe) e.className = classe;
  return e;
}

function pontosDaLocalizacao(localizacao: Localizacao): PontoGeo[] {
  return localizacao.tipo === 'ponto'
    ? [localizacao.ponto]
    : localizacao.trechos.flatMap((trecho) => trecho.linha);
}

function localTexto(o: ObraVista): string {
  const local = o.localizacao;
  if (o.precisao === 'bairro') return `Aproximado: centro do bairro ${o.bairro ?? ''}`.trim();
  if (local.tipo === 'ponto') return local.endereco ? `Ponto: ${local.endereco}` : 'Ponto marcado no mapa';
  return `${local.trechos.length} ${local.trechos.length === 1 ? 'trecho' : 'trechos'}: ${local.trechos.map((trecho) => trecho.rua).join(', ')}`;
}

function valorTexto(obras: ObraBasica[]): string {
  const conhecidos = obras.filter((obra) => obra.valor !== null);
  if (conhecidos.length === 0) return `— (0 de ${obras.length} com valor)`;
  const total = conhecidos.reduce((soma, obra) => soma + (obra.valor ?? 0), 0);
  return `${MOEDA.format(total)} (${conhecidos.length} de ${obras.length} com valor)`;
}

function contagemFarol(obras: ObraBasica[]): Record<CorFarol, number> {
  const contagem: Record<CorFarol, number> = { verde: 0, amarelo: 0, vermelho: 0 };
  for (const obra of obras) contagem[obra.farol.cor]++;
  return contagem;
}

document.addEventListener('astro:page-load', () => {
  const raiz = document.querySelector<HTMLElement>('[data-mapa-obras]');
  if (!raiz || raiz.dataset.pronto) return;
  raiz.dataset.pronto = 'sim';
  let dados: Dados;
  try {
    const bruto = JSON.parse(raiz.querySelector('[data-mp-dados]')?.textContent || '') as Partial<Dados>;
    if (!Array.isArray(bruto.obras) || !Array.isArray(bruto.semLocalLista) || typeof bruto.semLocal !== 'number') {
      throw new Error('Estrutura de dados incompleta.');
    }
    dados = { obras: bruto.obras, semLocalLista: bruto.semLocalLista, semLocal: bruto.semLocal };
  } catch (erro) {
    const mensagem = el('p', 'Não foi possível carregar os dados do mapa.', 'mp-aviso');
    mensagem.setAttribute('role', 'alert');
    raiz.append(mensagem);
    console.error('Falha ao carregar dados do mapa.', erro);
    return;
  }
  const q = <T extends HTMLElement>(seletor: string) => raiz.querySelector<T>(seletor)!;

  const simuladas = lerLocalizacoesSimuladas();
  const todas: ObraVista[] = dados.obras.map((obra) => (
    simuladas[obra.id] ? { ...obra, localizacao: simuladas[obra.id], precisao: 'cadastrada', simulada: true } : obra
  ));
  let semLocal = dados.semLocal;
  for (const obra of dados.semLocalLista) {
    if (simuladas[obra.id]) {
      todas.push({ ...obra, localizacao: simuladas[obra.id], precisao: 'cadastrada', simulada: true });
      semLocal--;
    }
  }
  semLocal = Math.max(0, semLocal);

  const parametrosIniciais = new URLSearchParams(location.search);
  const lerConjunto = <T extends string>(chave: string, valores: T[]): Set<T> => {
    const valor = parametrosIniciais.get(chave);
    return valor === null ? new Set(valores) : new Set(valor.split(',').filter((item): item is T => valores.includes(item as T)));
  };
  const situacoes = lerConjunto('etapas', SITUACOES);
  const categorias = lerConjunto('tipos', CATEGORIAS);
  const farolInicial: Record<string, FarolFiltro> = { todas: 'todas', noprazo: 'verde', atencao: 'amarelo', atrasadas: 'vermelho' };
  let farolFiltro = farolInicial[parametrosIniciais.get('sit') ?? 'todas'] ?? 'todas';
  const centroInicial = parametrosIniciais.get('c')?.split(',').map(Number);
  const zoomInicial = Number(parametrosIniciais.get('z'));
  const centroValido = centroInicial?.length === 2 && centroInicial.every(Number.isFinite)
    && Math.abs(centroInicial[0]!) <= 90 && Math.abs(centroInicial[1]!) <= 180;
  const zoomValido = Number.isFinite(zoomInicial) && zoomInicial >= 10 && zoomInicial <= 18;
  let selecao: Selecao = { tipo: 'cidade' };
  const historico: Selecao[] = [];
  const mapa = L.map(q('[data-mp-mapa]'), {
    zoomControl: false,
    tap: true,
    minZoom: 10,
    maxZoom: 18,
    zoomAnimation: !matchMedia('(prefers-reduced-motion: reduce)').matches,
    fadeAnimation: !matchMedia('(prefers-reduced-motion: reduce)').matches,
    markerZoomAnimation: !matchMedia('(prefers-reduced-motion: reduce)').matches,
  }).setView(
    centroValido ? [centroInicial[0]!, centroInicial[1]!] : [GOIANIA.centro.lat, GOIANIA.centro.lng],
    zoomValido ? zoomInicial : 12,
  );
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© colaboradores do OpenStreetMap',
    maxZoom: 18,
  }).addTo(mapa);
  const camada = L.layerGroup().addTo(mapa);
  const marcadoresObra = new Map<string, L.Marker>();
  const contagem = q('[data-mp-contagem]');
  const corpo = q('[data-mp-lista-corpo]');
  const painel = q('[data-mp-painel]');
  const aviso = el('p', undefined, 'mp-aviso');
  aviso.setAttribute('role', 'status');
  aviso.hidden = true;
  painel.after(aviso);

  function mostrarAviso(texto: string): void {
    aviso.textContent = texto;
    aviso.hidden = false;
  }

  function atualizarMarcadoresSelecionados(): void {
    const obraSelecionada = selecao.tipo === 'obra' ? selecao.obra.id : null;
    for (const [id, marcador] of marcadoresObra) {
      const selecionado = id === obraSelecionada;
      marcador.getElement()?.querySelector('.mp-marcador')?.classList.toggle('mp-marcador-selecionado', selecionado);
      marcador.setZIndexOffset(selecionado ? 1000 : 0);
    }
  }

  type TipoFiltro = 'farol' | 'situacoes' | 'categorias';
  const filtros = new Map<TipoFiltro, { trigger: HTMLButtonElement; popover: HTMLDivElement }>();
  const fecharFiltro = (restaurarFoco = false): void => {
    for (const { trigger, popover } of filtros.values()) {
      if (popover.hidden) continue;
      popover.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restaurarFoco) trigger.focus();
    }
  };
  const salvarURL = (): void => {
    const url = new URL(location.href);
    if (farolFiltro === 'todas') url.searchParams.delete('sit');
    else url.searchParams.set('sit', farolFiltro === 'verde' ? 'noprazo' : farolFiltro === 'amarelo' ? 'atencao' : 'atrasadas');
    if (situacoes.size === SITUACOES.length) url.searchParams.delete('etapas');
    else url.searchParams.set('etapas', SITUACOES.filter((item) => situacoes.has(item)).join(','));
    if (categorias.size === CATEGORIAS.length) url.searchParams.delete('tipos');
    else url.searchParams.set('tipos', CATEGORIAS.filter((item) => categorias.has(item)).join(','));
    url.searchParams.set('z', String(mapa.getZoom()));
    const centro = mapa.getCenter();
    url.searchParams.set('c', `${centro.lat.toFixed(5)},${centro.lng.toFixed(5)}`);
    const selecionado = selecao.tipo === 'obra' ? `obra:${selecao.obra.id}` : selecao.tipo === 'grupo' ? selecao.grupo.id : null;
    if (selecionado) url.searchParams.set('sel', selecionado);
    else url.searchParams.delete('sel');
    history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
  };
  const tituloFarol = (valor: FarolFiltro): string => FAROIS.find((item) => item.valor === valor)!.texto;
  const atualizarResumo = (): void => {
    const atualizar = (tipo: TipoFiltro, texto: string): void => {
      const entrada = filtros.get(tipo);
      if (entrada) entrada.trigger.textContent = `${texto} ▾`;
    };
    atualizar('farol', `Situação: ${farolFiltro === 'todas' ? 'Todas' : tituloFarol(farolFiltro)}`);
    atualizar('situacoes', `Etapas: ${situacoes.size === SITUACOES.length ? 'Todas' : `${situacoes.size} de ${SITUACOES.length}`}`);
    atualizar('categorias', `Tipos: ${categorias.size === CATEGORIAS.length ? 'Todos' : `${categorias.size} de ${CATEGORIAS.length}`}`);
  };
  const criarOpcao = (
    popover: HTMLElement,
    nomeGrupo: string,
    valor: string,
    rotulo: string,
    tipo: 'checkbox' | 'radio',
    marcado: boolean,
    aoMudar: (marcado: boolean) => void,
  ): HTMLInputElement => {
    const rotuloEl = el('label', undefined, 'mp-opcao-filtro');
    const input = el('input');
    input.type = tipo;
    input.name = nomeGrupo;
    input.value = valor;
    input.checked = marcado;
    input.addEventListener('change', () => aoMudar(input.checked));
    rotuloEl.append(input, el('span', rotulo));
    popover.append(rotuloEl);
    return input;
  };
  const adicionarFiltro = (tipo: TipoFiltro, titulo: string): { trigger: HTMLButtonElement; popover: HTMLDivElement; opcoes: HTMLDivElement } => {
    const raizFiltro = q<HTMLElement>(`[data-mp-filtro="${tipo}"]`);
    const trigger = raizFiltro.querySelector<HTMLButtonElement>('[data-mp-abrir]')!;
    const popover = raizFiltro.querySelector<HTMLDivElement>('[data-mp-popover]')!;
    const opcoes = el('div', undefined, 'mp-opcoes');
    opcoes.setAttribute('role', 'group');
    opcoes.setAttribute('aria-label', titulo);
    popover.append(opcoes);
    filtros.set(tipo, { trigger, popover });
    trigger.addEventListener('click', () => {
      const estavaAberto = !popover.hidden;
      fecharFiltro();
      if (!estavaAberto) {
        popover.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        popover.querySelector<HTMLElement>('input,button')?.focus();
      }
    });
    popover.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Tab') return;
      const focaveis = [...popover.querySelectorAll<HTMLElement>('input:not(:disabled),button:not(:disabled)')];
      const primeiro = focaveis[0];
      const ultimo = focaveis.at(-1);
      if (evento.shiftKey && document.activeElement === primeiro) {
        evento.preventDefault();
        ultimo?.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primeiro?.focus();
      }
    });
    const rodape = el('div', undefined, 'mp-popover-acoes');
    if (tipo !== 'farol') {
      const marcar = el('button', 'Marcar todos', 'mp-btn');
      const desmarcar = el('button', 'Desmarcar todos', 'mp-btn');
      marcar.type = desmarcar.type = 'button';
      marcar.dataset.mpMarcar = 'todos';
      desmarcar.dataset.mpMarcar = 'nenhum';
      rodape.append(marcar, desmarcar);
    }
    const pronto = el('button', 'Pronto', 'mp-btn');
    pronto.type = 'button';
    pronto.dataset.mpPronto = '';
    pronto.addEventListener('click', () => fecharFiltro(true));
    rodape.append(pronto);
    popover.append(rodape);
    return { trigger, popover, opcoes };
  };
  const filtroFarol = adicionarFiltro('farol', 'Situação do prazo');
  for (const filtro of FAROIS) {
    criarOpcao(filtroFarol.opcoes, `${raiz.id}-farol`, filtro.valor, filtro.texto, 'radio', filtro.valor === farolFiltro, () => {
      farolFiltro = filtro.valor;
      filtroFarol.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = input.value === farolFiltro; });
      atualizarResumo();
      salvarURL();
      desenhar();
    });
  }
  const filtroSituacao = adicionarFiltro('situacoes', 'Etapas');
  for (const situacao of SITUACOES) {
    criarOpcao(filtroSituacao.opcoes, `${raiz.id}-etapas`, situacao, ROTULO_SITUACAO_MAPA[situacao], 'checkbox', situacoes.has(situacao), (ligado) => {
      if (ligado) situacoes.add(situacao);
      else situacoes.delete(situacao);
      atualizarResumo();
      salvarURL();
      desenhar();
    });
  }
  const filtroCategoria = adicionarFiltro('categorias', 'Tipos de obra');
  for (const categoria of CATEGORIAS) {
    criarOpcao(filtroCategoria.opcoes, `${raiz.id}-tipos`, categoria, ROTULO_CATEGORIA[categoria], 'checkbox', categorias.has(categoria), (ligado) => {
      if (ligado) categorias.add(categoria);
      else categorias.delete(categoria);
      atualizarResumo();
      salvarURL();
      desenhar();
    });
  }
  const configurarAcoesMultiplas = <T extends SituacaoMapa | CategoriaObra>(
    conjunto: Set<T>,
    valores: T[],
    filtro: { popover: HTMLDivElement; opcoes: HTMLDivElement },
  ): void => {
    filtro.popover.querySelector('[data-mp-marcar="todos"]')?.addEventListener('click', () => {
      conjunto.clear();
      valores.forEach((valor) => conjunto.add(valor));
      filtro.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = true; });
      atualizarResumo();
      salvarURL();
      desenhar();
    });
    filtro.popover.querySelector('[data-mp-marcar="nenhum"]')?.addEventListener('click', () => {
      conjunto.clear();
      filtro.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = false; });
      atualizarResumo();
      salvarURL();
      desenhar();
    });
  };
  configurarAcoesMultiplas(situacoes, SITUACOES, filtroSituacao);
  configurarAcoesMultiplas(categorias, CATEGORIAS, filtroCategoria);
  atualizarResumo();
  document.addEventListener('pointerdown', (evento) => {
    if (!(evento.target instanceof Element) || !raiz.contains(evento.target) || !evento.target.closest('[data-mp-filtro]')) fecharFiltro();
  });

  function obrasFiltradas(): ObraVista[] {
    return todas.filter((obra) =>
      situacoes.has(obra.situacao) &&
      categorias.has(obra.categoria) &&
      (farolFiltro === 'todas' || obra.farol.cor === farolFiltro),
    );
  }

  function obrasAgrupaveis(obras: ObraVista[]): ObraAgrupavel[] {
    return obras.map((obra) => ({
      id: obra.id,
      regiao: obra.regiao,
      bairro: obra.bairro,
      farol: obra.farol.cor,
      pontos: pontosDaLocalizacao(obra.localizacao),
    }));
  }

  function selecionar(nova: Selecao, voltar = true): void {
    if (voltar) historico.push(selecao);
    selecao = nova;
    atualizarMarcadoresSelecionados();
    renderPainel(obrasFiltradas());
    salvarURL();
  }

  function selecionarGrupo(grupo: AgrupamentoMapa, zoom: number): void {
    if (!grupo.centro) return;
    selecionar({ tipo: 'grupo', grupo });
    mapa.setView([grupo.centro.lat, grupo.centro.lng], zoom);
  }

  function selecionarObra(obra: ObraVista): void {
    const local = obra.localizacao;
    const ponto = local.tipo === 'ponto'
      ? local.ponto
      : local.trechos[0]?.linha[0];
    selecionar({ tipo: 'obra', obra });
    if (ponto) mapa.setView([ponto.lat, ponto.lng], Math.max(15, mapa.getZoom()));
  }

  function botaoObra(obra: ObraVista, texto = obra.nome): HTMLButtonElement {
    const botao = el('button', undefined, 'mp-item');
    const nome = el('strong', texto);
    const detalhe = el('span', `${obra.orgao ?? 'Sem órgão'} · ${ROTULO_SITUACAO_MAPA[obra.situacao]}`);
    const prazo = el('span', `${ROTULO_FAROL[obra.farol.cor]} · ${obra.farol.texto}`, `mp-texto-farol mp-texto-${obra.farol.cor}`);
    botao.append(nome, detalhe, prazo);
    botao.type = 'button';
    botao.addEventListener('click', () => selecionarObra(obra));
    return botao;
  }

  const dialogoFicha = q<HTMLDialogElement>('[data-mp-ficha]');
  const conteudoFicha = q<HTMLElement>('[data-mp-ficha-conteudo]');
  const tituloFicha = q<HTMLElement>('[data-mp-ficha-titulo]');
  const statusFicha = q<HTMLElement>('[data-mp-ficha-status]');
  const linkFichaPagina = q<HTMLAnchorElement>('[data-mp-ficha-pagina]');
  let linkFichaAtivo: HTMLAnchorElement | null = null;
  const voltarFicha = q<HTMLButtonElement>('[data-mp-ficha-voltar]');
  voltarFicha.addEventListener('click', () => dialogoFicha.close());
  dialogoFicha.addEventListener('close', () => {
    linkFichaAtivo?.focus();
    linkFichaAtivo = null;
  });
  async function abrirFicha(obra: ObraVista, link: HTMLAnchorElement): Promise<void> {
    linkFichaAtivo = link;
    tituloFicha.textContent = obra.nome;
    statusFicha.hidden = false;
    statusFicha.textContent = 'Carregando…';
    const urlCompleta = new URL(link.href);
    urlCompleta.searchParams.set('volta', `${location.pathname}${location.search}${location.hash}`);
    linkFichaPagina.href = urlCompleta.href;
    conteudoFicha.querySelectorAll(':scope > :not([data-mp-ficha-titulo]):not([data-mp-ficha-status])').forEach((item) => item.remove());
    if (!dialogoFicha.open) dialogoFicha.showModal();
    try {
      const resposta = await fetch(link.href, { headers: { Accept: 'text/html' } });
      if (!resposta.ok) throw new Error(`Resposta ${resposta.status}`);
      const documento = new DOMParser().parseFromString(await resposta.text(), 'text/html');
      const workspace = documento.querySelector<HTMLElement>('.workspace');
      if (!workspace) throw new Error('Conteúdo da ficha não encontrado.');
      documento.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"][href]').forEach((link) => {
        const href = new URL(link.getAttribute('href')!, resposta.url).href;
        const jaCarregado = [...document.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"][href]')]
          .some((atual) => new URL(atual.getAttribute('href')!, location.href).href === href);
        if (!jaCarregado) {
          const copia = document.importNode(link, true);
          copia.href = href;
          document.head.append(copia);
        }
      });
      documento.head.querySelectorAll('style').forEach((style) => {
        const conteudo = style.textContent?.trim();
        if (!conteudo || [...document.head.querySelectorAll('style')].some((atual) => atual.textContent?.trim() === conteudo)) return;
        document.head.append(document.importNode(style, true));
      });
      workspace.querySelectorAll('.pj-contexto, .pj-titulo, .notice').forEach((item) => item.remove());
      workspace.querySelectorAll('script').forEach((script) => script.remove());
      const fragmento = document.createDocumentFragment();
      workspace.childNodes.forEach((no) => fragmento.append(document.importNode(no, true)));
      conteudoFicha.append(fragmento);
      statusFicha.hidden = true;
      voltarFicha.focus();
    } catch (erro) {
      statusFicha.textContent = 'Não foi possível carregar a ficha agora. Tente novamente ou abra em página inteira.';
      console.error('Falha ao carregar a ficha do projeto pelo mapa.', erro);
    }
  }

  function renderPainel(obras: ObraVista[]): void {
    painel.replaceChildren();
    const cabecalho = el('div', undefined, 'mp-painel-cab');
    const titulo = el('h3');
    const acoes = el('div', undefined, 'mp-painel-acoes');
    if (selecao.tipo !== 'cidade') {
      const voltar = el('button', 'Voltar', 'mp-btn mp-btn-voltar');
      voltar.type = 'button';
      voltar.addEventListener('click', () => {
        const anterior: Selecao = historico.pop() ?? { tipo: 'cidade' };
        selecao = anterior;
        atualizarMarcadoresSelecionados();
        if (anterior.tipo === 'cidade') mapa.setView([GOIANIA.centro.lat, GOIANIA.centro.lng], 12);
        else if (anterior.tipo === 'grupo' && anterior.grupo.centro) {
          mapa.setView(
            [anterior.grupo.centro.lat, anterior.grupo.centro.lng],
            anterior.grupo.nivel === 'regiao' ? 13 : 15,
          );
        }
        renderPainel(obrasFiltradas());
        salvarURL();
      });
      acoes.append(voltar);
    }
    if (selecao.tipo === 'obra') {
      const obra = selecao.obra;
      titulo.textContent = obra.nome;
      cabecalho.append(titulo, acoes);
      painel.append(cabecalho);
      if (obra.simulada) painel.append(el('span', 'Simulação', 'mp-selo'));
      painel.append(
        el('p', obra.orgao ?? 'Sem órgão'),
        el('p', `Etapa: ${ROTULO_SITUACAO_MAPA[obra.situacao]}`),
        el('p', `Valor: ${obra.valor === null ? '—' : MOEDA.format(obra.valor)}`),
      );
      if (obra.percentual !== null) painel.append(el('p', `Executado: ${Math.round(obra.percentual)}%`));
      painel.append(el('p', `Prazo da etapa: ${obra.prazo ? dataBr(obra.prazo) : '—'}`));
      painel.append(el('p', `${ROTULO_FAROL[obra.farol.cor]} · ${obra.farol.texto}`, `mp-texto-farol mp-texto-${obra.farol.cor}`));
      if (obra.foto) {
        const foto = el('img');
        foto.src = obra.foto;
        foto.alt = `Foto da obra: ${obra.nome}`;
        foto.loading = 'lazy';
        painel.append(foto);
      }
      if (obra.precisao === 'bairro') painel.append(el('p', `Local aproximado (centro do bairro ${obra.bairro ?? ''})`, 'mp-aviso-local'));
      const links = el('div', undefined, 'mp-painel-links');
      const ficha = el('a', 'Abrir ficha completa');
      ficha.href = `/plataforma/projeto/${encodeURIComponent(obra.id)}/`;
      ficha.addEventListener('click', (evento) => {
        evento.preventDefault();
        void abrirFicha(obra, ficha);
      });
      const editar = el('a', 'Editar localização');
      editar.href = `/plataforma/projetos-localizacao/?id=${encodeURIComponent(obra.id)}`;
      links.append(ficha, editar);
      painel.append(links);
      return;
    }

    const gruposRegiao = agruparPorRegiao(obrasAgrupaveis(obras));
    if (selecao.tipo === 'grupo') {
      const grupo = selecao.grupo;
      const membros = obras.filter((obra) => grupo.ids.includes(obra.id));
      titulo.textContent = grupo.nome;
      cabecalho.append(titulo, acoes);
      painel.append(cabecalho, el('p', `${membros.length} ${membros.length === 1 ? 'obra' : 'obras'}`));
      painel.append(el('p', `Valor: ${valorTexto(membros)}`));
      const contagens = contagemFarol(membros);
      painel.append(el('p', `No prazo: ${contagens.verde} · Atenção: ${contagens.amarelo} · Atrasadas: ${contagens.vermelho}`));
      const lista = el('div', undefined, 'mp-painel-lista');
      for (const obra of membros) lista.append(botaoObra(obra));
      painel.append(lista);
      return;
    }

    titulo.textContent = 'Goiânia';
    cabecalho.append(titulo, acoes);
    painel.append(cabecalho, el('p', `${obras.length} ${obras.length === 1 ? 'obra no mapa' : 'obras no mapa'}`));
    painel.append(el('p', `Valor: ${valorTexto(obras)}`));
    const contagens = contagemFarol(obras);
    painel.append(el('p', `No prazo: ${contagens.verde} · Atenção: ${contagens.amarelo} · Atrasadas: ${contagens.vermelho}`));
    const regiaoTitulo = el('h4', 'Obras por região');
    painel.append(regiaoTitulo);
    const lista = el('div', undefined, 'mp-painel-lista');
    for (const grupo of gruposRegiao) {
      const botao = el('button', undefined, 'mp-item mp-item-regiao');
      botao.type = 'button';
      botao.append(
        el('strong', grupo.nome),
        el('span', `${grupo.total} ${grupo.total === 1 ? 'obra' : 'obras'} · No prazo: ${grupo.farois.verde}, Atenção: ${grupo.farois.amarelo}, Atrasadas: ${grupo.farois.vermelho}`),
      );
      botao.addEventListener('click', () => selecionarGrupo(grupo, 13));
      lista.append(botao);
    }
    painel.append(lista);
  }

  function elementoMarcador(obra: ObraVista): HTMLElement {
    const selecionado = selecao.tipo === 'obra' && selecao.obra.id === obra.id;
    const marcador = el('div', undefined, `mp-marcador mp-farol-${obra.farol.cor}${obra.precisao === 'bairro' ? ' mp-aprox' : ''}${selecionado ? ' mp-marcador-selecionado' : ''}`);
    marcador.title = `${obra.nome} · ${ROTULO_FAROL[obra.farol.cor]}`;
    marcador.setAttribute('aria-label', marcador.title);
    marcador.append(elementoGlifo(obra.categoria));
    return marcador;
  }

  function elementoBolha(grupo: AgrupamentoMapa): HTMLElement {
    const bolha = el('div', undefined, 'mp-bolha');
    const nome = grupo.nivel === 'regiao' && grupo.nome === 'Região não informada' ? 'não informada' : grupo.nome;
    const rotuloGrupo = grupo.nivel === 'regiao' ? 'Região' : 'Bairro';
    const total = Math.max(1, grupo.total);
    const pctVerde = (grupo.farois.verde / total) * 100;
    const pctAmarelo = (grupo.farois.amarelo / total) * 100;
    const tamanho = tamanhoBolha(grupo.total);
    bolha.style.width = `${tamanho}px`;
    bolha.style.height = `${tamanho}px`;
    bolha.style.background = `conic-gradient(${CORES_FAROL.verde} 0 ${pctVerde}%, ${CORES_FAROL.amarelo} ${pctVerde}% ${pctVerde + pctAmarelo}%, ${CORES_FAROL.vermelho} ${pctVerde + pctAmarelo}% 100%)`;
    bolha.setAttribute('aria-label', `${rotuloGrupo} ${nome}, ${grupo.total} obras; No prazo: ${grupo.farois.verde}, Atenção: ${grupo.farois.amarelo}, Atrasadas: ${grupo.farois.vermelho}`);
    bolha.title = bolha.getAttribute('aria-label')!;
    bolha.append(el('span', String(grupo.total), 'mp-bolha-miolo'));
    return bolha;
  }

  function adicionarBolha(grupo: AgrupamentoMapa, zoomSeguinte: number, centroVisivel?: PontoGeo): void {
    if (!grupo.centro) return;
    const conteudo = elementoBolha(grupo);
    const tamanho = Number.parseFloat(conteudo.style.width);
    const icone = L.divIcon({ html: conteudo, className: 'mp-bolha-caixa', iconSize: [tamanho, tamanho], iconAnchor: [tamanho / 2, tamanho / 2] });
    const posicao = centroVisivel ?? grupo.centro;
    L.marker([posicao.lat, posicao.lng], { icon: icone, title: conteudo.title, alt: conteudo.title, riseOnHover: true })
      .on('click', () => selecionarGrupo(grupo, zoomSeguinte))
      .addTo(camada);
  }

  function adicionarBolhas(grupos: AgrupamentoMapa[], zoomSeguinte: number): void {
    const conjuntos: { centro: L.Point; grupos: AgrupamentoMapa[] }[] = [];
    for (const grupo of grupos) {
      if (!grupo.centro) continue;
      const ponto = mapa.latLngToLayerPoint([grupo.centro.lat, grupo.centro.lng]);
      const conjunto = conjuntos.find((item) => ponto.distanceTo(item.centro) < 72);
      if (conjunto) conjunto.grupos.push(grupo);
      else conjuntos.push({ centro: ponto, grupos: [grupo] });
    }
    for (const conjunto of conjuntos) {
      const { grupos: itens } = conjunto;
      itens.forEach((grupo, indice) => {
        if (itens.length === 1) {
          adicionarBolha(grupo, zoomSeguinte);
          return;
        }
        const diametro = Math.max(...itens.map((item) => tamanhoBolha(item.total)));
        const raio = Math.max(56, (diametro + 8) / (2 * Math.sin(Math.PI / itens.length)));
        const angulo = (2 * Math.PI * indice) / itens.length;
        // Afasta visualmente centros coincidentes; selecionar ainda leva ao centro médio original.
        const ponto = conjunto.centro.add(L.point(Math.cos(angulo) * raio, Math.sin(angulo) * raio));
        const centroVisivel = mapa.layerPointToLatLng(ponto);
        adicionarBolha(grupo, zoomSeguinte, centroVisivel);
      });
    }
  }

  function adicionarObra(obra: ObraVista, pontosEspalhados: Map<string, PontoGeo>): void {
    const local = obra.localizacao;
    if (local.tipo === 'ponto') {
      const ponto = pontosEspalhados.get(obra.id) ?? local.ponto;
      const icone = L.divIcon({ html: elementoMarcador(obra), className: 'mp-marcador-caixa', iconSize: [44, 44], iconAnchor: [22, 22] });
      const marcador = L.marker([ponto.lat, ponto.lng], {
        icon: icone,
        title: obra.nome,
        alt: `${obra.nome} · ${ROTULO_FAROL[obra.farol.cor]}`,
        riseOnHover: true,
        zIndexOffset: selecao.tipo === 'obra' && selecao.obra.id === obra.id ? 1000 : 0,
      }).on('click', () => selecionarObra(obra)).addTo(camada);
      marcadoresObra.set(obra.id, marcador);
      return;
    }
    for (const trecho of local.trechos) {
      const linha = L.polyline(trecho.linha.map((ponto): [number, number] => [ponto.lat, ponto.lng]), {
        color: CORES_FAROL[obra.farol.cor],
        weight: 8,
        opacity: 0.9,
        dashArray: obra.precisao === 'bairro' ? '7 7' : undefined,
      }).addTo(camada);
      linha.on('click', () => selecionarObra(obra));
      const tornarAcessivel = () => {
        const path = linha.getElement();
        if (!path) return;
        path.setAttribute('tabindex', '0');
        path.setAttribute('role', 'button');
        path.setAttribute('aria-label', `${obra.nome} · ${ROTULO_FAROL[obra.farol.cor]}`);
        path.addEventListener('keydown', (evento: Event) => {
          if (evento instanceof KeyboardEvent && (evento.key === 'Enter' || evento.key === ' ')) {
            evento.preventDefault();
            selecionarObra(obra);
          }
        });
      };
      linha.on('add', tornarAcessivel);
      tornarAcessivel();
    }
  }

  function desenhar(): void {
    const visiveis = obrasFiltradas();
    contagem.textContent = `${todas.length} ${todas.length === 1 ? 'obra' : 'obras'} no mapa · ${todas.length - visiveis.length} ocultas pelos filtros · ${semLocal} sem localização`;
    corpo.replaceChildren();
    for (const obra of visiveis) {
      const linha = el('tr');
      linha.append(
        el('td', obra.nome),
        el('td', obra.orgao ?? '—'),
        el('td', `${ROTULO_FAROL[obra.farol.cor]} · ${obra.farol.texto}`),
        el('td', ROTULO_SITUACAO_MAPA[obra.situacao]),
        el('td', ROTULO_CATEGORIA[obra.categoria]),
        el('td', localTexto(obra)),
      );
      corpo.append(linha);
    }
    camada.clearLayers();
    marcadoresObra.clear();
    const zoom = mapa.getZoom();
    if (zoom <= 12) {
      adicionarBolhas(agruparPorRegiao(obrasAgrupaveis(visiveis)), 13);
    } else if (zoom <= 14) {
      adicionarBolhas(agruparPorBairro(obrasAgrupaveis(visiveis)), 15);
    } else {
      const pontos = visiveis
        .filter((obra) => obra.localizacao.tipo === 'ponto')
        .map((obra) => ({
          id: obra.id,
          ponto: obra.localizacao.tipo === 'ponto' ? obra.localizacao.ponto : GOIANIA.centro,
        }));
      const espalhados = espalharSobrepostos(pontos);
      for (const obra of visiveis) adicionarObra(obra, espalhados);
    }
    renderPainel(visiveis);
  }

  q('[data-mp-limpar]').addEventListener('click', () => {
    situacoes.clear();
    SITUACOES.forEach((situacao) => situacoes.add(situacao));
    categorias.clear();
    CATEGORIAS.forEach((categoria) => categorias.add(categoria));
    farolFiltro = 'todas';
    filtroSituacao.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = true; });
    filtroCategoria.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = true; });
    filtroFarol.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = input.value === 'todas'; });
    atualizarResumo();
    desenhar();
    salvarURL();
  });
  q('[data-mp-centralizar]').addEventListener('click', () => {
    historico.length = 0;
    selecao = { tipo: 'cidade' };
    mapa.setView([GOIANIA.centro.lat, GOIANIA.centro.lng], 12);
    renderPainel(obrasFiltradas());
    salvarURL();
  });
  q('[data-mp-zoom-in]').addEventListener('click', () => mapa.zoomIn());
  q('[data-mp-zoom-out]').addEventListener('click', () => mapa.zoomOut());
  mapa.on('zoomend', desenhar);
  mapa.on('moveend', salvarURL);

  const apresentar = q<HTMLButtonElement>('[data-mp-apresentar]');
  if (!document.fullscreenEnabled) apresentar.hidden = true;
  apresentar.addEventListener('click', () => {
    const acao = document.fullscreenElement === raiz ? document.exitFullscreen() : raiz.requestFullscreen();
    void acao.catch(() => mostrarAviso('Não foi possível abrir o modo de apresentação neste dispositivo.'));
  });
  document.addEventListener('keydown', (evento) => {
    if (evento.key !== 'Escape') return;
    if (dialogoFicha.open) {
      evento.preventDefault();
      dialogoFicha.close();
      return;
    }
    if ([...filtros.values()].some(({ popover }) => !popover.hidden)) {
      evento.preventDefault();
      fecharFiltro(true);
      return;
    }
    if (document.fullscreenElement === raiz) {
      void document.exitFullscreen().catch(() => mostrarAviso('Não foi possível sair do modo de apresentação.'));
    }
  });
  document.addEventListener('fullscreenchange', () => {
    const ativo = document.fullscreenElement === raiz;
    apresentar.textContent = ativo ? 'Sair da apresentação' : 'Apresentar mapa';
    apresentar.setAttribute('aria-pressed', String(ativo));
    requestAnimationFrame(() => mapa.invalidateSize());
  });

  function restaurarEstadoURL(): void {
    const parametros = new URLSearchParams(location.search);
    const restaurarConjunto = <T extends string>(alvo: Set<T>, chave: string, valores: T[]): void => {
      const parametro = parametros.get(chave);
      alvo.clear();
      (parametro === null ? valores : parametro.split(',').filter((item): item is T => valores.includes(item as T)))
        .forEach((valor) => alvo.add(valor));
    };
    restaurarConjunto(situacoes, 'etapas', SITUACOES);
    restaurarConjunto(categorias, 'tipos', CATEGORIAS);
    const codigosFarol: Record<string, FarolFiltro> = { todas: 'todas', noprazo: 'verde', atencao: 'amarelo', atrasadas: 'vermelho' };
    farolFiltro = codigosFarol[parametros.get('sit') ?? 'todas'] ?? 'todas';
    filtroSituacao.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = situacoes.has(input.value as SituacaoMapa); });
    filtroCategoria.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = categorias.has(input.value as CategoriaObra); });
    filtroFarol.opcoes.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = input.value === farolFiltro; });
    atualizarResumo();
    const centro = parametros.get('c')?.split(',').map(Number);
    const zoom = Number(parametros.get('z'));
    if (centro?.length === 2 && centro.every(Number.isFinite) && Math.abs(centro[0]!) <= 90 && Math.abs(centro[1]!) <= 180) {
      mapa.setView([centro[0]!, centro[1]!], Number.isFinite(zoom) && zoom >= 10 && zoom <= 18 ? zoom : mapa.getZoom(), { animate: false });
    } else if (Number.isFinite(zoom) && zoom >= 10 && zoom <= 18) {
      mapa.setZoom(zoom, { animate: false });
    }
    historico.length = 0;
    selecao = { tipo: 'cidade' };
    desenhar();
    const sel = parametros.get('sel');
    if (sel?.startsWith('obra:')) {
      const obra = todas.find((item) => item.id === sel.slice(5));
      if (obra) selecionar({ tipo: 'obra', obra }, false);
    } else if (sel?.startsWith('regiao:') || sel?.startsWith('bairro:')) {
      const nivel = sel.startsWith('regiao:') ? 'regiao' : 'bairro';
      const grupos = nivel === 'regiao'
        ? agruparPorRegiao(obrasAgrupaveis(obrasFiltradas()))
        : agruparPorBairro(obrasAgrupaveis(obrasFiltradas()));
      const grupo = grupos.find((item) => item.id === sel);
      if (grupo) selecionar({ tipo: 'grupo', grupo }, false);
    }
  }
  document.addEventListener('popstate', restaurarEstadoURL);
  desenhar();
  restaurarEstadoURL();
});
</script>
