---
import '../../styles/carteira.css';
import { carregarCarteira } from '../../lib/carteira/carga.ts';
import { MACROETAPAS, nomeMacroetapa } from '../../lib/carteira/macroetapas.ts';
import { segmentosGantt } from '../../lib/carteira/visoes.ts';
import { curto } from '../../lib/dados/formato.ts';
import { dataBr } from '../../lib/datas.ts';
import { hrefFicha } from '../../lib/carteira/ficha.ts';
import { aquiDe } from '../../lib/navegacao/volta.ts';
import { aplicarFiltros, dataEntrega, lerFiltros, opcoesFiltros, orgaoDe } from '../../lib/carteira/filtros.ts';
import FiltrosProjetos from './FiltrosProjetos.astro';

const carteira = carregarCarteira();
const LIM_INI = '2026-01-01';
const LIM_FIM = '2029-12-31';
const dia = (iso: string) => Date.parse(`${iso.slice(0, 10)}T00:00:00Z`);
const hojeIso = new Date().toISOString().slice(0, 10);

const opcoes = opcoesFiltros(carteira.projetos, hojeIso);
const { filtros, avisos } = lerFiltros(Astro.url.searchParams, opcoes);
const aqui = aquiDe(Astro.url);
const segsDe = new Map(carteira.projetos.map((p) => [p, segmentosGantt(p)]));
const comDatas = carteira.projetos.filter((p) => segsDe.get(p)!.length); // eixo estável: todos com datas, sem filtro
const visiveis = aplicarFiltros(carteira.projetos, filtros); // ordem: entrega mais próxima primeiro
const comSegs = visiveis.filter((p) => segsDe.get(p)!.length).map((p) => ({ p, segs: segsDe.get(p)! }));
const semDatas = visiveis.filter((p) => !segsDe.get(p)!.length);

// Eixo: do menor início ao maior fim, fechado em meses e limitado a jan/2026 - dez/2029.
const todas = comDatas.flatMap((p) => segsDe.get(p)!);
let minIso = todas.length ? todas.reduce((m, s) => (s.inicio < m ? s.inicio : m), todas[0].inicio) : LIM_INI;
let maxIso = todas.length ? todas.reduce((m, s) => (s.fim > m ? s.fim : m), todas[0].fim) : LIM_FIM;
if (minIso < LIM_INI) minIso = LIM_INI;
if (maxIso > LIM_FIM) maxIso = LIM_FIM;
if (maxIso < minIso) maxIso = minIso;
const anoIni = Number(minIso.slice(0, 4));
const mesIni = Number(minIso.slice(5, 7)) - 1;
const anoFim = Number(maxIso.slice(0, 4));
const mesFim = Number(maxIso.slice(5, 7)) - 1;
const nMeses = (anoFim - anoIni) * 12 + (mesFim - mesIni) + 1;
const t0 = Date.UTC(anoIni, mesIni, 1);
const t1 = Date.UTC(anoFim, mesFim + 1, 1);
const span = t1 - t0;
const pct = (t: number) => Math.min(100, Math.max(0, ((t - t0) / span) * 100));
const nomesMes = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const passo = nMeses > 30 ? 3 : nMeses > 16 ? 2 : 1;
const meses = Array.from({ length: nMeses }, (_, i) => {
  const ano = anoIni + Math.floor((mesIni + i) / 12);
  const mes = (mesIni + i) % 12;
  return { ano, mes, esq: pct(Date.UTC(ano, mes, 1)) };
});
const hojeT = dia(hojeIso);
const hojeVisivel = hojeT >= t0 && hojeT <= t1;
const larguraMin = Math.max(900, nMeses * 36 + 220);
---
<div data-cart data-gantt>
  <FiltrosProjetos filtros={filtros} opcoes={opcoes} avisos={avisos} rotulo="Filtros do Gantt" />
  <ul class="gt-legenda" aria-label="Legenda das macroetapas">
    {MACROETAPAS.filter((m) => m.codigo !== '06').map((m) => (
      <li style={`--cor:var(--mc-${m.codigo})`}><span class="gt-chave" aria-hidden="true"></span>{m.rotulo}</li>
    ))}
    <li><span class="gt-chave" aria-hidden="true" style="background:transparent;border-left:2px dashed var(--cart-vermelho);width:0;height:.9rem;border-radius:0"></span>Linha tracejada: hoje</li>
  </ul>
  <p class="cart-resumo" role="status" data-gt-resumo>Mostrando {comSegs.length} de {comDatas.length} projetos com datas, da entrega mais próxima à mais distante.</p>
  {comSegs.length === 0 && <p class="gt-vazio" data-gt-vazio>{comDatas.length === 0 ? 'Nenhum projeto com datas previstas.' : 'Nenhum projeto encontrado com esses filtros.'}</p>}
  {comSegs.length > 0 && <div class="cart-scroll" tabindex="0" role="region" aria-label="Gantt geral por macroetapa">
    <div class="gt-quadro" style={`min-width:${larguraMin}px`}>
      <div class="gt-linha gt-eixo">
        <div class="gt-rotulo"><strong>Projeto</strong></div>
        <div class="gt-trilha">
          {meses.filter((m) => m.mes === 0 || m === meses[0]).map((m) => <span class="gt-ano" style={`left:${m.esq}%`}>{m.ano}</span>)}
          {meses.filter((_, i) => i % passo === 0).map((m) => <span class="gt-mes" style={`left:${m.esq}%`}>{nomesMes[m.mes]}</span>)}
        </div>
      </div>
      <div class="gt-sobreposto" aria-hidden="true">
        {meses.filter((_, i) => i % passo === 0).map((m) => <span class="gt-grade" style={`left:${m.esq}%`}></span>)}
        {hojeVisivel && <span class="gt-hoje" style={`left:${pct(hojeT)}%`}><span>Hoje</span></span>}
      </div>
      {comSegs.map(({ p, segs }) => (
        <div class="gt-linha" data-gt-linha data-orgao={orgaoDe(p)} data-macro={p.macroetapa ?? ''} data-entrega={dataEntrega(p) ?? ''}>
          <div class="gt-rotulo" title={p.nome}><a class="gt-nome" href={hrefFicha(p.id, aqui)}>{curto(p.nome, 38)}</a><small>{orgaoDe(p)} · {dataEntrega(p) ? `Entrega ${dataBr(dataEntrega(p)!)}` : 'Sem data de entrega'}</small></div>
          <div class="gt-trilha">
            {segs.map((s) => {
              const rotulo = `${nomeMacroetapa(s.codigo)}: ${dataBr(s.inicio)} a ${dataBr(s.fim)}`;
              const e = pct(Math.max(dia(s.inicio), t0));
              const d = pct(Math.min(dia(s.fim), t1));
              return <span class="gt-bar" role="img" title={rotulo} aria-label={`${p.nome} · ${rotulo}`} style={`left:${e}%;width:${Math.max(d - e, 0.3)}%;--cor:var(--mc-${s.codigo})`}></span>;
            })}
          </div>
        </div>
      ))}
    </div>
  </div>}
  {semDatas.length > 0 && <p class="gt-sem">Sem datas previstas: {semDatas.length} projeto{semDatas.length === 1 ? '' : 's'}.</p>}
</div>
