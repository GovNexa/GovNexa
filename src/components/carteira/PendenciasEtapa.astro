---
// Pendências de etapa (E7/B3): aprovar avança e reprovar volta uma etapa, gravando no banco pela mesma regra do Kanban
// (rota POST /plataforma/projeto/mover/<id>/, origem 'pendencia'). Exige os perfis editar_projeto e aprovar_etapa.
import '../../styles/carteira.css';
import { carregarCarteira } from '../../lib/carteira/carga.ts';
import { MACROETAPAS } from '../../lib/carteira/macroetapas.ts';
import { portaoPara } from '../../lib/carteira/movimentacao.ts';
import { podeMoverNaTela } from '../../lib/carteira/mover.ts';
import { etapaAnterior, nomeEtapa, proximaEtapa } from '../../lib/carteira/simulacao.ts';
import type { Projeto } from '../../lib/carteira/tipos.ts';

const carteira = carregarCarteira();
const repo = Astro.locals.repositorio;
const acesso = podeMoverNaTela(Astro.locals.usuario, repo, 'pendencia');
const revisoes: Map<string, number> = acesso === 'ok' ? await repo.listarRevisoes!() : new Map();
const abertos = carteira.projetos.filter((p) => p.macroetapa !== '06');
const orgaos = [...new Set(abertos.map((p) => p.orgao ?? 'Sem órgão'))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const grupos = [
  ...MACROETAPAS.filter((m) => m.codigo !== '06').map((m) => ({ codigo: m.codigo as string, nome: m.nome, projetos: abertos.filter((p) => p.macroetapa === m.codigo) })),
  { codigo: 'sem', nome: 'Sem macroetapa', projetos: abertos.filter((p) => p.macroetapa === null) },
].filter((g) => g.projetos.length > 0);
const situacao = (p: Projeto) => {
  const prox = proximaEtapa(p.macroetapa);
  return prox ? { prox, faltando: portaoPara(p, prox) } : { prox: null, faltando: [] as string[] };
};
---
<div data-cart data-pendencias>
  {acesso === 'perfil' && <p class="cart-aviso" role="note" data-pd-so-leitura>Seu perfil permite só consultar as pendências. Aprovar e reprovar etapas é do perfil de gestão.</p>}
  {acesso === 'indisponivel' && <p class="cart-aviso" role="note" data-pd-indisponivel>Gravação indisponível no momento: as pendências estão só para consulta.</p>}
  <div class="cart-filtros">
    <label>Órgão
      <select data-pd-orgao>
        <option value="">Todos</option>
        {orgaos.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label>Macroetapa atual
      <select data-pd-macro>
        <option value="">Todas</option>
        {grupos.map((g) => <option value={g.codigo}>{g.nome}</option>)}
      </select>
    </label>
  </div>
  <p class="cart-resumo" role="status" data-pd-resumo>Mostrando {abertos.length} de {abertos.length} projetos.</p>
  {grupos.map((g) => (
    <section class="pd-grupo" data-pd-grupo data-codigo={g.codigo} aria-labelledby={`pd-${g.codigo}`}>
      <h2 id={`pd-${g.codigo}`}>{g.nome} <span class="pill" data-pd-qtd>{g.projetos.length}</span></h2>
      <ul class="pd-lista">
        {g.projetos.map((p) => {
          const s = situacao(p);
          const pronto = s.prox !== null && s.faltando.length === 0;
          const rev = revisoes.get(p.id);
          const acoes = acesso === 'ok' && rev !== undefined;
          return (
            <li class="pd-linha" data-pd-linha data-id={p.id} data-nome={p.nome} data-macro={p.macroetapa ?? ''} data-revisao={rev ?? ''} data-orgao={p.orgao ?? 'Sem órgão'}>
              <div class="pd-nome">
                <strong>{p.nome}</strong>
                <span>{p.orgao ?? 'Sem órgão'}</span>
              </div>
              <div class="pd-etapa" data-pd-etapa>
                <span>{nomeEtapa(p.macroetapa)} → {s.prox ? nomeEtapa(s.prox) : '—'}</span>
                <span class="pd-situacao" data-pd-situacao>
                  {pronto ? 'Pronto para avançar' : s.prox ? `Falta: ${s.faltando.join(', ')}` : 'Sem próxima etapa'}
                </span>
              </div>
              <div class="pd-acoes" data-pd-acoes>
                {acoes && pronto && <button type="button" class="primary" data-pd-aprovar>Aprovar</button>}
                {acoes && pronto && etapaAnterior(p.macroetapa) && <button type="button" class="secondary" data-pd-reprovar>Reprovar</button>}
                {acoes && !pronto && s.prox && <button type="button" class="secondary" data-pd-forcar>Aprovar mesmo assim</button>}
              </div>
              <p class="pd-resultado" data-pd-resultado hidden></p>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
  <p class="cart-resumo" data-pd-vazio hidden>Nenhum projeto com esses filtros.</p>
  {acesso === 'ok' && (
    <dialog id="pd-dialog" class="cart-dialogo" aria-labelledby="pd-dialog-titulo">
      <form data-pd-form>
        <h2 id="pd-dialog-titulo" data-pd-dlg-titulo>Confirmar</h2>
        <p data-pd-dlg-projeto></p>
        <label>Motivo (obrigatório)
          <textarea name="motivo" rows="2" maxlength="500" data-pd-dlg-motivo></textarea>
        </label>
        <div class="cart-erro" role="alert" data-pd-dlg-erro hidden></div>
        <label class="cart-forcar" data-pd-dlg-forcar-linha hidden>
          <input type="checkbox" data-pd-dlg-forcar /> Forçar com motivo
        </label>
        <div class="actions">
          <button type="submit" class="primary" data-pd-dlg-aplicar>Aplicar</button>
          <button type="button" class="secondary" data-pd-dlg-cancelar>Cancelar</button>
        </div>
      </form>
    </dialog>
  )}
</div>
<script>
import { avisar, etapaAnterior, mostrarErro, nomeEtapa, proximaEtapa } from '../../lib/carteira/simulacao.ts';
import { enviarMovimento, type RespostaMover } from '../../lib/carteira/mover-cliente.ts';
import type { CodigoMacroetapa } from '../../lib/carteira/tipos.ts';

document.addEventListener('astro:page-load', () => {
  const raiz = document.querySelector<HTMLElement>('[data-pendencias]');
  if (!raiz || raiz.dataset.pronto) return;
  raiz.dataset.pronto = 'sim';
  const selOrgao = raiz.querySelector<HTMLSelectElement>('[data-pd-orgao]')!;
  const selMacro = raiz.querySelector<HTMLSelectElement>('[data-pd-macro]')!;
  const total = raiz.querySelectorAll('[data-pd-linha]').length;

  const filtrar = () => {
    let visiveis = 0;
    raiz.querySelectorAll<HTMLElement>('[data-pd-grupo]').forEach((g) => {
      const doGrupo = !selMacro.value || g.dataset.codigo === selMacro.value;
      let n = 0;
      g.querySelectorAll<HTMLElement>('[data-pd-linha]').forEach((l) => {
        const ok = doGrupo && (!selOrgao.value || l.dataset.orgao === selOrgao.value);
        l.hidden = !ok;
        if (ok) n++;
      });
      g.hidden = n === 0;
      g.querySelector('[data-pd-qtd]')!.textContent = String(n);
      visiveis += n;
    });
    raiz.querySelector('[data-pd-resumo]')!.textContent = `Mostrando ${visiveis} de ${total} projetos.`;
    raiz.querySelector<HTMLElement>('[data-pd-vazio]')!.hidden = visiveis > 0;
  };
  selOrgao.addEventListener('change', filtrar);
  selMacro.addEventListener('change', filtrar);

  const dlg = raiz.querySelector<HTMLDialogElement>('#pd-dialog');
  if (!dlg) return; // só consulta
  const form = dlg.querySelector<HTMLFormElement>('[data-pd-form]')!;
  const campoMotivo = dlg.querySelector<HTMLTextAreaElement>('[data-pd-dlg-motivo]')!;
  const caixaErro = dlg.querySelector<HTMLElement>('[data-pd-dlg-erro]')!;
  const linhaForcar = dlg.querySelector<HTMLElement>('[data-pd-dlg-forcar-linha]')!;
  const campoForcar = dlg.querySelector<HTMLInputElement>('[data-pd-dlg-forcar]')!;
  const botaoAplicar = dlg.querySelector<HTMLButtonElement>('[data-pd-dlg-aplicar]')!;
  let alvo: { linha: HTMLElement; para: CodigoMacroetapa; verbo: string } | null = null;
  let ocupado = false;

  const macroDe = (l: HTMLElement) => (l.dataset.macro || null) as CodigoMacroetapa | null;

  function abrir(linha: HTMLElement, para: CodigoMacroetapa, titulo: string, verbo: string, forcar: boolean, erro?: { erro: string; faltando?: string[]; forcavel?: boolean }) {
    alvo = { linha, para, verbo };
    dlg!.querySelector('[data-pd-dlg-titulo]')!.textContent = titulo;
    dlg!.querySelector('[data-pd-dlg-projeto]')!.textContent = `${linha.dataset.nome ?? ''} · de ${nomeEtapa(macroDe(linha))} para ${nomeEtapa(para)}`;
    campoMotivo.value = '';
    campoForcar.checked = forcar;
    linhaForcar.hidden = !forcar;
    caixaErro.hidden = true;
    if (erro) {
      mostrarErro(caixaErro, erro.erro, erro.faltando);
      linhaForcar.hidden = !erro.forcavel && !forcar;
    }
    if (!dlg!.open) dlg!.showModal();
    campoMotivo.focus();
  }

  function concluir(linha: HTMLElement, r: Extract<RespostaMover, { ok: true }>, verbo: string) {
    const de = nomeEtapa(macroDe(linha));
    linha.dataset.macro = r.macroetapa;
    linha.dataset.revisao = String(r.revisao);
    linha.querySelector('[data-pd-acoes]')!.replaceChildren();
    const res = linha.querySelector<HTMLElement>('[data-pd-resultado]')!;
    res.textContent = `${verbo[0].toUpperCase()}${verbo.slice(1)} para ${nomeEtapa(r.macroetapa)}${r.forcado ? ' (forçado com motivo)' : ''}. Registrado no Histórico.`;
    res.hidden = false;
    const etapa = linha.querySelector('[data-pd-etapa]')!;
    etapa.replaceChildren();
    const span = document.createElement('span');
    span.textContent = `Agora em ${nomeEtapa(r.macroetapa)} (antes: ${de})`;
    etapa.append(span);
    avisar(`${linha.dataset.nome ?? ''} ${verbo} para ${nomeEtapa(r.macroetapa)}. Registrado no Histórico.`);
  }

  async function enviar(linha: HTMLElement, para: CodigoMacroetapa, motivo: string, forcar: boolean): Promise<RespostaMover | null> {
    const revisao = Number(linha.dataset.revisao);
    if (ocupado || linha.dataset.revisao === '' || !Number.isSafeInteger(revisao)) return null;
    ocupado = true;
    botaoAplicar.disabled = true;
    linha.querySelectorAll<HTMLButtonElement>('[data-pd-acoes] button').forEach((b) => { b.disabled = true; });
    try {
      return await enviarMovimento({ id: linha.dataset.id ?? '', revisao, de: macroDe(linha), para, motivo, forcar, origem: 'pendencia' });
    } finally {
      ocupado = false;
      botaoAplicar.disabled = false;
      linha.querySelectorAll<HTMLButtonElement>('[data-pd-acoes] button').forEach((b) => { b.disabled = false; });
    }
  }

  raiz.addEventListener('click', async (e) => {
    const botao = (e.target as HTMLElement).closest<HTMLElement>('[data-pd-aprovar],[data-pd-reprovar],[data-pd-forcar]');
    if (!botao) return;
    const linha = botao.closest<HTMLElement>('[data-pd-linha]')!;
    const atual = macroDe(linha);
    if (botao.hasAttribute('data-pd-reprovar')) {
      const ant = etapaAnterior(atual);
      if (ant) abrir(linha, ant, 'Reprovar etapa (voltar uma etapa)', 'voltou', false);
    } else if (botao.hasAttribute('data-pd-forcar')) {
      const prox = proximaEtapa(atual);
      if (prox) abrir(linha, prox, 'Aprovar mesmo assim (forçar com motivo)', 'avançou', true);
    } else {
      const prox = proximaEtapa(atual);
      if (!prox) return;
      const r = await enviar(linha, prox, '', false);
      if (!r) return;
      if (r.ok) concluir(linha, r, 'avançou');
      else abrir(linha, prox, 'Aprovar etapa', 'avançou', false, { erro: r.erro, faltando: r.faltando, forcavel: r.forcavel });
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!alvo) return;
    const motivo = campoMotivo.value.trim();
    if (!motivo) {
      mostrarErro(caixaErro, 'Informe o motivo.');
      campoMotivo.focus();
      return;
    }
    const { linha, para, verbo } = alvo;
    const r = await enviar(linha, para, motivo, campoForcar.checked);
    if (!r) return;
    if (r.ok) {
      dlg.close();
      concluir(linha, r, verbo);
      const res = linha.querySelector<HTMLElement>('[data-pd-resultado]')!;
      res.tabIndex = -1;
      res.focus();
    } else {
      mostrarErro(caixaErro, r.erro, r.faltando);
      linhaForcar.hidden = !r.forcavel && !campoForcar.checked;
      campoMotivo.focus();
    }
  });
  dlg.querySelector('[data-pd-dlg-cancelar]')!.addEventListener('click', () => dlg.close());
});
</script>
