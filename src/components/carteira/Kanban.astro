---
// Kanban por macroetapa (E7). Cards enxutos (nome, órgão e saída prevista do marco), colunas de 00 a 05, filtros do padrão (E2).
// Mover grava no banco (B3) pela rota POST /plataforma/projeto/mover/<id>/, com a regra única (portão e motivo) e o Histórico.
import '../../styles/carteira.css';
import '../../styles/kanban.css';
import FiltrosProjetos from './FiltrosProjetos.astro';
import { carregarCarteira } from '../../lib/carteira/carga.ts';
import { lerFiltros, opcoesFiltros } from '../../lib/carteira/filtros.ts';
import { hrefFicha } from '../../lib/carteira/ficha.ts';
import { DESTINOS_MOVER, montarKanban, textoSaida } from '../../lib/carteira/kanban.ts';
import { podeMoverNaTela } from '../../lib/carteira/mover.ts';
import { dataBr } from '../../lib/datas.ts';

const carteira = carregarCarteira();
const hojeIso = new Date().toISOString().slice(0, 10);
const opcoes = opcoesFiltros(carteira.projetos, hojeIso);
const { filtros, avisos } = lerFiltros(Astro.url.searchParams, opcoes);
const repo = Astro.locals.repositorio;
const acesso = podeMoverNaTela(Astro.locals.usuario, repo, 'kanban');
const revisoes: Map<string, number> = acesso === 'ok' ? await repo.listarRevisoes!() : new Map();
const quadro = montarKanban(carteira.projetos, filtros);
const emAndamento = carteira.projetos.filter((p) => p.macroetapa !== '06').length;
const volta = `${Astro.url.pathname}${Astro.url.search}`;
const plural = (n: number) => `${n} projeto${n === 1 ? '' : 's'}`;
---
<div data-cart data-kanban data-kb-total={emAndamento}>
  <FiltrosProjetos filtros={filtros} opcoes={opcoes} avisos={avisos} rotulo="Filtros do Kanban" />
  {acesso === 'perfil' && <p class="cart-aviso" role="note" data-kb-so-leitura>Seu perfil permite só consultar o Kanban. Para mover projetos, peça o perfil de edição.</p>}
  {acesso === 'indisponivel' && <p class="cart-aviso" role="note" data-kb-indisponivel>Gravação indisponível no momento: o Kanban está só para consulta.</p>}
  {filtros.macro === '06' && <p class="cart-aviso" role="note" data-kb-aviso-conclusao>A coluna Conclusão não aparece no Kanban. Os projetos concluídos estão na <a href="/plataforma/projetos-carteira/?macro=06">Carteira</a> e no Histórico.</p>}
  <p class="cart-resumo" role="status" tabindex="-1" data-kb-resumo>Mostrando {plural(quadro.total)} de {emAndamento} em andamento.</p>
  {quadro.concluidos > 0 && <p class="kq-concluidos" data-kb-concluidos>{plural(quadro.concluidos)} em Conclusão não aparece{quadro.concluidos === 1 ? '' : 'm'} no Kanban (ficam na Carteira e no Histórico).</p>}
  <div class="kq-scroll" tabindex="0" role="region" aria-label="Quadro Kanban por macroetapa">
    <div class="kq-quadro">
      {quadro.colunas.map((c) => (
        <section class="kq-col" data-kb-col data-codigo={c.codigo} style={`--cor:var(--mc-${c.codigo === 'sem' ? '00' : c.codigo})`} aria-labelledby={`kb-${c.codigo}`}>
          <header>
            <h2 id={`kb-${c.codigo}`}>{c.nome}</h2>
            <p class="kq-qtd" data-kb-qtd>{plural(c.cards.length)}</p>
            <p class="kq-marco" data-kb-marco>{c.marco}</p>
          </header>
          <div class="kq-lista">
            {c.cards.map((k) => {
              const rev = revisoes.get(k.id);
              const movel = acesso === 'ok' && rev !== undefined;
              return (
                <article class="kq-card" data-kb-card data-id={k.id} data-nome={k.nome} data-macro={k.macro ?? ''} data-revisao={rev ?? ''} draggable={movel ? 'true' : 'false'}>
                  <a class="kq-nome" draggable="false" href={hrefFicha(k.id, volta)}>{k.nome}</a>
                  <span class="kq-orgao">{k.orgao}</span>
                  <span class="kq-saida" data-kb-saida>{textoSaida(k.saida, dataBr)}</span>
                  {movel && <button type="button" class="secondary kq-mover" data-kb-mover aria-label={`Mover ${k.nome}`}>Mover</button>}
                </article>
              );
            })}
            <p class="kq-vazio" data-kb-vazio hidden={c.cards.length > 0}>Nenhum projeto</p>
          </div>
        </section>
      ))}
    </div>
  </div>
  {acesso === 'ok' && (
    <dialog id="kb-dialog" class="cart-dialogo" aria-labelledby="kb-dialog-titulo">
      <form data-kb-form>
        <h2 id="kb-dialog-titulo">Mover projeto</h2>
        <p data-kb-dlg-projeto></p>
        <label>Para a etapa
          <select name="para" data-kb-dlg-para>
            {DESTINOS_MOVER.map((d) => <option value={d.codigo}>{d.rotulo}</option>)}
          </select>
        </label>
        <label>Motivo (obrigatório para voltar, pular etapa ou forçar)
          <textarea name="motivo" rows="2" maxlength="500" data-kb-dlg-motivo></textarea>
        </label>
        <div class="cart-erro" role="alert" data-kb-dlg-erro hidden></div>
        <label class="cart-forcar" data-kb-dlg-forcar-linha hidden>
          <input type="checkbox" data-kb-dlg-forcar /> Forçar com motivo (o motivo passa a ser obrigatório)
        </label>
        <div class="actions">
          <button type="submit" class="primary" data-kb-dlg-aplicar>Aplicar</button>
          <button type="button" class="secondary" data-kb-dlg-cancelar>Cancelar</button>
        </div>
      </form>
    </dialog>
  )}
</div>
<script>
import { avisar, mostrarErro, nomeEtapa, proximaEtapa } from '../../lib/carteira/simulacao.ts';
import { textoSaida } from '../../lib/carteira/kanban.ts';
import { enviarMovimento, type RespostaMover } from '../../lib/carteira/mover-cliente.ts';
import { dataBr } from '../../lib/datas.ts';
import type { CodigoMacroetapa } from '../../lib/carteira/tipos.ts';

document.addEventListener('astro:page-load', () => {
  const raiz = document.querySelector<HTMLElement>('[data-kanban]');
  if (!raiz || raiz.dataset.kbPronto === '1') return;
  raiz.dataset.kbPronto = '1';
  const dlg = raiz.querySelector<HTMLDialogElement>('#kb-dialog');
  if (!dlg) return; // só consulta: sem diálogo, sem arrastar
  const form = dlg.querySelector<HTMLFormElement>('[data-kb-form]')!;
  const campoPara = dlg.querySelector<HTMLSelectElement>('[data-kb-dlg-para]')!;
  const campoMotivo = dlg.querySelector<HTMLTextAreaElement>('[data-kb-dlg-motivo]')!;
  const caixaErro = dlg.querySelector<HTMLElement>('[data-kb-dlg-erro]')!;
  const linhaForcar = dlg.querySelector<HTMLElement>('[data-kb-dlg-forcar-linha]')!;
  const campoForcar = dlg.querySelector<HTMLInputElement>('[data-kb-dlg-forcar]')!;
  const botaoAplicar = dlg.querySelector<HTMLButtonElement>('[data-kb-dlg-aplicar]')!;
  let total = Number(raiz.dataset.kbTotal) || 0;
  let cartao: HTMLElement | null = null;
  let abridor: HTMLElement | null = null;
  let ocupado = false;

  const macroDe = (c: HTMLElement) => (c.dataset.macro || null) as CodigoMacroetapa | null;
  const plural = (n: number) => `${n} projeto${n === 1 ? '' : 's'}`;

  function contar() {
    let n = 0;
    raiz!.querySelectorAll<HTMLElement>('[data-kb-col]').forEach((col) => {
      const qtd = col.querySelectorAll('[data-kb-card]').length;
      n += qtd;
      col.querySelector('[data-kb-qtd]')!.textContent = plural(qtd);
      col.querySelector<HTMLElement>('[data-kb-vazio]')!.hidden = qtd > 0;
    });
    raiz!.querySelector('[data-kb-resumo]')!.textContent = `Mostrando ${plural(n)} de ${total} em andamento.`;
  }

  function abrir(c: HTMLElement, destino: string, erro?: { erro: string; faltando?: string[]; forcar?: boolean }) {
    cartao = c;
    dlg!.querySelector('[data-kb-dlg-projeto]')!.textContent = `${c.dataset.nome ?? ''} · etapa atual: ${nomeEtapa(macroDe(c))}`;
    campoPara.value = destino;
    campoMotivo.value = '';
    campoForcar.checked = false;
    linhaForcar.hidden = true;
    caixaErro.hidden = true;
    if (erro) {
      mostrarErro(caixaErro, erro.erro, erro.faltando);
      linhaForcar.hidden = erro.forcar !== true;
    }
    if (!dlg!.open) dlg!.showModal();
    (erro ? campoMotivo : campoPara).focus();
  }

  function concluir(c: HTMLElement, r: Extract<RespostaMover, { ok: true }>) {
    const de = macroDe(c);
    const nome = c.dataset.nome ?? '';
    if (r.macroetapa === '06') {
      c.remove();
      total = Math.max(0, total - 1);
      contar();
      avisar(`${nome} foi de ${nomeEtapa(de)} para Conclusão e saiu do Kanban. Registrado no Histórico.`);
      return;
    }
    c.dataset.macro = r.macroetapa;
    c.dataset.revisao = String(r.revisao);
    const saida = c.querySelector('[data-kb-saida]');
    if (saida) saida.textContent = textoSaida(r.saida, dataBr);
    const col = [...raiz!.querySelectorAll<HTMLElement>('[data-kb-col]')].find((x) => x.dataset.codigo === r.macroetapa);
    if (col) {
      const lista = col.querySelector('.kq-lista')!;
      lista.insertBefore(c, lista.querySelector('[data-kb-vazio]'));
    } else {
      c.remove(); // a coluna de destino não está no quadro
    }
    contar();
    avisar(`${nome} foi de ${nomeEtapa(de)} para ${nomeEtapa(r.macroetapa)}${r.forcado ? ' (forçado com motivo)' : ''}. Registrado no Histórico.`);
  }

  async function enviar(c: HTMLElement, para: CodigoMacroetapa, motivo: string, forcar: boolean): Promise<RespostaMover | null> {
    const revisao = Number(c.dataset.revisao);
    if (ocupado || c.dataset.revisao === '' || !Number.isSafeInteger(revisao)) return null;
    ocupado = true;
    botaoAplicar.disabled = true;
    try {
      return await enviarMovimento({ id: c.dataset.id ?? '', revisao, de: macroDe(c), para, motivo, forcar, origem: 'kanban' });
    } finally {
      ocupado = false;
      botaoAplicar.disabled = false;
    }
  }

  // Arrastar e soltar: tenta direto; se a regra pedir motivo ou faltar requisito, abre o diálogo com o destino e o erro.
  async function tentar(c: HTMLElement, destino: CodigoMacroetapa) {
    const r = await enviar(c, destino, '', false);
    if (!r) return;
    if (r.ok) concluir(c, r);
    else abrir(c, destino, { erro: r.erro, faltando: r.faltando, forcar: r.forcavel });
  }

  raiz.addEventListener('click', (e) => {
    const botao = (e.target as HTMLElement).closest<HTMLElement>('[data-kb-mover]');
    if (!botao) return;
    abridor = botao;
    const c = botao.closest<HTMLElement>('[data-kb-card]')!;
    const atual = macroDe(c);
    abrir(c, proximaEtapa(atual) ?? atual ?? '00');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!cartao) return;
    const c = cartao;
    const para = campoPara.value as CodigoMacroetapa;
    const motivo = campoMotivo.value.trim();
    const forcar = campoForcar.checked;
    if (para === macroDe(c)) { mostrarErro(caixaErro, 'O projeto já está nesta etapa. Escolha outra.'); campoPara.focus(); return; }
    if (forcar && !motivo) { mostrarErro(caixaErro, 'Informe o motivo para forçar.'); linhaForcar.hidden = false; campoMotivo.focus(); return; }
    const r = await enviar(c, para, motivo, forcar);
    if (!r) return;
    if (r.ok) {
      dlg.close();
      concluir(c, r);
      (abridor && document.contains(abridor) ? abridor : raiz.querySelector<HTMLElement>('[data-kb-resumo]'))?.focus();
    } else {
      mostrarErro(caixaErro, r.erro, r.faltando);
      linhaForcar.hidden = !r.forcavel && !campoForcar.checked;
      campoMotivo.focus();
    }
  });
  dlg.querySelector('[data-kb-dlg-cancelar]')!.addEventListener('click', () => dlg.close());

  let arrastado: HTMLElement | null = null;
  raiz.addEventListener('dragstart', (e) => {
    const c = (e.target as HTMLElement).closest<HTMLElement>('[data-kb-card][draggable="true"]');
    if (!c) return;
    arrastado = c;
    e.dataTransfer?.setData('text/plain', c.dataset.id ?? '');
    if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
  });
  raiz.addEventListener('dragend', () => {
    arrastado = null;
    raiz.querySelectorAll('.kq-alvo').forEach((x) => x.classList.remove('kq-alvo'));
  });
  raiz.addEventListener('dragover', (e) => {
    const col = (e.target as HTMLElement).closest<HTMLElement>('[data-kb-col]');
    if (!arrastado || !col || col.dataset.codigo === 'sem') return;
    e.preventDefault();
    raiz.querySelectorAll('.kq-alvo').forEach((x) => x !== col && x.classList.remove('kq-alvo'));
    col.classList.add('kq-alvo');
  });
  raiz.addEventListener('drop', (e) => {
    const col = (e.target as HTMLElement).closest<HTMLElement>('[data-kb-col]');
    if (!arrastado || !col || col.dataset.codigo === 'sem') return;
    e.preventDefault();
    const c = arrastado;
    arrastado = null;
    col.classList.remove('kq-alvo');
    if (macroDe(c) === col.dataset.codigo) return; // mesma coluna: nada muda
    abridor = null;
    void tentar(c, col.dataset.codigo as CodigoMacroetapa);
  });
});
</script>
