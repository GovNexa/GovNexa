---
import '../../styles/carteira.css';
import { carregarCarteira } from '../../lib/carteira/carga.ts';
import { AREAS_PADRAO, areasDaPrefeitura } from '../../lib/carteira/area.ts';
import { blocosProjeto } from '../../lib/carteira/formulario.ts';
import CamposProjeto from './CamposProjeto.astro';
import { usuarioPode } from '../../lib/usuarios/index.ts';
import EditorLocalizacao from '../mapa/EditorLocalizacao.astro';
import { carregarGeoBairros } from '../../lib/mapa/obras.ts';
import type { PontoGeo } from '../../lib/mapa/tipos.ts';

const geoBairros = carregarGeoBairros().bairros;
const geoCentros: Record<string, PontoGeo> = {};
for (const [nome, g] of Object.entries(geoBairros)) if (g.encontrado && typeof g.lat === 'number' && typeof g.lng === 'number') geoCentros[nome] = { lat: g.lat, lng: g.lng };
const nomesBairros = Object.keys(geoCentros).sort((a, b) => a.localeCompare(b, 'pt-BR'));

const projetos = carregarCarteira().projetos;
const unicos = (l: (string | null | undefined)[]) => [...new Set(l.map((x) => (x ?? '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const orgaos = unicos(projetos.map((p) => p.orgao));
const regioes = unicos(projetos.map((p) => p.regiao));
const origensValor = unicos(projetos.map((p) => p.origem_valor));
const detalhamentos = unicos(projetos.map((p) => p.detalhamento));
const podeSalvar = usuarioPode(Astro.locals.usuario, 'editar_projeto') && Astro.locals.repositorio?.podeGravar === true;

const areas = Astro.locals.repositorio ? await areasDaPrefeitura(Astro.locals.repositorio) : [...AREAS_PADRAO];
const blocos = blocosProjeto({ orgaos, regioes, origensValor, detalhamentos, areas });
---
<div data-novo-projeto>
  {!podeSalvar && <p class="cart-aviso" role="note">Seu perfil permite ver o formulário, mas não cadastrar projetos.</p>}
  <div class="cart-erro" role="alert" tabindex="-1" data-np-resumo hidden></div>
  <form class="np-form" data-np-form novalidate>
    <CamposProjeto prefixo="np" blocos={blocos} />
    <fieldset class="np-bloco">
      <legend>Localização (opcional)</legend>
      <p class="np-dica">Marque no mapa onde fica a obra. Se não souber agora, deixe em branco: o mapa usa o centro do bairro e a localização pode ser cadastrada depois.</p>
      <EditorLocalizacao idPrefixo="np-loc" bairros={nomesBairros} geo={geoCentros} buscaEndereco={podeSalvar} />
    </fieldset>
    <div class="actions np-acoes">
      {podeSalvar && <button type="submit" class="primary" data-np-enviar>Cadastrar projeto</button>}
      <button type="button" class="secondary" data-np-limpar>Limpar</button>
    </div>
  </form>
  <div class="np-ok" role="region" data-np-ok tabindex="-1" aria-labelledby="np-ok-titulo" hidden>
    <h2 id="np-ok-titulo">Projeto cadastrado</h2>
    <p data-np-ok-texto role="status"></p>
    <div data-np-ok-pendencias hidden>
      <h3>Pendências de dado e avisos</h3>
      <ul data-np-ok-lista></ul>
    </div>
    <div class="actions">
      <a class="button primary" href="/plataforma/projetos-carteira/" data-np-ok-pagina>Abrir a página do projeto</a>
      <a class="button secondary" href="/plataforma/projetos-log/" data-np-ok-log>Ver no Histórico de alterações</a>
      <a class="button secondary" href="/plataforma/projetos-carteira/">Voltar à carteira</a>
    </div>
  </div>
</div>
<script>
import { sugerirArea } from '../../lib/carteira/area.ts';
import { lerReais } from '../../lib/carteira/formulario.ts';
import { avisar, nomeEtapa } from '../../lib/carteira/simulacao.ts';
import type { Projeto } from '../../lib/carteira/tipos.ts';
import { validarLocalizacao } from '../../lib/mapa/geo.ts';
import type { Localizacao } from '../../lib/mapa/tipos.ts';
import { hrefFicha } from '../../lib/carteira/ficha.ts';
import { aquiDe, comVolta } from '../../lib/navegacao/volta.ts';

const SEI = /^\d{2}\.\d{1,2}\.\d{9}-\d$/;
const reduzMovimento = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

document.addEventListener('astro:page-load', () => {
  const raiz = document.querySelector<HTMLElement>('[data-novo-projeto]');
  if (!raiz || raiz.dataset.pronto) return;
  raiz.dataset.pronto = 'sim';
  const form = raiz.querySelector<HTMLFormElement>('[data-np-form]')!;
  const resumo = raiz.querySelector<HTMLElement>('[data-np-resumo]')!;
  const ok = raiz.querySelector<HTMLElement>('[data-np-ok]')!;
  const botao = raiz.querySelector<HTMLButtonElement>('[data-np-enviar]');

  const campo = (id: string) => form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`#np-${id}`)!;
  const valor = (id: string) => campo(id).value.trim();

  const atualizarOutros = () => {
    form.querySelectorAll<HTMLSelectElement>('select[data-outro-de]').forEach((s) => {
      const caixa = form.querySelector<HTMLElement>(`[data-outro="${s.dataset.outroDe}"]`);
      if (caixa) caixa.hidden = s.value !== '__outro';
    });
  };
  form.addEventListener('change', (e) => {
    const alvo = e.target as HTMLElement;
    if (alvo.matches('select[data-outro-de]')) atualizarOutros();
    if (alvo.matches('#np-orgao, #np-orgao-outro, #np-area')) atualizarSugestao();
  });

  const limparErros = () => {
    resumo.hidden = true;
    resumo.replaceChildren();
    form.querySelectorAll<HTMLElement>('.np-erro').forEach((x) => {
      x.hidden = true;
      x.textContent = '';
    });
    form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((x) => x.removeAttribute('aria-invalid'));
  };

  const escolhido = (id: string): { texto: string; alvo: string } => {
    const sel = campo(id) as HTMLSelectElement;
    if (sel.value === '__outro') return { texto: valor(`${id}-outro`), alvo: `${id}-outro` };
    return { texto: sel.value.trim(), alvo: id };
  };

  const area = campo('area') as HTMLSelectElement;
  const dicaArea = form.querySelector<HTMLElement>('[data-area-sugestao]')!;
  const opcaoSugerida = () => {
    const codigo = sugerirArea(escolhido('orgao').texto);
    return Array.from(area.options).find((opcao) => opcao.value === codigo);
  };
  const atualizarSugestao = () => {
    const opcao = opcaoSugerida();
    dicaArea.hidden = !!area.value || !opcao;
    if (opcao) dicaArea.querySelector('span')!.textContent = `Sugestão pelo órgão: ${opcao.label}.`;
  };
  dicaArea.querySelector('[data-area-usar]')!.addEventListener('click', () => {
    const opcao = opcaoSugerida();
    if (!area.value && opcao) area.value = opcao.value;
    atualizarSugestao();
  });
  form.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).matches('#np-orgao, #np-orgao-outro, #np-area')) atualizarSugestao();
  });

  const reais = (id: string, rotulo: string, erros: [string, string][]): number | null => {
    const n = lerReais(valor(id));
    if (n !== 'invalido') return n;
    erros.push([id, `${rotulo}: digite um valor em reais, como 1.500.000,00.`]);
    return null;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!botao || botao.disabled) return;
    limparErros();
    ok.hidden = true;
    const erros: [string, string][] = [];
    const org = escolhido('orgao');
    const ov = escolhido('origem_valor');
    const sei = valor('sei')
      .split(',')
      .map((x) => x.trim())
      .filter(Boolean);
    const seiRuim = sei.filter((x) => !SEI.test(x));
    if (seiRuim.length) erros.push(['sei', `Processo SEI fora do formato 00.0.000000000-0: ${seiRuim.join(', ')}.`]);
    const obra = reais('valor_obra', 'Valor estimado da obra', erros);
    const proj = reais('valor_projeto', 'Valor do projeto', erros);
    const dias = valor('d_dias');
    let execDias: number | null = null;
    if (dias) {
      execDias = Number(dias);
      if (!Number.isInteger(execDias) || execDias < 0) {
        erros.push(['d_dias', 'Dias de execução: digite um número inteiro, como 180.']);
        execDias = null;
      }
    }
    const tem = valor('tem_projeto');
    const termo = valor('termo');
    const compromisso = (form.querySelector<HTMLInputElement>('input[name="compromisso"]:checked')?.value ?? 'ideia') as Projeto['compromisso'];
    const d = (id: string) => valor(id) || null;
    const editorLoc = raiz.querySelector<HTMLElement>('#np-loc');
    let localizacao: Localizacao | null = null;
    try {
      localizacao = JSON.parse(editorLoc?.dataset.valor || 'null');
    } catch {
      localizacao = null;
    }
    const errosLoc = localizacao ? validarLocalizacao(localizacao) : [];
    editorLoc?.dispatchEvent(new CustomEvent('localizacao-erros', { detail: errosLoc }));
    for (const e of errosLoc) erros.push(['loc', `Localização: ${e}`]);

    if (!valor('nome')) erros.unshift(['nome', 'Informe o nome do projeto.']);
    if (!org.texto) erros.splice(valor('nome') ? 0 : 1, 0, [org.alvo, 'Escolha o órgão ou digite a sigla.']);
    if (erros.length > 0) {
      const ul = document.createElement('ul');
      const t = document.createElement('p');
      t.textContent = `Corrija ${erros.length === 1 ? 'este campo' : 'estes campos'} para continuar:`;
      for (const [id, msg] of erros) {
        const alvo = campo(id);
        const span = form.querySelector<HTMLElement>(`#np-${id}-erro`);
        if (span) {
          span.textContent = msg;
          span.hidden = false;
        }
        alvo.setAttribute('aria-invalid', 'true');
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#np-${id}`;
        a.textContent = msg;
        a.addEventListener('click', (ev) => {
          ev.preventDefault();
          alvo.focus();
        });
        li.append(a);
        ul.append(li);
      }
      resumo.append(t, ul);
      resumo.hidden = false;
      resumo.focus();
      resumo.scrollIntoView({ behavior: reduzMovimento() ? 'auto' : 'smooth', block: 'start' });
      return;
    }
    const corpo = {
      nome: valor('nome'),
      orgao: org.texto,
      area: valor('area') || null,
      prioritario: (campo('prioritario') as HTMLInputElement).checked,
      responsavel: valor('responsavel') || null,
      tipo: valor('tipo') || null,
      detalhamento: valor('detalhamento') || null,
      regiao: valor('regiao') || null,
      bairro: valor('bairro') || null,
      sei,
      observacao: valor('observacao') || null,
      compromisso,
      origem_valor: ov.texto || null,
      tem_projeto: tem === 'Sim' ? true : tem === 'Não' ? false : null,
      prioridade: valor('prioridade') || null,
      tipo_contratacao: valor('tipo_contratacao') || null,
      orgao_contratacao: valor('orgao_contratacao') || null,
      valor_obra: obra,
      valor_projeto: proj,
      recurso_origem: valor('recurso_origem') || null,
      fonte_programa: valor('fonte_programa') || null,
      unidade_financiadora: valor('unidade_financiadora') || null,
      termo: termo === 'Sim' ? true : termo === 'Não' ? false : null,
      numero_termo: valor('numero_termo') || null,
      datas: { pecas_tecnicas: d('d_pecas'), planejamento: d('d_planejamento'), preparatorio: d('d_preparatorio'), contratacao: d('d_contratacao'), mobilizacao: d('d_mobilizacao'), execucao_dias: execDias, encerramento: d('d_entrega') },
      localizacao,
    };
    const mostrarErroGeral = (msgs: string[]) => {
      const t = document.createElement('p');
      t.textContent = msgs.length === 1 ? 'Não foi possível cadastrar:' : 'Não foi possível cadastrar. Corrija:';
      const ul = document.createElement('ul');
      for (const m of msgs) {
        const li = document.createElement('li');
        li.textContent = m;
        ul.append(li);
      }
      resumo.replaceChildren(t, ul);
      resumo.hidden = false;
      resumo.focus();
    };
    botao.disabled = true;
    botao.textContent = 'Cadastrando…';
    try {
      const resp = await fetch('/plataforma/projeto/criar/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(corpo), credentials: 'same-origin', redirect: 'manual' });
      if (resp.type === 'opaqueredirect' || resp.status === 401) {
        mostrarErroGeral(['Sua sessão terminou. Entre de novo e repita o cadastro.']);
        return;
      }
      const r = await resp.json().catch(() => null) as { ok?: boolean; erro?: string; erros?: string[]; projeto?: { id: string; nome: string; macroetapa: Projeto['macroetapa'] }; pendencias?: string[]; avisos?: string[] } | null;
      if (!r?.ok || !r.projeto) {
        mostrarErroGeral(r?.erros?.length ? r.erros : [r?.erro ?? 'Não foi possível cadastrar. Confira a conexão e tente de novo.']);
        return;
      }
      ok.querySelector('[data-np-ok-texto]')!.textContent = `O projeto ${r.projeto.id} · ${r.projeto.nome} foi cadastrado em ${r.projeto.macroetapa} – ${nomeEtapa(r.projeto.macroetapa)} e registrado no Histórico.`;
      const lista = ok.querySelector<HTMLElement>('[data-np-ok-lista]')!;
      lista.replaceChildren();
      for (const x of [...(r.pendencias ?? []), ...(r.avisos ?? [])]) {
        const li = document.createElement('li');
        li.textContent = x;
        lista.append(li);
      }
      ok.querySelector<HTMLElement>('[data-np-ok-pendencias]')!.hidden = lista.children.length === 0;
      ok.querySelector<HTMLAnchorElement>('[data-np-ok-pagina]')!.href = hrefFicha(r.projeto.id, aquiDe(new URL(location.href)));
      ok.querySelector<HTMLAnchorElement>('[data-np-ok-log]')!.href = comVolta(`/plataforma/projetos-log/?projeto=${encodeURIComponent(r.projeto.id)}`, aquiDe(new URL(location.href)));
      form.reset();
      raiz.querySelector('#np-loc')?.dispatchEvent(new CustomEvent('localizacao-definir', { detail: null }));
      atualizarOutros();
      atualizarSugestao();
      ok.hidden = false;
      ok.focus();
      ok.scrollIntoView({ behavior: reduzMovimento() ? 'auto' : 'smooth', block: 'start' });
      avisar(`Projeto ${r.projeto.id} · ${r.projeto.nome} cadastrado.`);
    } catch {
      mostrarErroGeral(['Não foi possível cadastrar. Confira a conexão e tente de novo.']);
    } finally {
      botao.disabled = false;
      botao.textContent = 'Cadastrar projeto';
    }
  });

  raiz.querySelector('[data-np-limpar]')!.addEventListener('click', () => {
    form.reset();
    raiz.querySelector('#np-loc')?.dispatchEvent(new CustomEvent('localizacao-definir', { detail: null }));
    limparErros();
    atualizarOutros();
    atualizarSugestao();
    ok.hidden = true;
    campo('nome').focus();
  });
});
</script>
